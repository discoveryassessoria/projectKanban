# .env.example — modelo. Copie para .env e preencha. O .env NÃO é versionado.

# ⚠ POR QUE AS URLs DE BANCO TÊM O SUFIXO _RAW
#
# O Prisma CLI lê o .env sozinho e procura PRISMA_DATABASE_URL e
# DIRECT_DATABASE_URL. Enquanto esses nomes existirem no arquivo, QUALQUER
# comando digitado no terminal — `npx prisma db push`, `migrate dev`,
# `migrate reset` — acerta o banco na hora, sem passar por guarda nenhuma.
# O .env deste projeto aponta para PRODUÇÃO.
#
# Por isso as chaves reais moram sob o sufixo _RAW: o Prisma não as encontra,
# e um comando solto falha com "Environment variable not found" em vez de
# escrever em produção.
#
# Para trabalhar com o banco, ative a sessão do terminal:
#
#     source scripts/ativar-db.sh
#
# Ele mostra QUAL banco você está prestes a ativar (host, classificação e
# contagens reais), exige um "SIM" digitado, e só então exporta
# PRISMA_DATABASE_URL e DIRECT_DATABASE_URL — apenas naquele terminal, sem
# escrever nada em disco. Fechar a janela desfaz.
#
# Os comandos npm protegidos (guard:escrita, backfill:*, seed) continuam
# passando pelo db-guard normalmente — esta trava cobre o outro caminho, o
# comando Prisma solto fora de qualquer script.

PRISMA_DATABASE_URL_RAW="postgres://usuario:senha@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_DATABASE_URL_RAW="postgres://usuario:senha@db.prisma.io:5432/postgres?sslmode=require"

# Segredos de sessão. Mínimo 32 caracteres cada.
JWT_SECRET=""
APP_JWT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# CORS das rotas /api/app/* — existe só por causa do modo web do Expo.
#
# O app mobile roda nativo em iOS/Android, onde CORS não se aplica: é regra de
# navegador. Esta chave é o que permite abrir o app no navegador durante o
# desenvolvimento e ele conseguir falar com a API.
#
# Fora de produção (VERCEL_ENV != "production", o que inclui os deploys de
# preview e a máquina local), localhost e 127.0.0.1 em QUALQUER porta já são
# aceitos automaticamente — não precisa listar nada aqui para isso funcionar.
#
# Em produção esta lista deve ficar VAZIA: nenhum navegador chama /api/app/*,
# só o app instalado, que não passa por CORS. Preencher aqui em produção é
# abrir a API para um site — só faça com um motivo concreto.
#
# Formato: origens separadas por vírgula, com esquema e sem barra final.
# APP_CORS_ORIGENS="https://exemplo.com.br,https://outro.exemplo.com.br"

# ─────────────────────────────────────────────────────────────────────────────
# Importar Árvore por IA — leitura do print de uma árvore já montada.
#
# Sem ANTHROPIC_API_KEY o botão continua na tela, mas a rota responde 501 com a
# causa; o resto do fluxo (upload, prévia, gravação) funciona sem ela.
ANTHROPIC_API_KEY=""

# Tudo abaixo é opcional — os padrões estão no código e são conservadores.
# ARVORE_VISAO_MODELO="claude-opus-5"   # claude-sonnet-5 custa ~40% do preço
# ARVORE_VISAO_ESFORCO="medium"         # low | medium | high | xhigh | max
# ARVORE_VISAO_MAX_TOKENS="16000"       # teto de tokens de RESPOSTA (custo de saída)
# ARVORE_VISAO_TETO_USD="1"             # teto por leitura, conferido ANTES de gastar
# ARVORE_VISAO_MAX_BYTES="5242880"      # teto da imagem enviada (custo de entrada)
# ARVORE_VISAO_TIMEOUT_MS="45000"       # por tentativa
# ARVORE_VISAO_PRAZO_MS="52000"         # total; fica abaixo do maxDuration=60 da rota
# ARVORE_VISAO_TENTATIVAS="2"
# ARVORE_VISAO_CONCORRENCIA="2"
# ANTHROPIC_PRECO_ENTRADA_MTOK="5"      # só para o cálculo do teto; ajuste se trocar o modelo
# ANTHROPIC_PRECO_SAIDA_MTOK="25"

# IMPORTAR_ARVORE_MOCK="1"              # extração falsa, para testar a tela sem gastar token
