# .env.example — modelo. Copie para .env e preencha. O .env NÃO é versionado.

# ⚠ POR QUE AS URLs DE BANCO TÊM O SUFIXO _RAW
#
# O Prisma CLI lê o .env sozinho e procura PRISMA_DATABASE_URL e
# DIRECT_DATABASE_URL. Enquanto esses nomes existirem no arquivo, QUALQUER
# comando digitado no terminal — `npx prisma db push`, `migrate dev`,
# `migrate reset` — acerta o banco na hora, sem passar por guarda nenhuma.
# O .env deste projeto aponta para PRODUÇÃO.
#
# Por isso as chaves reais moram sob o sufixo _RAW: o Prisma não as encontra,
# e um comando solto falha com "Environment variable not found" em vez de
# escrever em produção.
#
# Para trabalhar com o banco, ative a sessão do terminal:
#
#     source scripts/ativar-db.sh
#
# Ele mostra QUAL banco você está prestes a ativar (host, classificação e
# contagens reais), exige um "SIM" digitado, e só então exporta
# PRISMA_DATABASE_URL e DIRECT_DATABASE_URL — apenas naquele terminal, sem
# escrever nada em disco. Fechar a janela desfaz.
#
# Os comandos npm protegidos (guard:escrita, backfill:*, seed) continuam
# passando pelo db-guard normalmente — esta trava cobre o outro caminho, o
# comando Prisma solto fora de qualquer script.

PRISMA_DATABASE_URL_RAW="postgres://usuario:senha@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_DATABASE_URL_RAW="postgres://usuario:senha@db.prisma.io:5432/postgres?sslmode=require"

# Segredos de sessão. Mínimo 32 caracteres cada.
JWT_SECRET=""
APP_JWT_SECRET=""
