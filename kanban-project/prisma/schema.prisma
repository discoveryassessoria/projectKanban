  phaseCycle    Int? // ciclo da fase (reemissÃ£o)
  pricingRuleId Int? // qual regra de preÃ§o (TabelaValor.id) resolveu o valor â congelado

  // PREÃO-FONTE-ÃNICA â CONGELAMENTO (Â§6) + RASTREABILIDADE (Â§8). Snapshot imutÃ¡vel
  // do preÃ§o/contexto no momento da criaÃ§Ã£o; mudar a TabelaValor depois NÃO altera isto.
  valorUnitario       Decimal?       @db.Decimal(12, 2)
  quantidade          Decimal?       @db.Decimal(12, 2)
  valorTotalCongelado Decimal?       @db.Decimal(12, 2)
  modoCalculoAplicado String?        @db.VarChar(20)
  naturezaPreco       NaturezaPreco? // CUSTO | VENDA (a Receita Ã© o lanÃ§amento; a natureza do PREÃO usado)
  configFinanceiraId  Int? // â ProdutoFinanceiro.id (ConfiguraÃ§Ã£o Financeira; solto/snapshot)
  regraFinanceiraId   Int? // â PhaseEconomicRule/PhaseTriggerRule.id que decidiu a criaÃ§Ã£o (solto/snapshot)
  contextoAplicado    Json? // dimensÃµes usadas na resoluÃ§Ã£o (tipoProcesso/fornecedor/regiao/qtdâ¦)
  dataReferencia      DateTime? // data de referÃªncia do preÃ§o aplicado
  chaveIdempotencia   String?        @db.VarChar(200) // = MotorArtefato.automaticKey (unicidade vive lÃ¡)

  // Â§5/Â§7 â origem e competÃªncia do lanÃ§amento canÃ´nico do PROCESSO.
  origemLancamento    String    @default("PROCESSO") @db.VarChar(20) // PROCESSO (Receita nasce de processo)
  naturezaLancamento  String    @default("RECEITA") @db.VarChar(10) // Â§1 â natureza do LANÃAMENTO (Receita â RECEITA)
  eventoOperacionalId String?   @db.VarChar(120) // evento operacional que originou (rastreabilidade Â§5/Â§8)
  dataCompetencia     DateTime? // competÃªncia contÃ¡bil (Fluxo de Caixa projetado / DRE)
  // Â§10 CANCELAMENTO (preserva histÃ³rico) â cancelada/status seguem como flag/estado.
  canceladoEm         DateTime?
  canceladoMotivo     String?   @db.VarChar(500)
  canceladoPorId      Int? // â Usuario.id (ator; solto/snapshot)
  canceladoEventoRef  String?   @db.VarChar(120) // evento de origem do cancelamento
  chaveCancelamento   String?   @unique @db.VarChar(220) // Â§12 idempotÃªncia do cancelamento
  // Â§11 ESTORNO â este lanÃ§amento Ã© o movimento INVERSO de estornoDeId (self-relation).
  estornadoEm         DateTime? // setado no lanÃ§amento ORIGINAL quando estornado
  estornoMotivo       String?   @db.VarChar(500)
  estornoDeId         Int?      @unique // um estorno por original (Â§12)
  estornoDe           Receita?  @relation("ReceitaEstorno", fields: [estornoDeId], references: [id])
  estornos            Receita[] @relation("ReceitaEstorno")
  chaveEstorno        String?   @unique @db.VarChar(220) // Â§12 idempotÃªncia do estorno

  // ââ CONDIÃÃO DE PAGAMENTO APLICADA (congelada no lanÃ§amento) ââ
  // Guarda QUAL condiÃ§Ã£o e QUAL versÃ£o geraram este cronograma, o resultado do
  // cÃ¡lculo de taxas e a memÃ³ria. Alterar a condiÃ§Ã£o ou a taxa depois NUNCA
  // recalcula este lanÃ§amento â ele carrega o que foi aplicado.
  condicaoPagamentoId Int?
  condicaoPagamento   CondicaoPagamento? @relation("ReceitaCondicaoPagamento", fields: [condicaoPagamentoId], references: [id])
  condicaoVersao      Int?
  condicaoCodigo      String?            @db.VarChar(40)
  valorBruto          Decimal?           @db.Decimal(12, 2)
  valorTaxas          Decimal?           @db.Decimal(12, 2)
  valorLiquido        Decimal?           @db.Decimal(12, 2)
  memoriaCalculo      Json?

  @@index([processoId])
  @@index([categoria])
  @@index([cancelada])
  @@index([condicaoPagamentoId])
  @@index([origemLancamento])
  @@index([codigo])
  @@index([personId])
  @@index([documentoId])
  @@index([tipoServicoId])
}

