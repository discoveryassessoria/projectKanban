  status            WorkflowInstanceStatus @default(PENDENTE)
  origem            OrigemInstancia        @default(MOTOR)
  instanciadoPor    String?                @db.VarChar(60) // userId ou "MOTOR"
  correlationId     String?                @db.VarChar(60)
  causationId       String?                @db.VarChar(200) // CP-4B â causa imediata (chave do advance chega a ~74 chars)
  chaveIdempotencia String                 @unique @db.VarChar(200)

  previousInstanceId    Int?
  previousInstance      PhaseWorkflowInstance?  @relation("PhaseWorkflowInstanceSupersessao", fields: [previousInstanceId], references: [id], onDelete: SetNull)
  supersededByInstances PhaseWorkflowInstance[] @relation("PhaseWorkflowInstanceSupersessao")

  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ---- REGULARIZACAO HISTORICA (cadastro de processo ja em andamento) ----
  // DATA REAL informada retroativamente x data de registro no sistema: sao coisas
  // diferentes e ficam em campos diferentes. createdAt/startedAt/completedAt NUNCA
  // sao reescritos para simular antiguidade.
  inicioReal           DateTime?
  conclusaoReal        DateTime?
  fonteDataHistorica   String?   @db.VarChar(200)
  requerRegularizacao  Boolean   @default(false)
  regularizadoEm       DateTime?
  regularizadoPorId    Int?
  regularizadoPor      Usuario?  @relation("FaseRegularizadaPor", fields: [regularizadoPorId], references: [id], onDelete: SetNull)
  motivoAdministrativo String?   @db.Text
  motivoNaoAplicavel   String?   @db.Text
  criadoPorId          Int?
  criadoPor            Usuario?  @relation("FaseCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  steps   PhaseWorkflowStepInstance[]
  // 1:1 — a instância pertence a UMA tarefa. É a contraparte do `@unique` em
  // `Tarefa.workflowInstanceId`. A relação é de UM para MUITOS: a instância é da
  // FASE e abriga as unidades de trabalho dela — quatro certidões numa Emissão
  // Documental são quatro tarefas dentro desta mesma instância. Quem impede
  // "etapa vira tarefa" é a chave da tarefa, derivada da obrigação.
  tarefas Tarefa[]

  @@index([processoId, faseMacroKey, status])
  @@index([chaveIdempotencia])
  @@index([previousInstanceId])
  @@index([processoId, requerRegularizacao])
}

/// TENTATIVA DE EXECUÇÃO DE UM PASSO — o que faltava para reexecutar sem mentir.
///
/// O modelo já sabia representar a execução da FASE: `PhaseWorkflowInstance` tem
/// `ciclo` e `previousInstanceId`, e voltar a uma fase abre uma visita nova. O que
/// não existia era a tentativa DO PASSO dentro de uma mesma visita. Reabrir um passo
/// fazia `UPDATE ... completedAt = NULL` na própria linha: a execução que aconteceu
/// deixava de ter acontecido, e não sobrava com o que responder "concluída em qual
/// execução?".
///
/// Cada linha aqui é UMA TENTATIVA, e tentativas são APPEND-ONLY. A instância do
/// passo continua sendo a obrigação ("executar `receber_certidao` para esta certidão
/// nesta visita da fase"); a tentativa é cada vez que se tentou cumpri-la.
///
/// A TENTATIVA VIGENTE é a única com `supersededAt` nulo — garantido por índice
/// parcial no banco, não por convenção. Não se descobre a atual por `ORDER BY
/// createdAt DESC`: descobre-se porque é a única que não foi substituída.
model StepExecution {
  id             Int                       @id @default(autoincrement())
  stepInstanceId Int
  stepInstance   PhaseWorkflowStepInstance @relation(fields: [stepInstanceId], references: [id], onDelete: Cascade)

  /// Metadado humano e auditável (1, 2, 3…). A identidade real é o `id`.
  sequencia Int
  status    StepInstanceStatus

  /// POR QUE esta tentativa nasceu. Sem isto, "tentativa 2" não se explica.
  motivo String @db.VarChar(30)

  startedAt      DateTime?
  completedAt    DateTime?
  executadoPorId Int?

  /// Desfecho declarado pelo executor (aprovado, divergente, nova via…). Fica aqui,
  /// e não sobrescrito no passo, porque é fato DA TENTATIVA.
  resultado String? @db.VarChar(60)
  /// Os dados de domínio preenchidos na tentativa (hoje `metadata.operacao`).
  payload   Json?

  /// PROTOCOLO CANÔNICO registrado por esta tentativa. É REFERÊNCIA, não cópia: o
  /// número, a data, o órgão e o responsável vivem em `Protocolo`, que é o dono do
  /// fato. Guardar o número aqui também criaria duas verdades editáveis.
  protocoloId Int?
  protocolo   Protocolo? @relation("ProtocoloDaTentativa", fields: [protocoloId], references: [id], onDelete: SetNull)

  /// Quando esta tentativa deixou de ser a vigente, e por qual. `null` = é a atual.
  supersededAt      DateTime?
  supersededPorId   Int?
  correlationId     String?   @db.VarChar(60)
  /// Retry de HTTP não pode virar tentativa nova.
  chaveIdempotencia String    @unique @db.VarChar(200)
  criadoEm          DateTime  @default(now())

  @@unique([stepInstanceId, sequencia])
  @@index([stepInstanceId])
  @@index([protocoloId])
}

/// A EXECUÇÃO DE UMA SUBTAREFA — append-only, exatamente como a do passo.
///
/// A tentativa do passo (`StepExecution`) responde "esta obrigação foi cumprida?". Ela
/// não sabe responder "quem registrou o protocolo, quando, em qual tentativa" — porque
/// registrar o protocolo era um trecho de tela, não um fato. Aqui passa a ser.
///
/// ─── A VIGENTE ─────────────────────────────────────────────────────────────
/// É a única com `supersededAt` nulo, e quem garante que é uma só é um índice parcial
/// no banco. Reabrir uma subtarefa SUBSTITUI a vigente (que mantém `completedAt`,
/// executor e resultado) e abre outra. O passado continua sendo passado.
///
/// ─── ISOLAMENTO ────────────────────────────────────────────────────────────
/// A execução é da subtarefa NAQUELA instância do passo. Reabrir "conferir selo" da
/// certidão do avô não toca a subtarefa homônima das outras 49 certidões, porque a
/// instância do passo é outra — o mesmo isolamento que já vale um nível acima.
model SubtaskExecution {
  id             Int                       @id @default(autoincrement())
  stepInstanceId Int
  stepInstance   PhaseWorkflowStepInstance @relation(fields: [stepInstanceId], references: [id], onDelete: Cascade)

  /// A CHAVE da subtarefa, não o id da definição: é ela que sobrevive à republicação.
  subtaskKey          String @db.VarChar(60)
  /// A definição que valia quando esta execução nasceu (solta — a versão congelada é
  /// quem resolve o conteúdo histórico).
  subtaskDefinitionId Int?
  /// Versão do workflow que esta execução registrou.
  workflowVersao      Int?

  sequencia Int
  /// PENDENTE | DISPONIVEL | EM_ANDAMENTO | AGUARDANDO_EXTERNO | BLOQUEADO |
  /// CONCLUIDO | CANCELADO | INVALIDADO | FALHOU — vocabulário fechado, conferido
  /// por CHECK no banco.
  status    String @db.VarChar(24)
  /// POR QUE esta execução nasceu (ABERTURA, REABERTURA_MANUAL, RETRY…).
  motivo    String @db.VarChar(30)

  /// CAUSA ESTRUTURADA do bloqueio — "bloqueada porque depende de X", não um texto.
  bloqueioCodigo String? @db.VarChar(40)
  bloqueioAlvo   String? @db.VarChar(120)

  startedAt      DateTime?
  completedAt    DateTime?
  executadoPorId Int?
  responsavelId  Int?
  prazo          DateTime?

  /// Desfecho declarado (a `key` da ação escolhida).
  resultado String? @db.VarChar(60)
  /// Os dados preenchidos NESTA execução.
  payload   Json?

  /// OPERAÇÃO EXTERNA — quando a subtarefa espera um terceiro.
  fornecedorId Int?
  fornecedor   OrgaoProtocolo? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  canalKey     String?         @db.VarChar(40)
  /// PROJEÇÃO TEXTUAL histórica do número. Continua sendo escrita para não quebrar
  /// leitor nenhum; a verdade passou a ser `protocoloId`. Removível quando os
  /// leitores migrarem.
  protocolo    String?         @db.VarChar(120)
  /// PROTOCOLO CANÔNICO desta execução de subtarefa. Mesma regra do passo.
  protocoloId  Int?
  protocoloRef Protocolo?      @relation("ProtocoloDaSubtarefa", fields: [protocoloId], references: [id], onDelete: SetNull)
  enviadoEm    DateTime?
  previstoPara DateTime?

  supersededAt      DateTime?
  supersededPorId   Int?
  correlationId     String?   @db.VarChar(60)
  /// Retry de HTTP não pode virar execução nova.
  chaveIdempotencia String    @unique @db.VarChar(200)
  criadoEm          DateTime  @default(now())

  @@unique([stepInstanceId, subtaskKey, sequencia])
  @@index([stepInstanceId])
  @@index([subtaskKey])
  @@index([protocoloId])
}

