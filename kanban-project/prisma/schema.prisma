  chaveIdempotencia String  @unique @db.VarChar(200)
  correlationId     String? @db.VarChar(60)
  causationId       String? @db.VarChar(200) // CP-4B â causa imediata (chave do advance chega a ~74 chars)

  previousStepInstanceId Int?
  previousStepInstance   PhaseWorkflowStepInstance?  @relation("StepInstanceSupersessao", fields: [previousStepInstanceId], references: [id], onDelete: SetNull)
  supersededBySteps      PhaseWorkflowStepInstance[] @relation("StepInstanceSupersessao")

  metadata               Json?
  lockVersion            Int      @default(0) // versionamento otimista
  // CP-4D â estado do Passo antes de BLOQUEADO (para restauraÃ§Ã£o no desbloqueio).
  statusAnteriorBloqueio String?  @db.VarChar(30)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tarefas Tarefa[]

  /// Tentativas de execução deste passo (append-only). Ver StepExecution.
