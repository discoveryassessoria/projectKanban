  @@index([obrigacaoId])
}

/// Cota de um requerente/beneficiÃ¡rio na distribuiÃ§Ã£o.
model ParticipacaoEconomica {
  id             Int                   @id @default(autoincrement())
  distribuicaoId Int
  distribuicao   DistribuicaoEconomica @relation(fields: [distribuicaoId], references: [id], onDelete: Cascade)
  pessoaId       Int
