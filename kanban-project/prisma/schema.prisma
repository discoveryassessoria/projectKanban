  exigePessoa    Boolean @default(true)
  exigeDocumento Boolean @default(true)

  ativo     Boolean  @default(true)
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipos    TipoDocumentoCadastro[]
  /// Quem está apto a executar esta unidade de trabalho.
  aptidoes AptidaoOperacional[]

  @@index([workflowId])
  @@index([familiaDocumentalId])
}

