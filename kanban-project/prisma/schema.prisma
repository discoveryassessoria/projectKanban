  @@index([workflowInstanceId, ordem])
  @@index([processoId, faseMacroKey, status])
  @@index([necessidadeId])
  @@index([documentoId])
  @@index([retificacaoPacoteId])
  @@index([stepKey])
  @@index([chaveIdempotencia])
