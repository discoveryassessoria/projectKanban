  @@index([natureza])
  @@index([configuracaoFinanceiraItemId])
  @@index([modalidadeId])
}

// PREÃO-FONTE-ÃNICA (Â§5/Â§6) â pendÃªncia financeira RASTREÃVEL. Registrada quando o
// motor NÃO consegue resolver um preÃ§o vÃ¡lido (sem regra vigente, ou conflito de
// mesma precedÃªncia). NUNCA cria lanÃ§amento com valor incorreto/zero: registra aqui
// para revisÃ£o. Idempotente por chaveIdempotencia (mesma do MotorArtefato do lanÃ§amento).
model PendenciaFinanceira {
  id                 Int            @id @default(autoincrement())
  processoId         Int
  processo           Processo       @relation("ProcessoPendenciasFinanceiras", fields: [processoId], references: [id], onDelete: Cascade)
