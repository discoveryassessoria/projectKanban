}

/// Saldo de abertura na DATA DE CORTE (DecisÃ£o 3). NÃ£o reconstrÃ³i histÃ³rico.
model LedgerOpeningBalance {
  id            Int       @id @default(autoincrement())
  obrigacaoId   Int       @unique
  dataCorte     DateTime
