  criadoEm           DateTime       @default(now())
  // Reprocessamento (P4): a pendÃªncia Ã© reprocessÃ¡vel quando o preÃ§o/config for cadastrado.
  tentativas         Int            @default(0)
  ultimaTentativaEm  DateTime?
  ultimaFalha        String?        @db.VarChar(500)

  @@index([processoId])
  @@index([phaseKey])
  @@index([resolvida])
  @@index([configFinanceiraId])
}

// ââ CondiÃ§Ãµes de Pagamento (fin_paycond) ââ
// ââ CONDIÃÃO DE PAGAMENTO ââââââââââââââââââââââââââââââââââââââââââââââââââââ
// Cadastro OFICIAL das regras de cobranÃ§a do sistema. Ã aqui â e sÃ³ aqui â que
// vivem entrada, quantidade de parcelas, periodicidade, cronograma,
// distribuiÃ§Ã£o, encargos, polÃ­tica cambial e restriÃ§Ãµes de uso.
//
// A Tabela de PreÃ§os responde por VALOR; a CondiÃ§Ã£o de Pagamento responde por
// COMO esse valor Ã© cobrado. O FinanceRuleEngine consome o cronograma pronto
// (lib/financeiro/condicao-pagamento.ts) em vez de montar parcelas na mÃ£o.
//
// Campos histÃ³ricos (name/moeda/formaPagamento/parcelas/diaVencimento/...) sÃ£o
// PRESERVADOS: a expansÃ£o Ã© aditiva e os registros existentes seguem vÃ¡lidos.
model CondicaoPagamento {
  id             Int                  @id @default(autoincrement())
  name           String               @db.VarChar(200)
  moeda          Moeda                @default(BRL)
  formaPagamento FormaPagamento?
  carteiraId     Int?
  carteira       CarteiraRecebimento? @relation(fields: [carteiraId], references: [id])
  temEntrada     Boolean              @default(false)
  percentEntrada Decimal?             @db.Decimal(5, 2)
  parcelas       Int                  @default(1)
  diaVencimento  Int?
  aplicarTaxas   Boolean              @default(false)
  ativo          Boolean              @default(true)
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt

  // ââ identificaÃ§Ã£o e versionamento ââ
  // CondiÃ§Ã£o jÃ¡ utilizada NUNCA Ã© alterada: cria-se a versÃ£o seguinte
  // (proximaVersao) e encerra-se a vigÃªncia da anterior.
  codigo      String?             @db.VarChar(40)
  descricao   String?             @db.Text
  versao      Int                 @default(1)
  substituiId Int?
  substitui   CondicaoPagamento?  @relation("VersaoCondicao", fields: [substituiId], references: [id])
  versoes     CondicaoPagamento[] @relation("VersaoCondicao")

  vigenciaInicio DateTime?
  vigenciaFim    DateTime?

  // ââ parcelamento ââ
  tipoPagamento                 String   @default("PARCELADO") @db.VarChar(20) // AVISTA | PARCELADO
  entradaObrigatoria            Boolean  @default(false)
  valorEntradaFixo              Decimal? @db.Decimal(12, 2)
  parcelasMin                   Int?
  parcelasMax                   Int?
  parcelasPadrao                Int?
  permiteParcelasPersonalizadas Boolean  @default(false)
  permiteEdicaoManual           Boolean  @default(false)

  // ââ cronograma ââ
  inicioCronograma    String    @default("IMEDIATA") @db.VarChar(20) // IMEDIATA | DIAS | DATA_ESPECIFICA
  primeiraParcelaDias Int?
  primeiraParcelaData DateTime?
  periodicidade       String    @default("MENSAL") @db.VarChar(20) // SEMANAL..ANUAL | PERSONALIZADA
  periodicidadeDias   Int?
  diaFixo             Int?
  ajusteDiaUtil       String    @default("NENHUM") @db.VarChar(20) // NENHUM | ULTIMO_DIA_UTIL | PROXIMO_DIA_UTIL
  ajustarFimDeSemana  Boolean   @default(false)
  // Declarado; o ajuste efetivo depende de um calendÃ¡rio de feriados que o
  // sistema ainda nÃ£o possui (ver ajustarVencimento).
  ajustarFeriados     Boolean   @default(false)

  // ââ distribuiÃ§Ã£o ââ
  distribuicao           String   @default("ULTIMA_AJUSTA") @db.VarChar(30)
  primeiraParcelaPercent Decimal? @db.Decimal(5, 2)

  // ââ encargos (armazenados; aplicaÃ§Ã£o em runtime Ã© o prÃ³ximo incremento) ââ
  multaPercent               Decimal? @db.Decimal(7, 4)
  jurosMesPercent            Decimal? @db.Decimal(7, 4)
  descontoPercent            Decimal? @db.Decimal(7, 4)
  descontoAntecipacaoPercent Decimal? @db.Decimal(7, 4)
  descontoAVistaPercent      Decimal? @db.Decimal(7, 4)

  // ââ cÃ¢mbio ââ
  politicaCambio String  @default("VARIAVEL") @db.VarChar(20) // FIXO | VARIAVEL | CONTRATACAO | RECEBIMENTO
  travaCambial   Boolean @default(false)

  // ââ restriÃ§Ãµes de uso ââ
  aplicaA          String   @default("AMBOS") @db.VarChar(20) // RECEITA | CUSTO | AMBOS
  moedasPermitidas String[] @default([])
  valorMinimo      Decimal? @db.Decimal(12, 2)
  valorMaximo      Decimal? @db.Decimal(12, 2)
  paises           String[] @default([])
  modalidades      String[] @default([])
  tiposProcesso    String[] @default([])

  observacoes String? @db.Text

  // ââ REGRA REUTILIZÃVEL (Receita â CobranÃ§a â Parcelas â Pagamentos) ââ
  // A CondiÃ§Ã£o Ã© apenas a REGRA que o motor usa ao criar uma CobranÃ§a. Ela nunca
  // congela dados da CobranÃ§a (cliente/conta/cotaÃ§Ã£o/datas reais). Tudo aqui Ã©
  // POLÃTICA/SUGESTÃO; a decisÃ£o efetiva pertence Ã  CobranÃ§a.

  // PolÃ­tica de Taxas: a taxa depende da FORMA escolhida na CobranÃ§a; aqui sÃ³ a polÃ­tica.
  politicaTaxas String @default("IGNORAR") @db.VarChar(30) // IGNORAR | REPASSAR | ABSORVER | ESCOLHER_NA_COBRANCA

  // Forma SUGERIDA (nÃ£o escolhe; apenas sugere). Ref. solta â FormaPagamentoCadastro.
  formaSugeridaId Int?

  // Entrada (expansÃ£o)
  entradaTipo        String?  @db.VarChar(20) // PERCENTUAL | VALOR_FIXO
  entradaMin         Decimal? @db.Decimal(12, 2)
  entradaMax         Decimal? @db.Decimal(12, 2)
  entradaCompoeTotal Boolean  @default(true)
  entradaAdicional   Boolean  @default(false)

  // Cronograma â comportamentos explÃ­citos (nunca implÃ­citos)
  diaInexistente         String? @db.VarChar(20) // ULTIMO_DIA | PROX_UTIL | ANT_UTIL
  comportamentoFimSemana String? @db.VarChar(20) // MANTER | PROX_UTIL | ANT_UTIL
  comportamentoFeriado   String? @db.VarChar(20) // MANTER | PROX_UTIL | ANT_UTIL

  // Encargos (expansÃ£o)
  multaTipo               String?  @db.VarChar(20) // FIXA | PERCENTUAL
  multaValor              Decimal? @db.Decimal(12, 2)
  jurosTipo               String?  @db.VarChar(20) // SIMPLES | COMPOSTO
  jurosPeriodo            String?  @db.VarChar(20) // DIARIO | MENSAL
  carenciaDias            Int?
  descontoTipo            String?  @db.VarChar(20) // COMERCIAL | ANTECIPACAO
  descontoAntecipacaoAuto Boolean  @default(false)
  quemConcedeDesconto     String?  @db.VarChar(40)

  // Aplicabilidade (expansÃ£o)
  // perfil/canal: LEGADO. NÃ£o tÃªm regra de negÃ³cio no motor (condicaoAplicavel nunca os lÃª).
  // Colunas PRESERVADAS com os dados histÃ³ricos; a UI e o payload deixaram de expÃ´-los.
  perfil   String? @db.VarChar(60)
  canal    String? @db.VarChar(60)
  servicos Int[]   @default([]) // PROJEÃÃO derivada de servicosPermitidos (ids ServicoProduto)

  // ââ vÃ­nculos ââ
  formasPermitidas CondicaoPagamentoForma[]
  taxasVinculadas  CondicaoPagamentoTaxa[]

  // Aplicabilidade por RELACIONAMENTO REAL (fonte da verdade da tela e da API).
  // As colunas-array acima (moedasPermitidas/paises/modalidades/servicos) seguem
  // gravadas como PROJEÃÃO derivada destes vÃ­nculos, para o motor de cÃ¡lculo
  // (condicaoAplicavel) continuar intacto.
  moedasVinculadas      CondicaoPagamentoMoeda[]
  paisesPermitidos      CondicaoPagamentoPais[]
  modalidadesPermitidas CondicaoPagamentoModalidade[]
  servicosPermitidos    CondicaoPagamentoServico[]
  configuracoes         ProdutoFinanceiro[]           @relation("ConfigFinCondicaoPagamento")
  receitas              Receita[]                     @relation("ReceitaCondicaoPagamento")
  custos                Custo[]                       @relation("CustoCondicaoPagamento")

  @@unique([codigo, versao])
  @@index([carteiraId])
  @@index([codigo])
  @@index([substituiId])
}

// Formas de pagamento aceitas por uma condiÃ§Ã£o (N:N).
model CondicaoPagamentoForma {
