  fixedFee            Decimal?  @db.Decimal(12, 2)
  anticipationEnabled Boolean   @default(false)
  anticipationPercent Decimal?  @db.Decimal(7, 4)
  installmentsFrom    Int?
  installmentsTo      Int?
  // IncidÃªncia e absorÃ§Ã£o (motor lib/financeiro/taxas-pagamento.ts)
  // baseIncidencia/quemAbsorve sÃ£o VarChar: os valores foram AMPLIADOS (validaÃ§Ã£o no cÃ³digo).
  baseIncidencia      String    @default("TOTAL") @db.VarChar(20) // TOTAL | PARCELA | SALDO | ENTRADA | LIQUIDO | BRUTO
  quemAbsorve         String    @default("EMPRESA") @db.VarChar(20) // EMPRESA | CLIENTE | COMPARTILHADA | COBRANCA
  adquirente          String?   @db.VarChar(120) // legado (string). A entidade oficial Ã© adquirenteId.
  // VÃ­nculo com as ENTIDADES oficiais (aditivo; `adquirente` string preservado p/ compat).
  adquirenteId        Int? // â Adquirente.id
  bandeiraId          Int? // â Bandeira.id
  // Finalidade do encargo (boleto): EMISSAO | PAGAMENTO | MULTA | JUROS. MantÃ©m
  // emissÃ£o/pagamento/multa/juros como registros SEPARADOS (nunca uma taxa
  // genÃ©rica). Nulo para as demais formas. Aditivo â compÃµe a chave de unicidade.
  finalidade          String?   @db.VarChar(20)
  ativo               Boolean   @default(true)
  vigenciaInicio      DateTime?
  vigenciaFim         DateTime?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  // ââ REGRA REUTILIZÃVEL de cÃ¡lculo de taxa (aditivo) ââ
  // A Taxa nÃ£o conhece Receita/CobranÃ§a/Pagamento â sÃ³ parametriza o cÃ¡lculo. A
  // CobranÃ§a escolhe a Forma, o motor resolve a taxa compatÃ­vel e CONGELA na CobranÃ§a.
  descricao        String? @db.VarChar(300)
  categoria        String? @db.VarChar(40) // TAXA_CARTAO | TARIFA_BANCARIA | GATEWAY | ANTECIPACAO | IOF | SPREAD_CAMBIAL | OUTRO
  formasAplicaveis Int[]   @default([]) // mÃºltiplas Formas (ref. solta); formaPagamentoId Ãºnica fica p/ compat

  // aplicaÃ§Ã£o por parcela (substitui installmentsFrom/To â mantidos p/ FAIXA/compat)
  aplicaParcela String? @db.VarChar(20) // TODAS | ENTRADA | PRIMEIRA | ULTIMA | FAIXA

  // antecipaÃ§Ã£o (expansÃ£o â anticipationEnabled/Percent mantidos p/ compat)
  anticipationType    String?  @db.VarChar(20) // NAO_POSSUI | OPCIONAL | OBRIGATORIA
  anticipationFixed   Decimal? @db.Decimal(12, 2)
  anticipationMinDays Int?

  // absorÃ§Ã£o compartilhada
  absorcaoPercentEmpresa Decimal? @db.Decimal(5, 2)

  // prioridade quando 2 taxas concorrem
  prioridade Int @default(0)

  // regras de aplicaÃ§Ã£o (tudo opcional)
  paises           String[] @default([])
  moedasAplicaveis String[] @default([])
  servicos         Int[]    @default([])
  modalidades      String[] @default([])
  tiposProcesso    String[] @default([])
  valorMinimo      Decimal? @db.Decimal(12, 2)
  valorMaximo      Decimal? @db.Decimal(12, 2)
  canal            String?  @db.VarChar(60)
  gateway          String?  @db.VarChar(40)
  perfil           String?  @db.VarChar(60)

  // cÃ¢mbio (taxa internacional)
  momentoCambio String? @db.VarChar(20) // ANTES_CONVERSAO | APOS_CONVERSAO | MOEDA_CONTRATUAL | MOEDA_LIQUIDACAO

  condicoes CondicaoPagamentoTaxa[]

  // Aplicabilidade por RELACIONAMENTO REAL (fonte da verdade da tela e da API).
  // `paises` e `moedasAplicaveis` (arrays de texto acima) continuam gravados como
  // PROJEÃÃO derivada destes vÃ­nculos â o motor (candidataElegivel) segue intacto.
  moedasVinculadas TaxaPagamentoMoeda[]
  paisesPermitidos TaxaPagamentoPais[]

  // TABELA DE PARCELAMENTO â a tabela comercial da adquirente dentro de UMA
  // taxa (1x 2,99% / 2x 3,39% / 3â6x 4,19%â¦). Vazia = a taxa usa feePercent /
  // fixedFee do prÃ³prio registro (comportamento anterior, intacto).
  parcelamento TaxaParcelamento[]

  @@index([ativo, prioridade])
}

// Uma LINHA da tabela comercial: uma quantidade de parcelas (de = atÃ©) ou uma
// FAIXA (1â3, 4â6, 7â12). As faixas nÃ£o podem se sobrepor â a cobranÃ§a resolve
