  percentual     Decimal?              @db.Decimal(7, 4)
  valor          Decimal?              @db.Decimal(14, 2)
  moeda          Moeda                 @default(BRL)
  ordem          Int                   @default(0)

  @@index([distribuicaoId])
  @@index([pessoaId])
