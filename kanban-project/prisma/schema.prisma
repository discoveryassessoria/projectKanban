  // VÃ­nculo com as ENTIDADES oficiais (aditivo; `adquirente` string preservado p/ compat).
  adquirenteId        Int? // â Adquirente.id
  bandeiraId          Int? // â Bandeira.id
  // Finalidade do encargo (boleto): EMISSAO | PAGAMENTO | MULTA | JUROS. MantÃ©m
  // emissÃ£o/pagamento/multa/juros como registros SEPARADOS (nunca uma taxa
  // genÃ©rica). Nulo para as demais formas. Aditivo â compÃµe a chave de unicidade.
  finalidade          String?   @db.VarChar(20)
  ativo               Boolean   @default(true)
  vigenciaInicio      DateTime?
  vigenciaFim         DateTime?
  criadoEm            DateTime  @default(now())
