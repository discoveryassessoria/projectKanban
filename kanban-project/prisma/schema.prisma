  conflitosRegistrais ConflitoRegistral[]

  // MODELOS DOCUMENTAIS — documentos gerados vinculados a este processo.
  documentosGerados DocumentoGerado[]        @relation("DocumentoGeradoProcesso")
  planilhaOverrides PlanilhaCelulaOverride[]
