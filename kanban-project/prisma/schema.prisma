  membros      GrupoUsuarioMembro[]
}

model GrupoUsuarioMembro {
  id        Int          @id @default(autoincrement())
  grupoId   Int
  usuarioId Int
  criadoEm  DateTime     @default(now())
  grupo     GrupoUsuario @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
}

/// Cargos operacionais (papel funcional; autorização continua em Perfis/Permissões).
model CargoCadastro {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(60)
  nome         String   @db.VarChar(200)
  area         String?  @db.VarChar(80)
  descricao    String?  @db.Text
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// NOTA: o cadastro "Tipos de Protocolo" (TipoProtocoloCadastro) foi ELIMINADO em
// 02/08/2026. Protocolo NÃO é cadastro mestre: é uma OCORRÊNCIA operacional
// registrada dentro do Processo (model `Protocolo`), com órgão, setor, data/hora,
// número, tipo, forma de envio, responsável, comprovante, observações e documentos
// enviados — e que gera evento na Timeline/Histórico do Processo.

/// Configuração global chave/valor (Sistema › Configurações Gerais e Identidade Visual).
model ConfiguracaoSistema {
