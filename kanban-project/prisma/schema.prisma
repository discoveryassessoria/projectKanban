  ALTO
  MEDIO
  BAIXO
  INFO
}

enum StatusConflitoRegistral {
  ABERTO
  EM_REVISAO
  RESOLVIDO
  DESCARTADO
}

enum ResultadoLinhagemRegistral {
  LINHA_COMPLETA_COMPROVADA
  LINHA_COMPLETA_COM_PENDENCIAS
  LINHA_ESTRUTURAL_INCOMPLETA
  LINHA_CONFLITANTE
  ASCENDENTE_ELEGIVEL_NAO_IDENTIFICADO
  REVISAO_OBRIGATORIA
}

/// LOTE — uma passada do motor sobre a Pasta Documental de um processo.
/// Idempotente por chaveIdempotencia: reenviar o mesmo lote nao reprocessa nem
/// duplica; devolve o lote existente.
model LoteRegistral {
  id         Int      @id @default(autoincrement())
  processoId Int
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  arvoreId   Int?
  arvore     Arvore?  @relation(fields: [arvoreId], references: [id], onDelete: SetNull)

  status        StatusLoteRegistral @default(RECEBIDO)
  correlationId String              @db.VarChar(60)
  versaoMotor   String              @db.VarChar(20)

  totalDocumentos Int @default(0)
  processados     Int @default(0)
  falhos          Int @default(0)
  aguardando      Int @default(0)

  pessoasCriadas    Int @default(0)
  vinculosCriados   Int @default(0)
  evidenciasCriadas Int @default(0)
  propostasCriadas  Int @default(0)
  conflitosAbertos  Int @default(0)

  metricas Json?
  resumo   String? @db.Text

  criadoPorId Int?
  criadoPor   Usuario? @relation("LoteRegistralAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  chaveIdempotencia String    @unique @db.VarChar(200)
  criadoEm          DateTime  @default(now())
  iniciadoEm        DateTime?
  finalizadoEm      DateTime?
  atualizadoEm      DateTime  @updatedAt

  execucoes ExecucaoRegistral[]
  propostas PropostaReconciliacao[]
  conflitos ConflitoRegistral[]

  @@index([processoId, status])
  @@index([correlationId])
  @@index([criadoEm])
}

/// EXECUCAO — o pipeline de UM documento dentro de um lote. Estado atual +
/// controle de retomada (tentativas, backoff, claim atomico).
model ExecucaoRegistral {
  id     Int           @id @default(autoincrement())
  loteId Int
  lote   LoteRegistral @relation(fields: [loteId], references: [id], onDelete: Cascade)

  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  necessidadeId Int?
  necessidade   NecessidadeDocumental? @relation(fields: [necessidadeId], references: [id], onDelete: SetNull)

  etapa          EtapaRegistral @default(RECEBIDO)
  /// Classificacao resolvida (code do ItemCatalogo / natureza da certidao).
  tipoDetectado  String?        @db.VarChar(60)
  confiancaTipo  Float?
  versaoExtrator String         @db.VarChar(20)
  fonteTexto     String?        @db.VarChar(30)

  tentativas            Int       @default(0)
  proximaEm             DateTime?
  reservadoEm           DateTime?
  erro                  String?   @db.Text
  /// Contadores do que ESTA execucao produziu — base das metricas do lote.
  ocorrenciasDetectadas Int       @default(0)
  camposExtraidos       Int       @default(0)
  camposDivergentes     Int       @default(0)
  evidenciasCriadas     Int       @default(0)

  correlationId     String    @db.VarChar(60)
  chaveIdempotencia String    @unique @db.VarChar(200)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  finalizadoEm      DateTime?

  etapas      EtapaExecucaoRegistral[]
  ocorrencias OcorrenciaDocumental[]
  evidencias  EvidenciaRegistral[]
  propostas   PropostaReconciliacao[]
  conflitos   ConflitoRegistral[]

  @@index([loteId, etapa])
  @@index([documentoId])
  @@index([etapa, proximaEm])
  @@index([correlationId])
}

/// Trilha append-only de CADA transicao de etapa — inclusive as que falharam.
model EtapaExecucaoRegistral {
  id         Int               @id @default(autoincrement())
  execucaoId Int
  execucao   ExecucaoRegistral @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  etapa     EtapaRegistral
  ok        Boolean
  mensagem  String?        @db.VarChar(500)
  duracaoMs Int?
  tentativa Int            @default(1)
  dados     Json?

  criadoEm DateTime @default(now())

  @@index([execucaoId, criadoEm])
  @@index([etapa])
}

/// OCORRENCIA DOCUMENTAL — uma pessoa COMO ELA APARECE num documento.
/// Nunca e uma Pessoa: e a mencao. A ligacao com a identidade humana acontece
/// em CorrespondenciaIdentidade e, quando resolvida, em pessoaResolvidaId.
model OcorrenciaDocumental {
  id         Int               @id @default(autoincrement())
  execucaoId Int
  execucao   ExecucaoRegistral @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  papel PapelOcorrencia

  nomeBruto       String  @db.VarChar(300)
  nomeNormalizado String  @db.VarChar(300)
  chaveFonetica   String? @db.VarChar(80)
  sexoInferido    String? @db.VarChar(10)

  /// Atributos brutos da mencao (datas, locais, idade, profissao, filiacao
  /// citada...). E o insumo do motor de identidade, nao um cadastro paralelo.
  atributos Json?

  pessoaResolvidaId Int?
  pessoaResolvida   Pessoa? @relation("OcorrenciaPessoaResolvida", fields: [pessoaResolvidaId], references: [id], onDelete: SetNull)

  classe                   ClasseCorrespondencia?
  scoreIdentidade          Float?
  /// Resolucao automatica so acontece quando classe=CONFIRMADA e sem impacto
  /// estrutural. Fora disso fica null e nasce proposta/conflito.
  resolvidaAutomaticamente Boolean                @default(false)

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  correspondencias CorrespondenciaIdentidade[]
  evidencias       EvidenciaRegistral[]

  @@index([execucaoId])
  @@index([documentoId, papel])
  @@index([chaveFonetica])
  @@index([pessoaResolvidaId])
}

/// FATO REGISTRAL — a afirmacao auditavel sobre um campo de uma pessoa/uniao.
/// Append-only: corrigir e criar nova versao e supersedir a anterior.
model FatoRegistral {
  id       Int     @id @default(autoincrement())
  pessoaId Int?
  pessoa   Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  uniaoId  Int?
  uniao    Uniao?  @relation(fields: [uniaoId], references: [id], onDelete: Cascade)

  campo CampoRegistral

  valorBruto       String?   @db.VarChar(400)
  valorNormalizado String?   @db.VarChar(400)
  /// Valor tipado quando aplicavel (data ISO, id de pessoa em filiacao...).
  valorData        DateTime?
  valorPessoaId    Int?

  estado    EstadoFatoRegistral @default(NAO_INFORMADO)
  /// Escala UNICA do Discovery (lib/cadastro-mestre/afirmacao): CONFIRMADO |
  /// PROVAVEL | HIPOTESE | CONTESTADO.
  confianca String              @db.VarChar(12)

  // ---- afirmacao auditavel (os seis campos obrigatorios) ----
  origem        String   @db.VarChar(16)
  responsavelId Int?
  responsavel   Usuario? @relation("FatoRegistralResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  afirmadoEm    DateTime @default(now())
  justificativa String?  @db.VarChar(500)
  regraAplicada String?  @db.VarChar(80)

  totalEvidencias      Int @default(0)
  evidenciasFavoraveis Int @default(0)
  evidenciasContrarias Int @default(0)

  // ---- versionamento append-only ----
  versao           Int            @default(1)
  ativo            Boolean        @default(true)
  supersedidoPorId Int?           @unique
  supersedidoPor   FatoRegistral? @relation("FatoSupersessao", fields: [supersedidoPorId], references: [id], onDelete: SetNull)
  supersede        FatoRegistral? @relation("FatoSupersessao")

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  evidencias EvidenciaRegistral[]
  propostas  PropostaReconciliacao[]

  @@index([pessoaId, campo, ativo])
  @@index([uniaoId, campo, ativo])
  @@index([estado])
  @@index([campo])
}

/// EVIDENCIA REGISTRAL — granular, imutavel, sempre rastreavel ao documento.
/// Sem uma destas, nenhum fato pode chegar a CONFIRMADO.
model EvidenciaRegistral {
  id         Int                @id @default(autoincrement())
  execucaoId Int?
  execucao   ExecucaoRegistral? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)

  /// Documento do Processo (dono do arquivo — o motor apenas referencia).
  documentoId    Int
  documento      Documento              @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  /// Documento Mestre (ItemCatalogo) e Necessidade que o documento atende.
  itemCatalogoId Int?
  itemCatalogo   ItemCatalogo?          @relation(fields: [itemCatalogoId], references: [id], onDelete: SetNull)
  necessidadeId  Int?
  necessidade    NecessidadeDocumental? @relation(fields: [necessidadeId], references: [id], onDelete: SetNull)

  ocorrenciaId Int?
  ocorrencia   OcorrenciaDocumental? @relation(fields: [ocorrenciaId], references: [id], onDelete: SetNull)
  fatoId       Int?
  fato         FatoRegistral?        @relation(fields: [fatoId], references: [id], onDelete: SetNull)

  pessoaId Int?
  pessoa   Pessoa? @relation("EvidenciaPessoa", fields: [pessoaId], references: [id], onDelete: SetNull)
  uniaoId  Int?
  uniao    Uniao?  @relation("EvidenciaUniao", fields: [uniaoId], references: [id], onDelete: SetNull)

  campo CampoRegistral

  pagina           Int?
  /// Regiao/trecho localizavel: "linha 12-14", "offset 1840-1902".
  regiao           String? @db.VarChar(60)
  trechoTexto      String? @db.VarChar(600)
  valorBruto       String? @db.VarChar(400)
  valorNormalizado String? @db.VarChar(400)

  metodoExtracao      String  @db.VarChar(40)
  versaoProcessamento String  @db.VarChar(20)
  confiancaExtracao   Float
  confiancaAssociacao Float
  regraAplicada       String? @db.VarChar(80)
  /// Evidencia pode ser CONTRARIA (o documento contradiz o fato).
  favoravel           Boolean @default(true)

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())

  @@index([documentoId, campo])
  @@index([fatoId])
  @@index([ocorrenciaId])
  @@index([pessoaId, campo])
  @@index([necessidadeId])
}

/// CORRESPONDENCIA DE IDENTIDADE — candidato "esta ocorrencia e esta Pessoa",
/// com classe conservadora e evidencias explicitas dos dois lados.
model CorrespondenciaIdentidade {
  id           Int                  @id @default(autoincrement())
  ocorrenciaId Int
  ocorrencia   OcorrenciaDocumental @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)

  pessoaId Int
  pessoa   Pessoa @relation("CorrespondenciaPessoa", fields: [pessoaId], references: [id], onDelete: Cascade)

  classe     ClasseCorrespondencia
  score      Float
  /// Evidencias favoraveis e contrarias que produziram a classe (snapshot).
  evidencias Json

  /// Decisao humana quando exigida: ACEITA | RECUSADA | ADIADA.
  decisao       String?   @db.VarChar(12)
  decididoPorId Int?
  decididoPor   Usuario?  @relation("CorrespondenciaDecisor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  decididoEm    DateTime?

  /// Liga a triagem MDM-3 quando a decisao passou pelo fluxo de dedup.
  decisaoDedupId Int?
  decisaoDedup   DecisaoDeduplicacao? @relation("DedupCorrespondencia", fields: [decisaoDedupId], references: [id], onDelete: SetNull)

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([ocorrenciaId, classe])
  @@index([pessoaId])
  @@index([score])
}

/// PROPOSTA DE RECONCILIACAO — nenhuma alteracao registral sensivel acontece
/// sem passar por aqui. Guarda antes, depois e porque.
model PropostaReconciliacao {
  id         Int      @id @default(autoincrement())
  processoId Int
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  arvoreId   Int?
  arvore     Arvore?  @relation(fields: [arvoreId], references: [id], onDelete: SetNull)

  loteId     Int?
  lote       LoteRegistral?     @relation(fields: [loteId], references: [id], onDelete: SetNull)
  execucaoId Int?
  execucao   ExecucaoRegistral? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)

  tipo        TipoPropostaRegistral
  criticidade CriticidadeRegistral
  status      StatusPropostaRegistral @default(PENDENTE)

  /// Alvo da alteracao. entidadeAlvo: PESSOA | UNIAO | FATO | NECESSIDADE | DOCUMENTO.
  entidadeAlvo String          @db.VarChar(20)
  alvoId       Int?
  campo        CampoRegistral?
  fatoId       Int?
  fato         FatoRegistral?  @relation(fields: [fatoId], references: [id], onDelete: SetNull)

  valorAtual          String? @db.VarChar(400)
  valorProposto       String? @db.VarChar(400)
  origemValorAtual    String? @db.VarChar(120)
  origemValorProposto String? @db.VarChar(120)

  evidenciasFavoraveis Json
  evidenciasContrarias Json
  confianca            Float
  justificativa        String              @db.Text
  regraAplicada        String              @db.VarChar(80)
  recomendacao         String?             @db.VarChar(300)
  risco                SeveridadeRegistral @default(BAIXO)

  /// Payload canonico da alteracao (o que aplicar). Interpretado pelo aplicador,
  /// nunca por tela.
  operacao Json

  pessoasAfetadas          Json?
  vinculosAfetados         Json?
  documentosAfetados       Json?
  processosAfetados        Json?
  necessidadesAfetadas     Json?
  /// true so quando a matriz de automacao permite aplicar sem humano.
  aplicavelAutomaticamente Boolean @default(false)

  decididoPorId Int?
  decididoPor   Usuario?  @relation("PropostaDecisor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  decididoEm    DateTime?
  decisaoNota   String?   @db.VarChar(500)

  aplicadoEm              DateTime?
  revertidoEm             DateTime?
  revertidaPorId          Int?
  revertidaPor            Usuario?  @relation("PropostaRevertePor", fields: [revertidaPorId], references: [id], onDelete: SetNull)
  motivoAbortoRevalidacao String?   @db.Text

  versaoArvoreAntes  Int?
  versaoArvoreDepois Int?

  correlationId     String   @db.VarChar(60)
  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  impactos  ImpactoAplicacaoRegistral[]
  decisoes  DecisaoRevisaoRegistral[]
  conflitos ConflitoRegistral[]

  @@index([processoId, status])
  @@index([loteId])
  @@index([tipo, status])
  @@index([criticidade, status])
  @@index([correlationId])
}

/// CONFLITO — divergencia que o motor NAO tem direito de resolver sozinho.
model ConflitoRegistral {
  id         Int      @id @default(autoincrement())
  processoId Int
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  arvoreId   Int?
  arvore     Arvore?  @relation(fields: [arvoreId], references: [id], onDelete: SetNull)

  loteId     Int?
  lote       LoteRegistral?     @relation(fields: [loteId], references: [id], onDelete: SetNull)
  execucaoId Int?
  execucao   ExecucaoRegistral? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)

  /// Codigo estavel da regra que abriu o conflito (ex.: LEITURA_DIVERGENTE,
  /// FILIACAO_CONTRADITORIA, CICLO_GENEALOGICO).
  codigo     String                  @db.VarChar(60)
  severidade SeveridadeRegistral
  status     StatusConflitoRegistral @default(ABERTO)

  campo    CampoRegistral?
  pessoaId Int?
  pessoa   Pessoa?         @relation("ConflitoPessoa", fields: [pessoaId], references: [id], onDelete: SetNull)
  uniaoId  Int?
  uniao    Uniao?          @relation("ConflitoUniao", fields: [uniaoId], references: [id], onDelete: SetNull)

  descricao    String  @db.VarChar(300)
  explicacao   String  @db.Text
  acaoSugerida String? @db.VarChar(300)
  evidencias   Json
  documentoIds Json?

  propostaId Int?
  proposta   PropostaReconciliacao? @relation(fields: [propostaId], references: [id], onDelete: SetNull)

  resolvidoPorId Int?
  resolvidoPor   Usuario?  @relation("ConflitoResolvedor", fields: [resolvidoPorId], references: [id], onDelete: SetNull)
  resolvidoEm    DateTime?
  resolucaoNota  String?   @db.VarChar(500)

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  decisoes DecisaoRevisaoRegistral[]

  @@index([processoId, status])
  @@index([severidade, status])
  @@index([codigo])
  @@index([pessoaId])
}

/// ANALISE DE IMPACTO — calculada ANTES de aplicar proposta sensivel.
/// `bloqueado` = a aplicacao seria abortada (inconsistencia critica).
model ImpactoAplicacaoRegistral {
  id         Int                   @id @default(autoincrement())
  propostaId Int
  proposta   PropostaReconciliacao @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  calculadoEm DateTime @default(now())
  /// PREVIO (antes de aplicar) | POSTERIOR (revalidacao pos-aplicacao).
  momento     String   @db.VarChar(10)

  pessoasAfetadas           Int @default(0)
  arvoresAfetadas           Int @default(0)
  requerentesAfetados       Int @default(0)
  processosAfetados         Int @default(0)
  vinculosAlterados         Int @default(0)
  documentosRelacionados    Int @default(0)
  necessidadesRecalculadas  Int @default(0)
  inconsistenciasCriadas    Int @default(0)
  inconsistenciasResolvidas Int @default(0)

  linhaAntes          Json?
  linhaDepois         Json?
  elegibilidadeAntes  ResultadoLinhagemRegistral?
  elegibilidadeDepois ResultadoLinhagemRegistral?

  riscoDuplicidade SeveridadeRegistral @default(INFO)
  riscoDocumental  SeveridadeRegistral @default(INFO)
  riscoOperacional SeveridadeRegistral @default(INFO)

  bloqueado      Boolean @default(false)
  motivoBloqueio String? @db.Text
  detalhes       Json?

  chaveIdempotencia String @unique @db.VarChar(200)

  @@index([propostaId, momento])
  @@index([bloqueado])
}

/// DECISAO DE REVISAO — quem decidiu o que, quando e por que. Append-only.
model DecisaoRevisaoRegistral {
  id         Int                    @id @default(autoincrement())
  propostaId Int?
  proposta   PropostaReconciliacao? @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  conflitoId Int?
  conflito   ConflitoRegistral?     @relation(fields: [conflitoId], references: [id], onDelete: Cascade)

  /// APROVAR | REJEITAR | ADIAR | REVERTER | RESOLVER_CONFLITO | DESCARTAR_CONFLITO
  decisao   String @db.VarChar(24)
  motivo    String @db.VarChar(500)
  /// Permissao efetivamente exercida — auditoria de autorizacao.
  permissao String @db.VarChar(60)

  responsavelId Int?
  responsavel   Usuario? @relation("DecisaoRegistralResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  correlationId     String?  @db.VarChar(60)
  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())

  @@index([propostaId])
  @@index([conflitoId])
  @@index([responsavelId])
  @@index([criadoEm])
}

/// VERSAO GENEALOGICA — snapshot logico da arvore. Base da comparacao entre
/// versoes e da reversao segura. Nunca apagado por exclusao comum.
model VersaoGenealogica {
  id       Int    @id @default(autoincrement())
  arvoreId Int
  arvore   Arvore @relation(fields: [arvoreId], references: [id], onDelete: Cascade)

  versao   Int
  motivo   String @db.VarChar(200)
  /// Snapshot determinístico: pessoas, vinculos, fatos ativos e linha apurada.
  snapshot Json
  hash     String @db.VarChar(64)

  propostaId    Int?
  correlationId String? @db.VarChar(60)

  criadoPorId Int?
  criadoPor   Usuario? @relation("VersaoGenealogicaAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  criadoEm    DateTime @default(now())

  @@unique([arvoreId, versao])
  @@index([arvoreId, criadoEm])
  @@index([hash])
}

/// METRICA REGISTRAL — contadores de observabilidade agregados por janela.
/// Nunca guarda conteudo do documento (so contagem/tempo).
model MetricaRegistral {
  id     Int    @id @default(autoincrement())
  chave  String @db.VarChar(60)
  escopo String @db.VarChar(40)

  janelaInicio DateTime
  valor        Float    @default(0)
  amostras     Int      @default(0)
  atualizadoEm DateTime @updatedAt

  @@unique([chave, escopo, janelaInicio])
  @@index([chave, janelaInicio])
}

// ════════════════════════ SAÚDE DO SISTEMA ═════════════════════════════════
// Auditoria contínua. O histórico NUNCA é apagado: é ele que mostra problema
// novo × recorrente × resolvido e o tempo de resolução.

/// Uma rodada do motor de diagnóstico.
model SaudeExecucao {
  id                   Int      @id @default(autoincrement())
  modo                 String   @db.VarChar(20) // RAPIDO | COMPLETO | PROFUNDO
  estado               String   @db.VarChar(30) // SAUDAVEL | ATENCAO | DEGRADADO | CRITICO | DIAGNOSTICO_INCOMPLETO | INDISPONIVEL
  motivoEstado         String   @db.Text
  versaoCatalogo       String   @db.VarChar(20)
  iniciadoEm           DateTime
  concluidoEm          DateTime
  duracaoMs            Int
  totalCatalogo        Int
  totalElegiveis       Int
  executadas           Int
  aprovadas            Int
  comAchados           Int
  falhasTecnicas       Int
  naoExecutadas        Int
  coberturaPercentual  Int
  criticos             Int
  erros                Int
  alertas              Int
  informativos         Int
  /// resultado por verificação (código, status, duração, métricas, erro)
  execucoes            Json
  dominiosSemCobertura String[] @default([])
  /// quem disparou (null = automático)
  disparadoPorId       Int?
  criadoEm             DateTime @default(now())

  achados SaudeAchado[]

  @@index([criadoEm])
  @@index([estado])
  @@index([modo])
}

/// Um problema concreto, com vida própria entre execuções: primeira detecção,
/// última detecção, recorrências e resolução.
model SaudeAchado {
  id                 Int            @id @default(autoincrement())
  /// identidade estável do problema (código da verificação + chave do achado)
  chave              String         @unique @db.VarChar(300)
  codigo             String         @db.VarChar(60)
  dominio            String         @db.VarChar(40)
  modulo             String         @db.VarChar(60)
  severidade         String         @db.VarChar(20)
  titulo             String         @db.VarChar(300)
  descricao          String         @db.Text
  explicacao         String?        @db.Text
  impacto            String?        @db.Text
  entidade           String?        @db.VarChar(80)
  registroId         String?        @db.VarChar(60)
  registroNome       String?        @db.VarChar(300)
  quantidade         Int            @default(1)
  link               String?        @db.VarChar(300)
  recomendacao       String?        @db.Text
  correcaoAutomatica String?        @db.VarChar(60)
  evidencia          Json?
  /// ABERTO | RECONHECIDO | EM_CORRECAO | RESOLVIDO | REINCIDENTE | IGNORADO
  status             String         @default("ABERTO") @db.VarChar(20)
  primeiraDeteccao   DateTime       @default(now())
  ultimaDeteccao     DateTime       @default(now())
  resolvidoEm        DateTime?
  recorrencias       Int            @default(1)
  responsavelId      Int?
  /// justificativa obrigatória para IGNORADO — problema ignorado continua visível
  justificativa      String?        @db.Text
  ignoradoPorId      Int?
  ignoradoAte        DateTime?
  versaoCatalogo     String         @db.VarChar(20)
  execucaoId         Int?
  execucao           SaudeExecucao? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  atualizadoEm       DateTime       @updatedAt

  @@index([status])
  @@index([severidade])
  @@index([dominio])
  @@index([codigo])
  @@index([ultimaDeteccao])
}

// ============================================================================
// EMISSAO DOCUMENTAL - SOLICITACAO, ARQUIVOS E OBSERVACOES DO DOCUMENTO
// ============================================================================
//
// FONTE UNICA da solicitacao de certidao. Ate aqui, o que o operador preenchia em
// "Solicitar certidao" ficava em tres lugares e nenhum era canonico: campos soltos
// do Documento (protocolo, canal_solicitacao, cartorio, link_acompanhamento) e
// metadata.operacao do passo. Consequencia: o arquivo do requerimento existia no R2
// mas nao tinha registro, o numero de protocolo nao virava Protocolo, e a aba
// Protocolo do documento nao tinha o que ler.
//
// A solicitacao e o ATO; o protocolo e o que o orgao devolve (pode nao existir no
// envio, pode chegar depois, pode haver mais de um). Por isso protocolo NAO e coluna
// da solicitacao: e o cadastro Protocolo ja existente, apontando para ela.

/// Canal pelo qual a solicitacao foi enviada. Dimensao FECHADA de dominio (mesma
/// natureza de TipoProtocolo/FormaEnvioProtocolo) - nao e cadastro mestre: o canal
/// nao tem atributos proprios administraveis, so identidade.
enum CanalSolicitacaoDocumento {
  CRC
  ECARTORIO
  EMAIL
  WHATSAPP
  BALCAO
  COMUNE
  CORREIOS
  CONSULADO
}

enum StatusSolicitacaoDocumento {
  /// Enviada; o canal nao exige protocolo imediato ou ele ainda nao chegou.
  AGUARDANDO_PROTOCOLO
  /// Enviada e com numero de protocolo registrado.
  PROTOCOLADA
  /// O orgao respondeu (documento recebido / recusado).
  RESPONDIDA
  /// Solicitacao cancelada; preservada para historico.
  CANCELADA
}

/// Natureza do arquivo dentro da operacao do documento. Fechada de proposito: a aba
/// Anexos agrupa por ela, e um tipo novo e decisao de dominio, nao texto livre.
enum TipoArquivoDocumento {
  REQUERIMENTO_ENVIADO
  COMPROVANTE_PROTOCOLO
  COMPROVANTE_CONTATO
  DOCUMENTO_RECEBIDO
  OUTRO
}

/// SOLICITACAO OFICIAL de um documento a um cartorio/orgao. Uma por envio formal;
/// reenvio gera OUTRA solicitacao (historico preservado, nada sobrescrito).
model SolicitacaoDocumento {
  id          Int       @id @default(autoincrement())
  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  /// Denormalizados por ESCOPO (nao por conveniencia): a consulta da aba Protocolo
  /// e por documento, e o isolamento entre processos precisa ser verificavel na linha.
  processoId  Int
  pessoaId    Int

  // Vinculos com a execucao que originou a solicitacao (nunca por nome/titulo).
  faseMacroKey       String @db.VarChar(60)
  workflowInstanceId Int?
  stepInstanceId     Int?
  tarefaId           Int?

  /// LEGADO EM TRANSIÇÃO: enum. Espelho derivado de `canalOperacionalId`, cuja
  /// ponte é `CanalOperacional.key` (mesmas 8 chaves).
  canal              CanalSolicitacaoDocumento
  /// IDENTIDADE CANÔNICA do canal. Fonte: Canais de atendimento.
  canalOperacionalId Int?
  canalOperacional   CanalOperacional?         @relation("SolicitacaoCanalCanonico", fields: [canalOperacionalId], references: [id], onDelete: Restrict)
  /// Orgao/cartorio quando ha cadastro (Orgaos e Organizacoes).
  orgaoId            Int?
  orgao              OrgaoProtocolo?           @relation(fields: [orgaoId], references: [id], onDelete: SetNull)
  /// Nome do destinatario quando nao ha cadastro correspondente. Nunca substitui orgaoId.
  destinatarioNome   String?                   @db.VarChar(200)
  /// Pessoa que atendeu (balcao, telefone, e-mail).
  atendente          String?                   @db.VarChar(200)

  dataEnvio          DateTime
  prazoEsperadoDias  Int?
  previsaoRetorno    DateTime?
  observacao         String?   @db.Text
  custoPago          Decimal?  @db.Decimal(12, 2)
  formaPagamento     String?   @db.VarChar(40)
  linkAcompanhamento String?   @db.VarChar(500)
  codigoRastreio     String?   @db.VarChar(100)

  status StatusSolicitacaoDocumento @default(AGUARDANDO_PROTOCOLO)

  criadoPorId Int?
  criadoPor   Usuario? @relation("SolicitacaoDocumentoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  /// Idempotencia do ato: duplo clique e retry caem na MESMA solicitacao.
  chaveIdempotencia String @unique @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  protocolos Protocolo[]
  arquivos   DocumentoArquivo[]

  @@index([documentoId, createdAt])
  @@index([processoId])
  @@index([stepInstanceId])
  @@index([tarefaId])
  @@index([status])
}

/// ARQUIVO vinculado a operacao de um documento - registro unico por arquivo.
/// A aba Anexos da ETAPA filtra por stepInstanceId; a do DOCUMENTO lista tudo e
/// agrupa por origem; a aba Protocolo le pelo protocolo. O binario e um so (R2);
/// aqui mora a REFERENCIA, e e ela que carrega TODOS os vinculos oficiais.
///
/// UMA LINHA, QUATRO VINCULOS. Nao existem quatro tabelas de juncao (StepAttachment,
/// RequestAttachment, ProtocolAttachment, DocumentAttachment): as quatro relacoes
/// vivem na MESMA linha, porque o arquivo e um so e cada vinculo e no maximo um.
/// Quatro tabelas seriam quatro chances de divergir sobre o mesmo fileId.
model DocumentoArquivo {
  id          Int       @id @default(autoincrement())
  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  /// Origem estrutural do arquivo. Ambos podem estar preenchidos (requerimento de
  /// uma solicitacao feita numa etapa); nenhum preenchido = arquivo do documento.
  solicitacaoId  Int?
  solicitacao    SolicitacaoDocumento? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)
  stepInstanceId Int?

  /// PROTOCOLO ao qual este arquivo pertence (o requerimento que gerou o numero,
  /// o comprovante do protocolo). Mesmo cadastro Protocolo; nunca uma copia.
  protocoloId Int?
  protocolo   Protocolo? @relation("ArquivoProtocolo", fields: [protocoloId], references: [id], onDelete: SetNull)

  /// CLASSIFICACAO MESTRE do arquivo (Cadastro Mestre de Documentos). Para o
  /// requerimento enviado ao cartorio e o ID oficial do DOC21 - resolvido no
  /// servidor pelo cadastro, nunca por nome de arquivo, rotulo de campo ou string
  /// "DOC21" espalhada no frontend.
  documentTypeId Int?
  documentType   TipoDocumentoCadastro? @relation("ArquivoTipoMestre", fields: [documentTypeId], references: [id], onDelete: Restrict)

  /// Finalidade do arquivo dentro da operacao (dimensao fechada).
  tipo TipoArquivoDocumento @default(OUTRO)

  url          String
  nome         String  @db.VarChar(300)
  mimeType     String? @db.VarChar(120)
  tamanho      Int?
  /// Impressao digital do conteudo (sha256:<hex>), calculada na origem do upload.
  /// Serve para provar que o binario e o mesmo e para reconhecer reenvio identico.
  hashConteudo String? @db.VarChar(80)

  // ── VERSIONAMENTO (a etapa reaberta e o botao "Trocar") ────────────────────
  /// Versao vigente do vinculo. Substituir NAO apaga: marca a anterior como nao
  /// vigente e preserva storageKey, autoria, data e historico.
  vigente            Boolean           @default(true)
  /// Arquivo que ESTE registro substituiu (a versao anterior).
  substituiId        Int?              @unique
  substitui          DocumentoArquivo? @relation("VersaoArquivo", fields: [substituiId], references: [id], onDelete: SetNull)
  /// Back-relation: a versao que substituiu este registro.
  substituidoPor     DocumentoArquivo? @relation("VersaoArquivo")
  /// Quando este registro deixou de ser vigente (null = vigente).
  substituidoEm      DateTime?
  motivoSubstituicao String?           @db.VarChar(300)

  criadoPorId Int?
  criadoPor   Usuario? @relation("DocumentoArquivoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// DEDUP: o mesmo arquivo (mesma URL) nao entra duas vezes no mesmo documento.
  /// E o que faz o retry de upload nao duplicar linha.
  @@unique([documentoId, url])
  @@index([documentoId, createdAt])
  @@index([stepInstanceId])
  @@index([solicitacaoId])
  @@index([protocoloId])
  @@index([documentTypeId])
  @@index([tipo])
  @@index([vigente])
}

/// EXIGENCIA DE EVIDENCIA DE UMA ETAPA - configuracao OFICIAL de qual documento
/// MESTRE precisa ser anexado ao executar um passo publicado.
///
/// POR QUE E TABELA, e nao constante no codigo: a exigencia aponta para uma LINHA
/// do Cadastro Mestre de Documentos (documentTypeId). Uma constante so poderia
/// referenciar o cadastro por texto ("DOC21", "Requerimento inteiro teor") - que e
/// exatamente a referencia estrutural por texto que a arquitetura proibe.
///
/// A etapa NAO decide por switch de canal no frontend: ela LE esta configuracao.
model ExigenciaEvidenciaEtapa {
  id Int @id @default(autoincrement())

  /// Chave canonica do passo publicado (PhaseInternalWorkflowStep.key).
  stepKey String @db.VarChar(80)

  /// Tipo do DOCUMENTO OPERACIONAL que dispara a exigencia (ex.: certidao em
  /// inteiro teor). NULL = qualquer tipo.
  documentoTipoId Int?
  documentoTipo   TipoDocumentoCadastro? @relation("ExigenciaDocumentoOperacional", fields: [documentoTipoId], references: [id], onDelete: Cascade)

  /// Canal da solicitacao. NULL = qualquer canal.
  canal CanalSolicitacaoDocumento?

  /// Documento MESTRE exigido como evidencia - o ID oficial (DOC21, para o
  /// requerimento). Restrict: nao se apaga do cadastro um tipo que e exigido.
  evidenciaTipoId Int
  evidenciaTipo   TipoDocumentoCadastro @relation("ExigenciaEvidenciaMestre", fields: [evidenciaTipoId], references: [id], onDelete: Restrict)

  /// Finalidade do arquivo dentro da operacao (dimensao fechada ja existente).
  finalidade TipoArquivoDocumento @default(REQUERIMENTO_ENVIADO)

  obrigatoria      Boolean @default(true)
  /// Quantos arquivos VIGENTES desta evidencia a etapa admite.
  cardinalidadeMax Int     @default(1)
  ativo            Boolean @default(true)

  /// Chave de identidade DERIVADA DOS IDS (step + tipo + canal + evidencia).
  /// Existe porque UNIQUE com coluna nula nao deduplica em Postgres: e a trava que
  /// impede duas linhas para a mesma exigencia. Nao e referencia estrutural por
  /// texto - e o mesmo padrao de `chaveIdempotencia` ja usado no motor.
  chaveExigencia String @unique @db.VarChar(140)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepKey])
  @@index([evidenciaTipoId])
  @@index([documentoTipoId])
}

/// OBSERVACAO operacional do documento - append-only, com autor e carimbo.
/// Substitui o texto mutavel que vivia em metadata: observacao anterior nunca some.
model DocumentoObservacao {
  id          Int       @id @default(autoincrement())
  documentoId Int
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  solicitacaoId  Int?
  stepInstanceId Int?

  texto String @db.Text

  criadoPorId Int?
  criadoPor   Usuario? @relation("DocumentoObservacaoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Idempotencia: o mesmo texto reenviado (duplo clique/retry) nao vira duas linhas.
  chaveIdempotencia String @unique @db.VarChar(200)

  @@index([documentoId, createdAt])
  @@index([stepInstanceId])
}

// ════════════════════════════════════════════════════════════════════════════
// REPOSITÓRIO OFICIAL DE MODELOS DOCUMENTAIS
//
// Um MODELO não é um documento — é um TEMPLATE. O documento é o RESULTADO da
// aplicação de uma versão publicada do modelo a um outorgante concreto. A relação
// nunca se inverte: Modelo → Versão publicada → Motor de geração → Documento
// Gerado → Cliente/Pessoa/Processo.
//
// O TEXTO JURÍDICO NÃO MORA AQUI. Não mora em coluna, não mora em código, não
// mora em componente. Ele mora exclusivamente dentro do DOCX versionado, no
// storage privado. O banco guarda IDENTIDADE, VERSÃO, CHECKSUM, ESTADO e AUTORIA
// — o que permite provar QUAL texto foi usado sem nunca duplicá-lo.
//
// POR QUE ESTENDE E NÃO ALTERA: nada aqui toca Documento, DocumentoArquivo,
// PhaseWorkflowInstance, materializador, ciclo ou obrigação. O módulo apenas
// FORNECE templates ao motor de geração e REFERENCIA (por id) o Cadastro Mestre
// de Documentos, que continua sendo a fonte única do que o documento É.
// ════════════════════════════════════════════════════════════════════════════

/// Categoria do modelo — dimensão FECHADA de domínio (mesma natureza de
/// TipoArquivoDocumento): não tem atributo administrável, só identidade. O que o
/// documento É continua sendo TipoDocumentoCadastro (Cadastro Mestre), por ID.
enum ModeloDocumentalCategoria {
  PROCURACAO
  CONTRATO
  DECLARACAO
  REQUERIMENTO
  FORMULARIO
  AUTORIZACAO
  NOTIFICACAO
  OUTRO
}

/// Ciclo de vida da VERSÃO. Só PUBLICADA gera documento oficial; publicada nunca
/// se edita — alteração jurídica cria versão nova e a anterior é preservada.
enum ModeloDocumentalVersaoStatus {
  RASCUNHO
  PUBLICADA
  REVOGADA
}

/// Estado do documento gerado (o agregado, não a versão).
enum DocumentoGeradoStatus {
  VIGENTE
  INVALIDADO
}

/// Estado de cada versão gerada. Uma nova geração nunca sobrescreve a anterior:
/// a anterior vira SUBSTITUIDA e o arquivo dela permanece acessível.
enum DocumentoGeradoVersaoStatus {
  GERADA
  VIGENTE
  SUBSTITUIDA
  INVALIDADA
}

/// MODELO DOCUMENTAL — a identidade do template no repositório oficial
/// (Gerenciamento › Sistema › Modelos). Procuração Judicial e Administrativa são
/// duas linhas desta tabela; contrato, declaração e requerimento serão outras.
/// Não existe cadastro paralelo por tipo de documento inteligente.
model ModeloDocumental {
  id        Int                       @id @default(autoincrement())
  codigo    String                    @unique @db.VarChar(40)
  nome      String                    @db.VarChar(200)
  descricao String?                   @db.Text
  categoria ModeloDocumentalCategoria

  /// O QUE o documento é, no Cadastro Mestre de Documentos. Sempre por ID —
  /// nunca por nome. Restrict: não se apaga do cadastro um tipo que é modelo.
  documentTypeId Int
  documentType   TipoDocumentoCadastro @relation("ModeloTipoDocumento", fields: [documentTypeId], references: [id], onDelete: Restrict)

  ativo Boolean @default(true)

  criadoPorId Int?
  criadoPor   Usuario? @relation("ModeloDocumentalAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versoes           ModeloDocumentalVersao[]
  documentosGerados DocumentoGerado[]

  @@index([documentTypeId])
  @@index([categoria])
  @@index([ativo])
}

/// VERSÃO do modelo — o DOCX oficial, imutável depois de publicado.
///
/// O arquivo vive em storage PRIVADO (chave, não URL pública): o template carrega
/// texto jurídico da banca e é servido apenas por rota autenticada com URL
/// assinada de curta duração.
model ModeloDocumentalVersao {
  id       Int              @id @default(autoincrement())
  modeloId Int
  modelo   ModeloDocumental @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  numero   Int

  /// Chave do objeto no storage privado. Nunca URL pública: o DOCX oficial só sai
  /// por rota autenticada.
  arquivoChave   String  @db.VarChar(400)
  arquivoNome    String  @db.VarChar(300)
  arquivoMime    String? @db.VarChar(120)
  arquivoTamanho Int?
  /// sha256:<hex> do DOCX. É o que prova que o binário publicado é o mesmo.
  checksum       String  @db.VarChar(80)

  status ModeloDocumentalVersaoStatus @default(RASCUNHO)

  /// Variáveis efetivamente encontradas no DOCX (todas conhecidas pelo registry).
  placeholders         Json
  /// Subconjunto exigido para gerar — sem elas a geração é bloqueada.
  obrigatorios         Json
  /// Variáveis que o modelo usa mas tolera ausentes (segmentos opcionais).
  opcionais            Json
  /// Literais de identificação (CPF/RG/CEP) declarados como DADO FIXO do outorgado.
  /// Publicação é bloqueada enquanto existir literal não declarado.
  dadosFixosDeclarados Json?

  observacao String? @db.Text

  criadoPorId Int?
  criadoPor   Usuario? @relation("ModeloVersaoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  publicadoEm    DateTime?
  publicadoPorId Int?
  publicadoPor   Usuario?  @relation("ModeloVersaoPublicador", fields: [publicadoPorId], references: [id], onDelete: SetNull)

  revogadoEm    DateTime?
  revogadoPorId Int?
  revogadoPor   Usuario?  @relation("ModeloVersaoRevogador", fields: [revogadoPorId], references: [id], onDelete: SetNull)

  vigenteDe  DateTime?
  vigenteAte DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  geracoes DocumentoGeradoVersao[]

  @@unique([modeloId, numero])
  @@index([modeloId, status])
  @@index([checksum])
}

/// DOCUMENTO GERADO — o agregado. Uma linha por (tipo documental × outorgante ×
/// processo): é ela que garante "uma versão vigente por pessoa + tipo + processo".
/// As gerações seguintes criam VERSÃO nova aqui dentro, nunca outro agregado.
model DocumentoGerado {
  id Int @id @default(autoincrement())

  modeloId Int
  modelo   ModeloDocumental @relation(fields: [modeloId], references: [id], onDelete: Restrict)

  /// Classificação mestre do resultado — o mesmo id do modelo no momento da
  /// geração, materializado aqui porque é o que as telas consultam.
  documentTypeId Int
  documentType   TipoDocumentoCadastro @relation("DocumentoGeradoTipo", fields: [documentTypeId], references: [id], onDelete: Restrict)

  // ── OUTORGANTE ────────────────────────────────────────────────────────────
  // O papel concreto no cadastro do cliente. Exatamente um dos dois — a trava
  // está no banco (CHECK), não na boa vontade da aplicação.
  contratanteId Int?
  contratante   Contratante? @relation(fields: [contratanteId], references: [id], onDelete: Restrict)
  requerenteId  Int?

  /// Identidade humana única (CP-1), quando o papel já está vinculado a ela.
  pessoaId Int?
  pessoa   Pessoa? @relation("DocumentoGeradoPessoa", fields: [pessoaId], references: [id], onDelete: SetNull)

  processoId Int?
  processo   Processo? @relation("DocumentoGeradoProcesso", fields: [processoId], references: [id], onDelete: SetNull)

  servicoId Int?
  servico   ServicoProduto? @relation("DocumentoGeradoServico", fields: [servicoId], references: [id], onDelete: SetNull)

  /// DOCUMENTO OPERACIONAL correspondente, quando o outorgante tem identidade
  /// (Pessoa) e o documento gerado passa a valer como peça da pasta documental.
  /// Nullable: sem Pessoa vinculada o documento gerado continua existindo e
  /// vinculado ao cliente — o que não existe é documento operacional órfão.
  documentoId Int?
  documento   Documento? @relation("DocumentoGeradoOperacional", fields: [documentoId], references: [id], onDelete: SetNull)

  status DocumentoGeradoStatus @default(VIGENTE)

  /// Identidade do agregado, derivada dos IDS (tipo + outorgante + processo).
  /// Existe porque UNIQUE com coluna nula não deduplica em Postgres — é a trava
  /// que impede dois agregados rivais para o mesmo par.
  chaveIdentidade String @unique @db.VarChar(200)

  criadoPorId Int?
  criadoPor   Usuario? @relation("DocumentoGeradoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versoes    DocumentoGeradoVersao[]
  requerente Requerente?             @relation(fields: [requerenteId], references: [id])

  @@index([contratanteId])
  @@index([requerenteId])
  @@index([pessoaId])
  @@index([processoId])
  @@index([documentTypeId])
  @@index([documentoId])
}

/// VERSÃO GERADA — o par DOCX+PDF de uma geração, com o snapshot dos dados que a
/// produziram. Os dois arquivos pertencem à MESMA versão: não existe PDF sem
/// DOCX, nem DOCX sem PDF, nem PDF vindo de outra origem que não este DOCX.
///
/// O snapshot é imutável: mudar o cadastro do cliente depois não altera versão
/// nenhuma já gerada — a versão nova é que usa o dado novo.
model DocumentoGeradoVersao {
  id                Int             @id @default(autoincrement())
  documentoGeradoId Int
  documentoGerado   DocumentoGerado @relation(fields: [documentoGeradoId], references: [id], onDelete: Cascade)
  numero            Int

  /// Versão do TEMPLATE usada. Restrict: versão de modelo que já gerou documento
  /// não some do repositório.
  modeloVersaoId Int
  modeloVersao   ModeloDocumentalVersao @relation(fields: [modeloVersaoId], references: [id], onDelete: Restrict)

  docxChave    String @db.VarChar(400)
  docxNome     String @db.VarChar(300)
  docxChecksum String @db.VarChar(80)
  docxTamanho  Int?

  pdfChave    String @db.VarChar(400)
  pdfNome     String @db.VarChar(300)
  pdfChecksum String @db.VarChar(80)
  pdfTamanho  Int?

  /// Dados de origem congelados — com os IDS de origem, não só os textos.
  dadosSnapshot Json

  status DocumentoGeradoVersaoStatus @default(GERADA)

  geradoEm    DateTime @default(now())
  geradoPorId Int?
  geradoPor   Usuario? @relation("DocumentoGeradoVersaoAutor", fields: [geradoPorId], references: [id], onDelete: SetNull)

  substituidaEm    DateTime?
  substituidaPorId Int?                   @unique
  substituidaPor   DocumentoGeradoVersao? @relation("VersaoGeradaSubstituicao", fields: [substituidaPorId], references: [id], onDelete: SetNull)
  substitui        DocumentoGeradoVersao? @relation("VersaoGeradaSubstituicao")

  invalidadaEm      DateTime?
  invalidadaPorId   Int?
  invalidadaPor     Usuario?  @relation("DocumentoGeradoVersaoInvalidador", fields: [invalidadaPorId], references: [id], onDelete: SetNull)
  motivoInvalidacao String?   @db.VarChar(300)

  /// Idempotência do ato: duplo clique e retry caem na MESMA versão.
  chaveIdempotencia String @unique @db.VarChar(200)

  @@unique([documentoGeradoId, numero])
  @@index([modeloVersaoId])
  @@index([status])
}

// ============================================================================
// PLANILHA DOCUMENTAL — CONFIGURAÇÃO DAS COLUNAS ECONÔMICAS.
//
// A Planilha é PROJEÇÃO: não guarda preço, não guarda serviço, não guarda
// documento. Esta tabela guarda a única coisa que é dela — QUAIS itens do
// cadastro canônico aparecem como coluna, em que ordem, e se estão ativos.
//
// O que NÃO está aqui, de propósito: valor, moeda, fornecedor, vigência. Preço
// vive só em TabelaValor, resolvido em tempo de leitura. Uma coluna que
// guardasse valor seria a segunda fonte da verdade que este desenho existe para
// impedir.
//
// A ANCORAGEM É POR ID, NUNCA POR NOME. A versão anterior casava
// `PhaseEconomicRule.componentName` com `TipoServico.nome` por igualdade de
// texto: renomear o serviço no cadastro fazia a coluna sumir da planilha sem
// nenhum erro.
// ============================================================================
/// UMA COLUNA DA PLANILHA É UMA ETAPA/SERVIÇO DOCUMENTAL — nunca um documento.
///
/// A planilha é uma MATRIZ: a LINHA é o registro civil (nascimento, casamento,
/// óbito) e a COLUNA é a etapa que incide sobre ele (certidão inteiro teor,
/// apostilamento, tradução). A célula é a interseção.
///
/// O modelo anterior amarrava `configId` a UM item do Cadastro Mestre, e isso
/// obrigava "Certidão de Nascimento - Inteiro Teor" e "Certidão de Casamento -
/// Inteiro Teor" a virarem DUAS COLUNAS — misturando as duas dimensões. São o
/// mesmo serviço sobre registros diferentes: uma coluna, três linhas.
///
/// Daí as duas estratégias de resolução, ambas por ID:
///
///   SERVICO_FIXO      a coluna aponta para UMA Configuração Financeira, igual
///                     em toda linha (tradução, apostilamento). `configId`.
///
///   ITEM_DO_REGISTRO  o item varia com a linha. A coluna aponta para a
///                     CATEGORIA do catálogo (`categoriaItemId`), e a célula
///                     resolve a Configuração Financeira do item que o tipo
///                     documental daquela linha já declara em
///                     `TipoDocumentoCadastro.itemCatalogoId`.
model PlanilhaDocumentalColuna {
  id Int @id @default(autoincrement())

  /// SERVICO (ProdutoFinanceiro) | DOCUMENTO (TipoDocumentoCadastro).
  origem String @db.VarChar(20)

  /// SERVICO_FIXO | ITEM_DO_REGISTRO — como a célula descobre o item canônico.
  estrategia String @default("SERVICO_FIXO") @db.VarChar(24)

  /// Categoria do catálogo que delimita os itens de uma coluna ITEM_DO_REGISTRO.
  /// É o que impede a coluna "Certidão Inteiro Teor" de resolver um item de
  /// tradução só porque o tipo documental da linha aponta para ele.
  categoriaItemId Int?
  categoriaItem   CategoriaServico? @relation(fields: [categoriaItemId], references: [id], onDelete: Restrict)

  /// Configuração Financeira do serviço — é ela que o resolvedor de preço recebe.
  /// `@unique` (parcial no Postgres, nulos não competem): um item, uma coluna.
  /// Só em SERVICO_FIXO; em ITEM_DO_REGISTRO é nulo e quem manda é a categoria.
  configId Int?               @unique
  config   ProdutoFinanceiro? @relation("ColunaPlanilhaConfig", fields: [configId], references: [id], onDelete: Cascade)

  /// Tipo documental do Cadastro Mestre, quando a coluna é um DOCUMENTO.
  tipoDocumentoId Int?                   @unique
  tipoDocumento   TipoDocumentoCadastro? @relation("ColunaPlanilhaTipoDoc", fields: [tipoDocumentoId], references: [id], onDelete: Cascade)

  /// Ordem de exibição. Chave de ordenação é POSIÇÃO, nunca nome.
  posicao Int @default(0)

  /// Inativar ESCONDE a coluna. Não apaga serviço, preço nem custo histórico —
  /// reativar traz tudo de volta.
  ativa Boolean @default(true)

  /// Nome curto só para a tela (ex.: "Apostilamento Certidão"). Não altera o
  /// cadastro mestre; ausente, a planilha usa o nome canônico.
  rotuloOverride String? @db.VarChar(60)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  overrides PlanilhaCelulaOverride[]

  @@index([ativa, posicao])
  @@index([estrategia])
}

/// VALOR DA CÉLULA COMBINADO PARA ESTE PROCESSO — e só para ele.
///
/// A Tabela de Preços continua sendo a fonte canônica do valor padrão. O
/// override não a corrige nem a substitui: ele diz "neste processo, nesta
/// pessoa, neste registro, nesta etapa, o combinado foi outro". Por isso a
/// identidade é a interseção inteira, por IDs — trocar qualquer um dos quatro
/// é outra célula.
///
/// O valor efetivo é `override ?? preço resolvido`. A origem nunca é
/// substituída em silêncio: a célula continua sabendo (e mostrando) o preço
/// base que deixou de valer.
model PlanilhaCelulaOverride {
  id Int @id @default(autoincrement())

  processoId Int
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  /// A pessoa da árvore. `onDelete: Cascade` — pessoa removida não deixa
  /// override órfão somando no total.
  pessoaId Int
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  /// O REGISTRO da linha (o tipo documental), não o documento concreto: o
  /// combinado vale para a certidão de nascimento daquela pessoa, tenha ela
  /// sido localizada ou não.
  tipoDocumentoId Int
  tipoDocumento   TipoDocumentoCadastro @relation("OverrideTipoDoc", fields: [tipoDocumentoId], references: [id], onDelete: Cascade)

  colunaId Int
  coluna   PlanilhaDocumentalColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)

  valor Decimal @db.Decimal(14, 2)
  moeda String  @default("BRL") @db.VarChar(3)

  /// Quem combinou e por quê — a auditoria completa vive em LogAuditoria.
  autorId Int?
  autor   Usuario? @relation("OverridePlanilhaAutor", fields: [autorId], references: [id], onDelete: SetNull)
  motivo  String?  @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([processoId, pessoaId, tipoDocumentoId, colunaId])
  @@index([processoId])
}

/// NOTIFICAÇÃO OPERACIONAL — marco da TAREFA, nunca da etapa.
///
/// O sino de hoje é derivado por consulta: ele olha `Tarefa.dataPrazo` e
/// classifica em vencidas/hoje/próximos. Isso funciona para prazo, e não
/// funciona para ATRIBUIÇÃO — "você recebeu esta tarefa" é um FATO que acontece
/// num instante e precisa sobreviver a ele. Derivar não dá: não há de onde
/// derivar "avisei" nem "ela já viu".
///
/// `chaveIdempotencia` é o que impede o retry de virar duas notificações — e
/// impede também a notificação de prazo de renascer todo dia para a mesma
/// tarefa, que é como um sino deixa de ser lido.
///
/// PROIBIDO notificar etapa. "Passo 3 concluído" é detalhe interno da mesma
/// tarefa; quem recebe isso sete vezes por certidão para de olhar o sino.
model NotificacaoOperacional {
  id Int @id @default(autoincrement())

  /// ATRIBUICAO | TRANSFERENCIA | PRAZO | ATRASO | BLOQUEIO
  tipo String @db.VarChar(24)

  destinatarioId Int
  destinatario   Usuario @relation("NotificacaoDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)

  /// A tarefa a que o marco pertence. `Cascade`: tarefa apagada não deixa aviso
  /// apontando para o vazio.
  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  titulo   String  @db.VarChar(200)
  mensagem String? @db.Text
  link     String? @db.VarChar(300)

  /// Quem provocou o marco (quem atribuiu, quem transferiu). Nulo quando o
  /// marco é do relógio (prazo, atraso).
  autorId Int?

  chaveIdempotencia String @unique @db.VarChar(220)

  lidaEm   DateTime?
  criadoEm DateTime  @default(now())

  @@index([destinatarioId, lidaEm])
  @@index([tarefaId])
}

/// DEPENDÊNCIA ENTRE TAREFAS — duas obrigações distintas, uma esperando a outra.
///
/// Isto NÃO é etapa. "Traduzir a certidão" depende de "obter a certidão", e são
/// dois trabalhos: têm responsáveis diferentes, prazos diferentes, podem estar
/// em equipes diferentes. Modelar a segunda como passo da primeira faria a
/// tradução herdar o dono da emissão e sumir da fila de quem traduz.
///
/// A dependência é entre IDs canônicos e não carrega regra: quem interpreta
/// "posso executar?" é o motor, lendo se as pré-requisitos estão concluídas.
model TarefaDependencia {
  id Int @id @default(autoincrement())

  /// A tarefa que ESPERA.
  tarefaId Int
  tarefa   Tarefa @relation("TarefaDependente", fields: [tarefaId], references: [id], onDelete: Cascade)

  /// A tarefa que precisa terminar antes.
  dependeDeId Int
  dependeDe   Tarefa @relation("TarefaPreRequisito", fields: [dependeDeId], references: [id], onDelete: Cascade)

  /// Dependência informativa não impede execução; obrigatória impede.
  obrigatoria Boolean  @default(true)
  motivo      String?  @db.VarChar(200)
  criadoEm    DateTime @default(now())

  /// Um par só existe uma vez — reconciliar N vezes não empilha dependências.
  @@unique([tarefaId, dependeDeId])
  @@index([dependeDeId])
}

// ═══════════════════════════════════════════════════════════════════════════
// A CAMADA OPERACIONAL DO FUNCIONÁRIO — três coisas distintas, três tabelas.
//
// AUTORIZAÇÃO continua em Perfil/permissoesCustom, e nada aqui a substitui:
// ninguém fica elegível por ser apto, por estar disponível ou por ter capacidade
// sobrando. O sentido é o inverso — estas estruturas só RESTRINGEM quem já tem
// permissão.
//
// ORGANIZAÇÃO (equipe) já existe e não foi recriada: `GrupoUsuario` +
// `GrupoUsuarioMembro`, com cadastro próprio em Gerenciamento › Usuários e
// Acessos › Equipes.
// ═══════════════════════════════════════════════════════════════════════════

/**
 * APTIDÃO — "esta pessoa executa este TIPO DE TRABALHO".
 * A dimensão é o PERFIL OPERACIONAL (`PerfilOperacionalDocumento`), que o
 * Cadastro Mestre já define como "qual workflow processa este documento": um
 * perfil serve N tipos documentais — "Emissão de Certidão" atende nascimento,
 * casamento e óbito, porque o processo operacional é o mesmo.
 * ─── POR QUE NÃO A FASE MACRO ───────────────────────────────────────────────
 * Era assim que esta tabela nascia, e estava errado. A fase diz ONDE O PROCESSO
 * ESTÁ; a aptidão diz QUE TRABALHO A PESSOA SABE FAZER. Colapsar os dois produz
 * absurdos que o cadastro expôs no primeiro uso: "apto para Finalizado",
 * "apto para Aguardando protocolo" — posições do processo, não competências.
 * ─── POR QUE NÃO O PASSO ────────────────────────────────────────────────────
 * Solicitar, aguardar, receber, conferir e validar são passos da MESMA unidade
 * de trabalho. Exigir cinco aptidões para uma certidão seria cadastrar a
 * execução, não a competência. A granularidade é a unidade; se algum dia o
 * domínio exigir especialização por passo, isso será outra decisão, explícita.
 * ─── POR QUE NÃO UM CATÁLOGO NOVO ───────────────────────────────────────────
 * Criar `Competencia { nome }` seria uma segunda fonte mestre para o que o
 * Perfil Operacional já é — e as duas divergiriam no primeiro cadastro feito
 * pelo lado errado.
 */
model AptidaoOperacional {
  id                  Int                        @id @default(autoincrement())
  usuarioId           Int
  /// A UNIDADE DE TRABALHO que esta pessoa executa.
  perfilOperacionalId Int
  criadoEm            DateTime                   @default(now())
  usuario             Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfilOperacional   PerfilOperacionalDocumento @relation(fields: [perfilOperacionalId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, perfilOperacionalId])
  @@index([perfilOperacionalId])
}

enum TipoIndisponibilidade {
  FERIAS
  AFASTAMENTO
  AUSENCIA
  BLOQUEIO_OPERACIONAL
}

/**
 * INDISPONIBILIDADE — período em que a pessoa não deve receber trabalho novo.
 * Não é RH: não há saldo de férias, não há aprovação, não há folha. É só o que a
 * distribuição precisa saber. `fim` nulo significa indisponibilidade em aberto,
 * que existe de verdade (afastamento sem data de retorno) e não pode ser
 * modelada como uma data inventada.
 * O registro é HISTÓRICO: encerrar uma indisponibilidade é preencher `fim`, não
 * apagar a linha — senão a pergunta "por que ninguém foi recomendado na terça"
 * fica sem resposta.
 */
model IndisponibilidadeOperacional {
  id          Int                   @id @default(autoincrement())
  usuarioId   Int
  tipo        TipoIndisponibilidade
  inicio      DateTime
  fim         DateTime?
  motivo      String?               @db.VarChar(300)
  criadoEm    DateTime              @default(now())
  criadoPorId Int?
  usuario     Usuario               @relation("IndisponibilidadeDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoPor   Usuario?              @relation("IndisponibilidadeAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([usuarioId, inicio])
  @@index([fim])
}

/**
 * CAPACIDADE — teto configurável de trabalho EXECUTÁVEL simultâneo.
 * Nulo é o estado normal e significa "sem teto declarado": aí a recomendação
 * segue relativa, comparando a carga real de cada um. Um número no código
 * ("máximo 10 tarefas") seria política de negócio que ninguém decidiu.
 * O teto conta EXECUTÁVEIS, não tarefas: dez tarefas com oito esperando cartório
 * não ocupam dez lugares. É a mesma distinção que o recomendador já fazia.
 */
model CapacidadeOperacional {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @unique
  /**
   * Nulo = sem teto declarado.
   */
  limiteExecutaveis Int?
  observacao        String?  @db.VarChar(300)
  atualizadoEm      DateTime @updatedAt
  atualizadoPorId   Int?
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  atualizadoPor     Usuario? @relation("CapacidadeAutor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
}
