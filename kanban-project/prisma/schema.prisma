  itemCatalogoId  Int?
  itemCatalogo    ItemCatalogo?              @relation("CatFinItemCatalogo", fields: [itemCatalogoId], references: [id])

  // anti-duplicaÃ§Ã£o: 1 categoria por (mestre Ã tipo). NULL Ã© distinto no Postgres,
  // logo sÃ³ restringe quando a FK estÃ¡ preenchida (legado sem FK nÃ£o Ã© afetado).
  @@unique([tipoDocumentoId, tipo])
  @@unique([honorarioId, tipo])
  @@unique([tipoProcessoId, tipo])
  @@unique([itemCatalogoId, tipo])
  @@index([tipo])
  @@index([categoriaPaiId])
  @@index([origem])
  @@index([tipoDocumentoId])
  @@index([honorarioId])
  @@index([tipoProcessoId])
  @@index([itemCatalogoId])
}

