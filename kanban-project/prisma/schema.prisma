  @@index([obrigacaoId, sequenciaAplicada])
}

// ============================================================================
// CADASTROS DO GERENCIAMENTO (reestruturação 26/07/2026)
// 100% ADITIVO: tabelas novas, nenhuma coluna alterada, nenhum dado tocado.
// Cadastros puros — não participam do runtime do motor; alimentam as telas
// oficiais do Gerenciamento que antes não tinham backend.
// ============================================================================

// NOTA: o cadastro "Marcos do processo" (MarcoProcesso) foi ELIMINADO em 02/08/2026.
// Eventos importantes do processo têm UMA ÚNICA fonte de registro cronológico: a
// Timeline/Histórico do Processo (Diário Operacional), que agrega `WorkflowEvento`,
// `Evento` e `LogAuditoria`. Não existe cadastro paralelo de pontos de controle.

/// MODALIDADE LEGAL — a base jurídica sob a qual a nacionalidade é requerida
/// (ex.: Lei da Memória Democrática). NÃO se confunde com a VIA DE TRAMITAÇÃO
/// (administrativa/consular/judicial), que é outra dimensão, nem com o tipo de
/// processo, que é país + produto.
model ModalidadeLegal {
  id           Int          @id @default(autoincrement())
  /// Identidade IMUTÁVEL. Vínculo é sempre por id — o code só identifica o registro.
  code         String       @unique @db.VarChar(60)
  nome         String       @db.VarChar(200)
  descricao    String?      @db.Text
  paisId       Int
  pais         CatalogoPais @relation(fields: [paisId], references: [id], onDelete: Restrict)
  ordem        Int          @default(0)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  enquadramentos EnquadramentoLegal[]

  @@index([paisId])
}

/// ENQUADRAMENTO LEGAL — o recorte oficial dentro de uma modalidade legal
/// (ex.: Anexo I e Anexo III da LMD). É o que determina conjunto documental e
/// exigências próprias. Condições de elegibilidade pertencem ao enquadramento;
/// não viram cadastro paralelo nem modalidade.
model EnquadramentoLegal {
  id                Int             @id @default(autoincrement())
  code              String          @unique @db.VarChar(60)
  nome              String          @db.VarChar(200)
  descricao         String?         @db.Text
  modalidadeLegalId Int
  modalidadeLegal   ModalidadeLegal @relation(fields: [modalidadeLegalId], references: [id], onDelete: Restrict)
  ordem             Int             @default(0)
  ativo             Boolean         @default(true)
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  processos Processo[]

  @@index([modalidadeLegalId])
}

/// Categorias que organizam o Catálogo de Serviços (não guardam preço).
model CategoriaServico {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(60)
  nome         String   @db.VarChar(200)
  descricao    String?  @db.Text
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Fonte ÚNICA de categoria do catálogo. O vínculo vive no mestre
  // (ItemCatalogo) — serviço e item técnico compartilham o mesmo portador.
  itens ItemCatalogo[]
}

/// Categorias das organizações (cartório, consulado, tribunal, banco, tradutor…).
/// Uma organização pode ter VÁRIAS categorias — daí a tabela de vínculo.
model CategoriaOrganizacao {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique @db.VarChar(60)
  nome         String                 @db.VarChar(200)
  descricao    String?                @db.Text
  ordem        Int                    @default(0)
  ativo        Boolean                @default(true)
  criadoEm     DateTime               @default(now())
  atualizadoEm DateTime               @updatedAt
  organizacoes OrganizacaoCategoria[]
}

model OrganizacaoCategoria {
