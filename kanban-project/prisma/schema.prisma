  // MDM â a Categoria Financeira REFERENCIA um cadastro mestre por FK real; nunca
  // redigita/duplica a entidade. Exatamente UM destes Ã© preenchido (CHECK na migration).
  // `nome` passa a ser DERIVADO do mestre (system-owned na criaÃ§Ã£o); linhas legadas
  // sem FK permanecem vÃ¡lidas (nullable) atÃ© o backfill.
  origem          OrigemCategoria            @default(LEGADO)
  tipoDocumentoId Int?
  tipoDocumento   TipoDocumentoCadastro?     @relation("CatFinTipoDocumento", fields: [tipoDocumentoId], references: [id])
  honorarioId     Int?
  honorario       Honorario?                 @relation("CatFinHonorario", fields: [honorarioId], references: [id])
