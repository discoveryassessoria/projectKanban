// Matriz Documental (documentRequirementMatrix) â quais documentos sÃ£o
// exigidos por processo, fase, alvo e regra de geraÃ§Ã£o. Por processo.
model MatrizDocumental {
  id                    Int                        @id @default(autoincrement())
  tipoProcessoId        Int // â TipoProcessoNacionalidade (solto)
  phaseKey              String?                    @db.VarChar(60) // null = qualquer fase (LEGADO; ver faseExigencia)
  /// LEGADO EM TRANSIÇÃO: code em texto, "solto" por definição. Espelho de
  /// `documentoTipoId`.
  documentTypeCode      String                     @db.VarChar(40)
  /// IDENTIDADE CANÔNICA do tipo documental exigido pela regra.
  documentoTipoId       Int?
  documentoTipo         TipoDocumentoCadastro?     @relation("MatrizTipoCanonico", fields: [documentoTipoId], references: [id], onDelete: Restrict)
  /// IDENTIDADE CANÔNICA do tipo de processo. `tipoProcessoId` era Int solto,
  /// sem FK — nada impedia apontar para um tipo inexistente.
  tipoProcessoRefId     Int?
  tipoProcessoRef       TipoProcessoNacionalidade? @relation("MatrizTipoProcessoCanonico", fields: [tipoProcessoRefId], references: [id], onDelete: Restrict) // â TipoDocumentoCadastro.code (solto)
  target                String                     @default("direct_line_person") @db.VarChar(40)
  generationRule        String                     @default("all_direct_line") @db.VarChar(40)
  required              Boolean                    @default(true)
  conditional           Boolean                    @default(false)
  condition             String?                    @db.Text
  createsTask           Boolean                    @default(true)
  createsCost           Boolean                    @default(false)
  createsRevenue        Boolean                    @default(false)
  blocksPhaseCompletion Boolean                    @default(false)
  usedByCount           Int                        @default(0)
  arquivado             Boolean                    @default(false)
  // CP-3 â versÃ£o da regra (snapshot imutÃ¡vel por versÃ£o; mudanÃ§a futura
  // incrementa a versÃ£o e NÃO reescreve necessidades jÃ¡ produzidas).
  versao                Int                        @default(1)
  criadoEm              DateTime                   @default(now())
  atualizadoEm          DateTime                   @updatedAt

  // ============================================================
  // REGRAS DOCUMENTAIS (estrutura canÃ´nica ampliada) â base dos workflows
  // futuros. Campos ADITIVOS; os campos legados acima permanecem para leitura
  // (dual-read) atÃ© a migraÃ§Ã£o completa da tela. Nada aqui executa runtime.
  // ============================================================
  // IDENTIFICAÃÃO
  codigo                               String?                 @db.VarChar(60) // cÃ³digo estÃ¡vel (compartilhado entre versÃµes)
  nome                                 String?                 @db.VarChar(200)
  descricao                            String?                 @db.Text
  status                               RegraDocumentalStatus   @default(RASCUNHO)
  prioridade                           Int                     @default(0)
  vigenciaInicio                       DateTime?
  vigenciaFim                          DateTime?
  // APLICABILIDADE â mÃºltiplos tipos de processo (ou todos). tipoProcessoId legado
  // permanece como "primÃ¡rio" (1Âº item) para dual-read. modalidade/paÃ­s/regiÃ£o
  // saÃ­ram do ESCOPO (viram condiÃ§Ã£o da regra quando necessÃ¡rio).
  aplicaTodosProcessos                 Boolean                 @default(false)
  tipoProcessoIds                      Json? // [Int] â coleÃ§Ã£o; legado: [tipoProcessoId]
  modalidadeId                         Int? // LEGADO (nÃ£o usado no escopo; modalidade vira condiÃ§Ã£o)
  paisCode                             String?                 @db.VarChar(8) // LEGADO
  regiaoCode                           String?                 @db.VarChar(16) // LEGADO
  tipoProcessoVersao                   Int?
  // REQUISITO + DOCUMENTOS ACEITOS (o requisito pode ser atendido por 1+ documentos)
  requisitoNome                        String?                 @db.VarChar(200)
  documentosAceitos                    Json? // [String] cÃ³digos de TipoDocumento; legado: [documentTypeCode]
  modoSatisfacao                       ModoSatisfacaoRequisito @default(QUALQUER_UM_ATENDE)
  // categoriaCode Ã© LEGADO: a categoria Ã© derivada do Tipo de Documento, nunca
  // redefinida pela regra (a tela nÃ£o grava mais este campo).
  categoriaCode                        String?                 @db.VarChar(40)
  obrigatoriedade                      ObrigatoriedadeRegra    @default(OBRIGATORIA)
  // PÃBLICO-ALVO â mÃºltiplo. publicoAlvo (singular) permanece como primÃ¡rio (dual-read).
  publicoAlvo                          PublicoAlvoRegra        @default(PESSOA_DA_LINHA_RETA)
  publicosAlvo                         Json? // [PublicoAlvoRegra] â coleÃ§Ã£o
  // CONDIÃÃES estruturadas: { combinador: TODAS|QUALQUER, regras: [{campo,operador,valor}] }
  condicoes                            Json?
  // FASE E BLOQUEIO
  faseExigencia                        String?                 @db.VarChar(60) // fase em que passa a ser exigido
  faseBloqueio                         String?                 @db.VarChar(60) // fase que bloqueia
  continuaObrigatorioNasFasesSeguintes Boolean                 @default(false)
  faseFinalExigencia                   String?                 @db.VarChar(60)
  obrigatorioAteFinalProcesso          Boolean                 @default(false)
  // VALIDADE
  possuiValidade                       Boolean                 @default(false)
  validadeDias                         Int?
  exigeDataEmissao                     Boolean                 @default(false)
  renovarQuandoExpirado                Boolean                 @default(false)
  antecedenciaRenovacaoDias            Int?
  // AUDITORIA de versÃ£o
  criadoPor                            Int?
  atualizadoPor                        Int?
  publicadoEm                          DateTime?
  publicadoPor                         Int?

  @@unique([codigo, versao])
  @@index([tipoProcessoId])
  @@index([phaseKey])
  @@index([status])
  @@index([codigo])
  @@index([publicoAlvo])
}

