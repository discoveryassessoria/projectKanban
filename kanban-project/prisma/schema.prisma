// ÃrgÃ£os de Protocolo (op_organs) â consulados, comunes, tribunais, cartÃ³rios...
model OrgaoProtocolo {
  /// ORG1, ORG2… — código público gerado pelo CodeGeneratorService (imutável).
  publicCode   String?  @unique @db.VarChar(20)
  id           Int      @id @default(autoincrement())
  /// NOME OFICIAL — na língua e na grafia oficiais da entidade.
  name         String   @db.VarChar(200)
  /// Nome fantasia/usual (sigla ou como o operador chama no dia a dia).
  nomeFantasia String?  @db.VarChar(200)
  type         String?  @db.VarChar(30) // consulado|comune|tribunal|conservatoria|cartorio|ministerio|prefeitura|tradutor|apostilamento|outro
  country      String?  @db.VarChar(60)
  /// Região / estado / província de 1º nível (ex.: Veneto, SP, Cataluña).
  state        String?  @db.VarChar(60)
  /// Província / distrito de 2º nível (ex.: Vicenza, Barletta-Andria-Trani).
  provincia    String?  @db.VarChar(80)
  city         String?  @db.VarChar(100)
  endereco     String?  @db.VarChar(300)
  cep          String?  @db.VarChar(20)
  site         String?  @db.VarChar(300)
  email        String?  @db.VarChar(200)
  telefone     String?  @db.VarChar(60)
  /// Idioma de atendimento (ISO 639-1: pt, es, it, en, fr, de…).
  idioma       String?  @db.VarChar(10)
  /// Moeda praticada pela entidade (ISO 4217: BRL, EUR, USD…).
  ///
  /// FICHA CADASTRAL, ao lado de `idioma` e `horario`: "este cartorio cobra em euro"
  /// como "atende em italiano". NAO e fonte financeira e nao deve virar FK para
  /// `MoedaCadastro` — auditado em 25/08/2026, sem nenhum leitor no sistema. O preco
  /// vem da Tabela de Precos e o custo de `Fornecedor.moedaPadrao`; o motor financeiro
  /// nunca pergunta a moeda ao orgao. Apontar para o cadastro limitaria a ficha aos
  /// codigos do financeiro e perderia ARS e PYG, que 6 organizacoes usam.
  moeda        String?  @db.VarChar(10)
  horario      String?  @db.VarChar(200)
  /// Responsável/contato na entidade (texto — não é usuário do sistema).
  responsavel  String?  @db.VarChar(200)
  observacoes  String?  @db.Text
  /// Etiquetas livres de operação (ex.: "apostila", "cidadania", "urgente").
  tags         String[] @default([])
  queueRule    String?  @db.VarChar(200) // regra de fila

  // ── FUNÇÕES ────────────────────────────────────────────────────────────────
  // A MESMA organização exerce várias funções ao mesmo tempo — e continua sendo
  // UM ÚNICO registro. Cartório que cobra emolumento é ORGAO + FORNECEDOR; a DHL
  // é FORNECEDOR; um escritório parceiro é PARCEIRO + FORNECEDOR. Classificar
  // NUNCA é criar cadastro novo.
  funcoes FuncaoOrganizacao[] @default([])

  // ── IDENTIDADE FISCAL (chave forte de deduplicação) ────────────────────────
  /// CNPJ, CPF, VAT, NIF, CIF, Partita IVA… Só o número, sem máscara.
  identificacaoFiscal     String? @unique @db.VarChar(40)
  /// Que documento é o acima (CNPJ|CPF|VAT|NIF|CIF|PIVA|EIN|OUTRO).
  tipoIdentificacaoFiscal String? @db.VarChar(20)

  // ── DADOS FINANCEIROS (só fazem sentido quando a organização é FORNECEDOR) ──
  formaPagamento         String? @db.VarChar(60)
  chavePix               String? @db.VarChar(140)
  tipoChavePix           String? @db.VarChar(20)
  banco                  String? @db.VarChar(120)
  agencia                String? @db.VarChar(20)
  conta                  String? @db.VarChar(30)
  tipoConta              String? @db.VarChar(20)
  /// Prazo de pagamento acordado, em dias.
  prazoPagamentoDias     Int?
  contatoFinanceiro      String? @db.VarChar(200)
  observacoesFinanceiras String? @db.Text
  /// REGULAR | PENDENTE | BLOQUEADO — situação do fornecedor no financeiro.
  statusFinanceiro       String? @db.VarChar(20)

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // categorias (N:N) — uma organização pode ser cartório E tradutor, por exemplo
  categorias OrganizacaoCategoria[]

  // protocolizações recebidas por este órgão (ocorrências dentro dos processos)
  protocolos            Protocolo[]
  solicitacaoDocumentos SolicitacaoDocumento[]
  /// Por onde ESTA organização atende. Ver `OrganizacaoCanal`.
  canais                OrganizacaoCanal[]
  execucoesDeSubtarefa  SubtaskExecution[]
  /// Documentos que ESTA organização emite. Ver `Documento.orgaoId`.
  documentosEmitidos    Documento[]            @relation("DocumentoOrgaoEmissor")
  retificacoes          RetificacaoPacote[]    @relation("OrgaoDaRetificacao")
  profissionais         Profissional[]         @relation("ProfissionaisDaOrganizacao")
  registrosDeClasse     RegistroProfissional[] @relation("RegistrosDoOrgaoDeClasse")

  /// Anti-duplicidade do cadastro mestre: mesma entidade não entra duas vezes.
  @@unique([name, country])
  @@index([type])
  @@index([country])
  @@index([ativo])
  @@index([provincia])
  @@index([funcoes])
}

/// Funções que uma organização exerce. Uma organização = UM registro, N funções.
enum FuncaoOrganizacao {
  ORGAO
  FORNECEDOR
  PARCEIRO
  CORRESPONDENTE
  CLIENTE_CORPORATIVO
}

// Tipos de Documento (op_doctypes) â tipos documentais usados nos processos
model TipoDocumentoCadastro {
  publicCode              String?                   @unique @db.VarChar(20) // DOC1, DOC2… — código público do TIPO (não é o DOC-n do documento concreto)
  id                      Int                       @id @default(autoincrement())
