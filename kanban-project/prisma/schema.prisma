// ============================================================================
// COBRANÃA â COMO uma Receita serÃ¡ cobrada (separada da Receita e do Pagamento).
// A Receita Ã© sÃ³ o contrato (o que o motor gerou). A CobranÃ§a define forma/condiÃ§Ã£o/
// parcelamento/conta/carteira/gateway/encargos, consumindo EXCLUSIVAMENTE os cadastros
// de Gerenciamento por ID (nunca duplica config). Uma Receita pode ter 1..N CobranÃ§as.
// As Parcelas pertencem Ã  CobranÃ§a; os Pagamentos (EventoFinanceiro) vinculam Ã  CobranÃ§a,
// nunca Ã  Receita. Aditivo: legado (parcelas direto na Receita) permanece intacto.
// ============================================================================
model Cobranca {
  id                  Int       @id @default(autoincrement())
  receitaId           Int
  receita             Receita   @relation("ReceitaCobrancas", fields: [receitaId], references: [id], onDelete: Cascade)
  processoId          Int // snapshot p/ consulta rÃ¡pida
  // IDs do Gerenciamento â Financeiro (FONTE ÃNICA â sÃ³ referÃªncia, nunca cÃ³pia):
  formaPagamentoId    Int? // â FormaPagamentoCadastro
  condicaoPagamentoId Int? // â CondicaoPagamento
  contaBancariaId     Int? // â ContaBancaria
  carteiraId          Int? // â CarteiraRecebimento
  taxaPagamentoId     Int? // â TaxaPagamento
  gateway             String?   @db.VarChar(40)
  moeda               Moeda     @default(EUR)
  valorTotal          Decimal   @db.Decimal(12, 2)
  status              String    @default("ABERTA") @db.VarChar(20) // ABERTA | PARCIAL | QUITADA | CANCELADA | RENEGOCIADA
  // congelamento auditÃ¡vel da condiÃ§Ã£o no momento da criaÃ§Ã£o
  condicaoVersao      Int?
  condicaoCodigo      String?   @db.VarChar(60)
