  ordem           Int           @default(0)
  required        Boolean       @default(true)
  conditional     Boolean       @default(false)
  entryRule       String        @default("previous_phase_completed") @db.VarChar(40)
  exitRule        String?       @db.VarChar(120)
  slaDays         Int           @default(30)
  showInKanban    Boolean       @default(true)
  versao          Int           @default(1) // CP-4A â versionamento
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@unique([macroWorkflowId, phaseKey])
  @@index([macroWorkflowId])
}

model PhaseInternalWorkflow {
  id             Int      @id @default(autoincrement())
  // {tipoProcessoId|'all'}::{phaseKey} para o workflow PRIMÃRIO de uma fase.
  // (Ã¢ncora de unicidade â 1 workflow por processo+fase; null = global/todos)
  wfUid          String   @unique @db.VarChar(140)
  templateId     Int? // â ModeloWorkflowInterno (solto; null = ad-hoc/seed)
  tipoProcessoId Int? // â TipoProcessoNacionalidade (solto; null = TODOS os processos)
  phaseKey       String   @db.VarChar(60)
  name           String   @db.VarChar(200)
  // MODO DE EXECUCAO dos passos publicados (persistido; nunca inferido no codigo):
  //   SEQUENCIAL = so o primeiro passo nasce DISPONIVEL; concluir um libera o seguinte.
  //   PARALELO   = todos os passos nascem DISPONIVEL.
  execucao       String   @default("SEQUENCIAL") @db.VarChar(20)
  active         Boolean  @default(true)
  arquivado      Boolean  @default(false)
  versao         Int      @default(1) // CP-4A â versionamento (definiÃ§Ã£o/template)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  passos  PhaseInternalWorkflowStep[]
  /// Versões congeladas desta definição (ver PhaseInternalWorkflowVersao).
  versoes PhaseInternalWorkflowVersao[]

  // ── CONTRATO DE EXECUÇÃO ───────────────────────────────────────────────────
  // O workflow declara SOBRE O QUE executa. Antes só se sabia a fase, e o escopo
  // vinha do catálogo em código — o cadastro não tinha como recusar um workflow
  // documental materializado sem documento.
  /// Natureza da execução: sobre processo, pessoa, necessidade ou documento.
  escopoExecucao           EscopoExecucao?
  /// Perfis que apontam para este workflow (back-relation).
  perfis                   PerfilOperacionalDocumento[] @relation("PerfilWorkflow")
  /// Família documental aceita (null = não é workflow documental, ou aceita qualquer).
  familiaDocumentalId      Int?
  familiaDocumental        FamiliaDocumental?           @relation(fields: [familiaDocumentalId], references: [id], onDelete: SetNull)
  /// Contrato de materialização: sem estes, a instância documental não nasce.
  exigeDocumento           Boolean                      @default(false)
  exigePessoa              Boolean                      @default(false)
  /// POLÍTICA DE SLA NA ESPERA EXTERNA — decisão do workflow, não do código.
  /// `true`: o relógio para enquanto a tarefa aguarda terceiro (cartório que
  /// demora 40 dias não deve consumir um SLA de 5). `false`: o prazo corre
  /// mesmo assim (espera por resposta do cliente costuma contar).
  pausarSlaEmEsperaExterna Boolean                      @default(false)
  /// Mesma pergunta para bloqueio — e a resposta não é necessariamente a mesma.
  pausarSlaEmBloqueio      Boolean                      @default(false)

  /// ALTERADO DESDE A ÚLTIMA PUBLICAÇÃO?
  ///
  /// A definição viva SEMPRE foi o rascunho e a versão congelada SEMPRE foi o
  /// publicado — o modelo já dizia isso, mas salvar publicava junto, e não havia
  /// como olhar o que mudaria antes de decidir. Estas duas colunas separam "guardei"
  /// de "publiquei", sem inventar uma segunda árvore de definição.
  rascunhoAlteradoEm  DateTime?
  rascunhoAlteradoPor Int?

  @@index([phaseKey])
  @@index([tipoProcessoId])
  @@index([familiaDocumentalId])
}

/// VERSÃO PUBLICADA DE UM WORKFLOW INTERNO — imutável, e a razão de existir.
///
/// `PhaseInternalWorkflow` é a definição EDITÁVEL: ela é o que o administrador vê e
/// muda. As instâncias em execução já registravam `workflowDefinitionId` +
/// `workflowVersion`, mas `versao` nunca era incrementada e a edição apagava e
/// recriava os passos — o par (definição, versão) apontava para um conteúdo que
/// mudava por baixo. Uma execução iniciada semana passada passava a ser lida pela
/// configuração de hoje, sem que nada no dado registrasse a diferença.
///
/// Esta tabela CONGELA o conteúdo de cada versão no momento em que ela passa a
/// valer. A identidade é o par que a instância já guarda — `(workflowId, versao)` —,
/// e é por isso que nenhuma coluna nova foi criada na instância: o vínculo já
/// existia; o que faltava era ter o que ele aponta.
///
/// IMUTÁVEL POR CONTRATO: nada no runtime atualiza uma linha destas. Editar o
/// workflow congela a versão vigente (se ainda não estiver) e cria a próxima.
model PhaseInternalWorkflowVersao {
  id         Int                   @id @default(autoincrement())
  workflowId Int
  workflow   PhaseInternalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versao     Int

  // ── O CONTEÚDO CONGELADO ────────────────────────────────────────────────
  // Cópia fiel do que a definição dizia quando esta versão passou a valer. Os
  // campos escalares ficam em colunas (consultáveis) e os passos em JSON: eles são
  // lidos como um conjunto, sempre inteiro, e nunca por linha.
  phaseKey                 String          @db.VarChar(60)
  tipoProcessoId           Int?
  name                     String          @db.VarChar(200)
  execucao                 String          @db.VarChar(20)
  escopoExecucao           EscopoExecucao?
  familiaDocumentalId      Int?
  exigeDocumento           Boolean         @default(false)
  exigePessoa              Boolean         @default(false)
  pausarSlaEmEsperaExterna Boolean         @default(false)
  pausarSlaEmBloqueio      Boolean         @default(false)
  /// Passos como estavam: key, label, ordem, obrigatório, gera tarefa, responsável
  /// padrão, prioridade, SLA, cardinalidade, condição de conclusão e checklist.
  passos                   Json

  congeladoEm    DateTime @default(now())
  congeladoPorId Int?
  /// Por que esta versão nasceu: PUBLICACAO (edição), CRIACAO, BACKFILL.
  origem         String   @db.VarChar(20)

  @@unique([workflowId, versao])
  @@index([workflowId])
}

model PhaseInternalWorkflowStep {
  id             Int                   @id @default(autoincrement())
  workflowId     Int
  workflow       PhaseInternalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  key            String                @db.VarChar(80) // slug (Ãºnico dentro do workflow â controlado na UI)
  label          String                @db.VarChar(200)
  description    String?               @db.Text
  ordem          Int                   @default(0)
  createsTask    Boolean               @default(true) // "Gera tarefa"
  required       Boolean               @default(true) // "ObrigatÃ³rio"
  owner          String?               @db.VarChar(120) // "ResponsÃ¡vel padrÃ£o"
  priority       String                @default("medium") @db.VarChar(20) // low | medium | high
  slaDays        Int                   @default(0)
  // CARDINALIDADE OPERACIONAL do passo: quantas instancias ele gera e presa a QUAL
  // entidade. NAO confundir com "global (compartilhado)", que e o compartilhamento do
  // WORKFLOW entre tipos de processo (PhaseInternalWorkflow.tipoProcessoId = null).
  //   PROCESSO    = 1 instancia por fase/ciclo
  //   PESSOA      = 1 por pessoa aplicavel da arvore
  //   NECESSIDADE = 1 por registro/certidao a localizar
  //   DOCUMENTO   = 1 por documento materializado
  // NULL = herda o escopo operacional canonico da FASE (fases-catalog).
  cardinalidade  String?               @db.VarChar(20)
  completionRule String?               @db.Text // "CondiÃ§Ã£o de conclusÃ£o"
  checklist      Json?
  versao         Int                   @default(1) // CP-4A â versionamento (definiÃ§Ã£o/template)

  // TRAVA: cada chave sÃ³ existe UMA vez por workflow (impede duplicaÃ§Ã£o silenciosa)

  /// DEPENDÊNCIA DECLARADA — lista de `key` de passos do MESMO workflow.
  ///
  /// Antes a dependência era DERIVADA da ordem: modo SEQUENCIAL fazia cada passo
  /// depender do anterior da lista, e reabrir um passo invalidava tudo com
  /// `ordem >= N`. Duas coisas diferentes — "vem depois" e "depende de" — eram a
  /// mesma coisa, e não havia como declarar que B e C dependem de A mas não um do
  /// outro. `null` = não declarado, e aí o modo de execução continua respondendo
  /// (compatibilidade com o que já está publicado).
  dependeDe   Json?
  /// EXECUTOR declarado do passo. `null` = o registro resolve pela chave, como sempre
  /// fez. Um passo criado pelo administrador declara aqui qual interface o executa —
  /// é o que permite um passo novo nascer executável sem código.
  executorKey String? @db.VarChar(40)

  /// PODE SER REEXECUTADO? — política de reabertura, cadastrada, não presumida.
  ///
  /// Reabrir uma etapa concluída sempre foi possível no motor e nunca foi uma decisão
  /// declarada: quem podia, com que justificativa e o que acontecia com os dependentes
  /// eram respostas do código. Aqui viram cadastro — e ficam congeladas na versão,
  /// como todo o resto da configuração.
  reaberturaPermitida          Boolean @default(true)
  /// SOMENTE_ESTA | ESTA_E_DEPENDENTES | ESCOLHA_MANUAL — o que a tela propõe por
  /// padrão quando alguém reabre. `ESCOLHA_MANUAL` não propõe: pergunta.
  reaberturaEstrategia         String  @default("ESCOLHA_MANUAL") @db.VarChar(24)
  /// Reabrir sem dizer por quê deixa o histórico com um buraco no lugar do motivo.
  reaberturaExigeJustificativa Boolean @default(true)
  /// Permissão exigida para reabrir esta etapa. `null` = a permissão geral de reabrir.
  reaberturaPermissao          String? @db.VarChar(60)

  /// REGRA DE CONCLUSÃO do passo, em vocabulário fechado.
  ///
  /// `completionRule` acima é texto livre herdado e continua sendo exibido; ele nunca
  /// foi interpretado pelo motor. Esta coluna é o que o motor lê:
  ///   TODAS_SUBTAREFAS_OBRIGATORIAS — o passo conclui quando toda subtarefa
  ///                                   obrigatória e aplicável estiver concluída;
  ///   QUALQUER_SUBTAREFA            — basta uma;
  ///   ACAO_DO_PASSO                 — quem conclui é a ação do passo (o que sempre
  ///                                   valeu, e continua sendo o padrão).
  regraDeConclusao String @default("ACAO_DO_PASSO") @db.VarChar(40)

  acoes      StepAction[]
  campos     StepField[]
  checkItens StepChecklistItem[]
  canais     StepChannel[]
  requisitos StepRequirement[]
  subtarefas StepSubtaskDefinition[]

  @@unique([workflowId, key])
}

/// SUBTAREFA CADASTRADA DE UM PASSO — o que acontece DENTRO dele.
///
/// ─── O QUE FALTAVA ─────────────────────────────────────────────────────────
/// "Solicitar via fornecedor", "Registrar protocolo", "Aguardar retorno" eram três
/// coisas dentro de um passo chamado "Solicitar certidão" — e não eram nada: eram
/// trechos de um componente React. Não tinham identidade, não tinham estado, não
/// tinham execução, não tinham histórico. Perguntar "quem registrou o protocolo e
/// quando?" não tinha onde ser respondido, porque a única coisa que existia era o
/// passo inteiro, concluído ou não.
///
/// ─── O QUE ESTA ENTIDADE ESTABELECE ────────────────────────────────────────
/// A subtarefa é DEFINIÇÃO: identidade estável (`key`), configuração própria (campos,
/// ações, checklist, requisitos, dependências, condições, SLA, responsável, executor,
/// política de reabertura) e versionamento junto com o passo. A EXECUÇÃO dela é
/// `SubtaskExecution`, append-only, exatamente como a tentativa do passo.
///
/// ─── O QUE ELA NÃO É ───────────────────────────────────────────────────────
/// Não é um segundo motor de workflow escondido dentro do passo: ela pertence ao
/// `PhaseInternalWorkflowStep` e morre com ele. Não é tarefa: `Tarefa` continua sendo
/// a unidade atribuível, e subtarefa não cria tarefa por conta própria.
model StepSubtaskDefinition {
  id     Int                       @id @default(autoincrement())
  stepId Int
  step   PhaseInternalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  /// IDENTIDADE ESTÁVEL. É ela que a execução grava; o rótulo pode ser reescrito.
  key       String  @db.VarChar(60)
  label     String  @db.VarChar(200)
  descricao String? @db.Text
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  /// Obrigatória para o passo concluir (quando a regra de conclusão olha subtarefas).
  obrigatoria    Boolean @default(true)
  /// Pode acontecer mais de uma vez (ex.: "registrar protocolo" a cada tentativa).
  repetivel      Boolean @default(false)
  /// Teto de ocorrências quando repetível. `null` = sem teto.
  maxOcorrencias Int?

  /// MANUAL = alguém executa; AUTOMATICA = o motor conclui ao satisfazer a condição.
  modoExecucao String @default("MANUAL") @db.VarChar(20)

  /// HERDA | ESPECIFICO | REGRA — de onde sai o responsável desta subtarefa.
  responsavelRegra String @default("HERDA") @db.VarChar(20)
  /// Quando ESPECIFICO. Referência solta a Usuario (o motor projeta, não cascateia).
  responsavelId    Int?
  /// SLA próprio em dias úteis. `null` = herda o do passo.
  slaDays          Int?

  /// CONDIÇÕES DECLARATIVAS (motor `src/lib/motor/condicoes.ts`; nunca código).
  /// Entrada: quando ela fica DISPONÍVEL. Conclusão: o que precisa valer para
  /// concluir. Visibilidade: quando ela APARECE — e aparecer não é poder executar.
  condicaoEntrada      Json?
  condicaoConclusao    Json?
  condicaoVisibilidade Json?

  /// DEPENDÊNCIA DECLARADA entre subtarefas do MESMO passo (lista de `key`).
  /// Ordem não é dependência: B e C podem depender de A sem depender uma da outra.
  dependeDe Json?

  /// Executor próprio. `null` = o do passo. É capacidade técnica, nunca negócio.
  executorKey String? @db.VarChar(40)

  /// Escopo próprio. `null` = o do passo. Ver `cardinalidade` do passo.
  cardinalidade String? @db.VarChar(20)

  /// FONTE DOS CANAIS desta subtarefa — quando ela envia algo para fora.
  ///   NENHUMA               — não usa canal;
  ///   FORNECEDOR_RELACIONADO — os canais que o fornecedor CONCRETO daquele documento
  ///                            oferece. O workflow não copia o cadastro dele;
  ///   TIPOS_PERMITIDOS       — restringe aos tipos listados em `tiposDeCanal`.
  fonteDeCanais String @default("NENHUMA") @db.VarChar(30)
  /// Restrição por tipo de canal (chaves de `CanalOperacional`), quando aplicável.
  tiposDeCanal  Json?

  /// POLÍTICA DE REABERTURA própria. `null` nos booleanos = herda a do passo.
  reaberturaPermitida          Boolean?
  reaberturaExigeJustificativa Boolean?
  reaberturaPermissao          String?  @db.VarChar(60)

  metadata Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  acoes      StepAction[]
  campos     StepField[]
  checkItens StepChecklistItem[]
  requisitos StepRequirement[]

  @@unique([stepId, key])
  @@index([stepId])
}

/// AÇÃO CADASTRADA DE UM PASSO — o resultado que o operador escolhe.
///
/// "Aprovado", "Aprovado com ressalvas", "Solicitar nova via" eram um array dentro do
/// componente React: o administrador não podia acrescentar um resultado, e o servidor
/// não sabia quais existiam. Aqui a ação é dado, e o que ela FAZ é um `effectKey` do
/// catálogo de efeitos — o administrador escolhe entre efeitos que já existem no
/// código, nunca escreve comportamento.
///
/// IDENTIDADE É A `key`, não o rótulo: renomear não quebra o histórico, porque o que
/// ficou gravado na execução foi a chave.
model StepAction {
  id           Int                       @id @default(autoincrement())
  stepId       Int
  step         PhaseInternalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key          String                    @db.VarChar(60)
  label        String                    @db.VarChar(160)
  descricao    String?                   @db.Text
  ordem        Int                       @default(0)
  /// Chave do CATÁLOGO DE EFEITOS (código). A publicação recusa efeito inexistente.
  effectKey    String                    @db.VarChar(60)
  /// Campos (`StepField.key`) que esta ação exige preenchidos.
  requerCampos Json?
  /// Permissão exigida para executar. `null` = a permissão do passo.
  permissao    String?                   @db.VarChar(60)
  condicao     Json?
  metadata     Json?
  ativo        Boolean                   @default(true)
  criadoEm     DateTime                  @default(now())
  atualizadoEm DateTime                  @updatedAt

  /// A QUAL SUBTAREFA pertence. `null` = pertence ao PASSO, como sempre foi.
  ///
  /// A coluna é anulável porque a subtarefa nasceu depois: tudo o que já estava
  /// cadastrado continua sendo do passo, sem uma linha de migração de dado.
  subtaskId Int?
  subtask   StepSubtaskDefinition? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  // ── A IDENTIDADE É POR DONO ─────────────────────────────────────────────
  //
  // Era `@@unique([stepId, key])`: a chave tinha de ser única no PASSO INTEIRO. Isso
  // impedia duas subtarefas de terem, cada uma, um campo "observacao" — e impedia uma
  // subtarefa de usar uma chave que o passo já usava. São peças de donos diferentes;
  // exigir que não se repitam entre donos é confundir "identidade" com "nome global".
  //
  // A trava passou a ser DOIS índices parciais (ver a migration
  // 20260822100000_identidade_por_dono), que o schema.prisma não sabe expressar:
  //   UNIQUE (stepId, key)    WHERE subtaskId IS NULL      — as peças do passo
  //   UNIQUE (subtaskId, key) WHERE subtaskId IS NOT NULL  — as peças de cada subtarefa
  // Sem os dois, NULL sendo distinto de NULL no Postgres deixaria o passo aceitar dois
  // campos com a mesma chave.

  @@index([stepId])
}

/// CAMPO CADASTRADO DE UM PASSO — o que o operador preenche.
model StepField {
  id           Int                       @id @default(autoincrement())
  stepId       Int
  step         PhaseInternalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key          String                    @db.VarChar(60)
  label        String                    @db.VarChar(160)
  /// texto | textarea | numero | moeda | data | select | multiselect | checkbox | radio | upload | booleano
  tipo         String                    @db.VarChar(20)
  obrigatorio  Boolean                   @default(false)
  /// Opções de select/multiselect/radio: [{ value, label }]. Também aceita a chave de
  /// um catálogo global (`{ catalogo: "canais" }`) — é assim que o campo "canal"
  /// oferece os canais cadastrados sem repetir a lista dentro do passo.
  opcoes       Json?
  /// Condição de visibilidade declarativa: { campo, op, valor }.
  condicao     Json?
  ajuda        String?                   @db.Text
  ordem        Int                       @default(0)
  ativo        Boolean                   @default(true)
  criadoEm     DateTime                  @default(now())
  atualizadoEm DateTime                  @updatedAt

  opcoesCadastradas StepFieldOption[]

  /// A QUAL SUBTAREFA pertence. `null` = pertence ao PASSO, como sempre foi.
  ///
  /// A coluna é anulável porque a subtarefa nasceu depois: tudo o que já estava
  /// cadastrado continua sendo do passo, sem uma linha de migração de dado.
  subtaskId Int?
  subtask   StepSubtaskDefinition? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  // ── A IDENTIDADE É POR DONO ─────────────────────────────────────────────
  //
  // Era `@@unique([stepId, key])`: a chave tinha de ser única no PASSO INTEIRO. Isso
  // impedia duas subtarefas de terem, cada uma, um campo "observacao" — e impedia uma
  // subtarefa de usar uma chave que o passo já usava. São peças de donos diferentes;
  // exigir que não se repitam entre donos é confundir "identidade" com "nome global".
  //
  // A trava passou a ser DOIS índices parciais (ver a migration
  // 20260822100000_identidade_por_dono), que o schema.prisma não sabe expressar:
  //   UNIQUE (stepId, key)    WHERE subtaskId IS NULL      — as peças do passo
  //   UNIQUE (subtaskId, key) WHERE subtaskId IS NOT NULL  — as peças de cada subtarefa
  // Sem os dois, NULL sendo distinto de NULL no Postgres deixaria o passo aceitar dois
  // campos com a mesma chave.

  @@index([stepId])
}

/// UMA OPÇÃO DE UM CAMPO — com identidade própria, ordem e inativação.
///
/// As opções viviam num JSON dentro do campo. Enquanto são três strings isso passa;
/// no dia em que alguém precisa INATIVAR uma opção sem apagá-la — porque processos
/// antigos a escolheram e o histórico precisa continuar dizendo o que ela era — o JSON
/// não tem onde guardar isso. Aqui a opção tem `key` estável: renomear o rótulo não
/// muda o que ficou gravado na execução.
model StepFieldOption {
  id           Int       @id @default(autoincrement())
  fieldId      Int
  field        StepField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  key          String    @db.VarChar(60)
  label        String    @db.VarChar(200)
  descricao    String?   @db.Text
  ordem        Int       @default(0)
  ativo        Boolean   @default(true)
  /// Condição declarativa de visibilidade da OPÇÃO: { campo, op, valor }.
  condicao     Json?
  metadata     Json?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@unique([fieldId, key])
  @@index([fieldId])
}

/// CANAL ASSOCIADO A UM PASSO — quais canais ESTE passo oferece, e o que cada um exige.
///
/// `CanalOperacional` é o catálogo da casa; esta tabela é a escolha do passo. Sem ela,
/// "quais canais aparecem em Solicitar certidão" só podia ser respondido com "todos os
/// ativos" — e o que um canal exige NESTE passo (protocolo, comprovante, destinatário)
/// não tinha onde ser configurado sem virar regra no código.
model StepChannel {
  id                 Int                       @id @default(autoincrement())
  stepId             Int
  step               PhaseInternalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  canalId            Int
  canal              CanalOperacional          @relation(fields: [canalId], references: [id], onDelete: Cascade)
  ordem              Int                       @default(0)
  ativo              Boolean                   @default(true)
  /// Sobrescreve o requisito do catálogo NESTE passo. `null` = herda do canal.
  exigeProtocolo     Boolean?
  exigeAnexo         Boolean?
  exigeRastreio      Boolean?
  exigeObservacao    Boolean?
  /// Campos (`StepField.key`) que este canal torna obrigatórios.
  camposObrigatorios Json?
  /// Condição declarativa para o canal aparecer.
  condicao           Json?
  criadoEm           DateTime                  @default(now())
  atualizadoEm       DateTime                  @updatedAt

  @@unique([stepId, canalId])
  @@index([stepId])
  @@index([canalId])
}

/// REQUISITO — a condição necessária para concluir o passo ou executar uma ação.
///
/// Campo, checklist e evidência são COISAS; requisito é uma AFIRMAÇÃO sobre elas
/// ("o protocolo precisa estar preenchido", "o checklist precisa estar completo").
/// Sem esta separação, "exige comprovante" só existia dentro do executor, e mudá-lo
/// era deploy.
model StepRequirement {
  id              Int                       @id @default(autoincrement())
  stepId          Int
  step            PhaseInternalWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  key             String                    @db.VarChar(60)
  label           String                    @db.VarChar(200)
  descricao       String?                   @db.Text
  /// CAMPO_PREENCHIDO | CHECKLIST_COMPLETO | EVIDENCIA_ANEXADA | ACAO_EXECUTADA
  tipo            String                    @db.VarChar(30)
  /// A que ele se refere: a `key` do campo, do item de checklist ou da ação.
  alvoKey         String?                   @db.VarChar(60)
  /// Quantidade mínima, quando o tipo admite (ex.: evidências).
  minimo          Int                       @default(1)
  obrigatorio     Boolean                   @default(true)
  /// Só vale quando a condição for verdadeira. `null` = sempre.
  condicao        Json?
  /// Aplica-se a esta ação; `null` = à conclusão do passo.
  acaoKey         String?                   @db.VarChar(60)
  /// EVIDÊNCIA — só faz sentido em `tipo = EVIDENCIA_ANEXADA`.
  ///
  /// Qual DOCUMENTO MESTRE o arquivo precisa ser (por ID, nunca por nome de arquivo),
  /// que formatos são aceitos e em que momento a exigência vale. Isto está aqui, e não
  /// numa tabela própria, porque "precisa haver comprovante anexado" É um requisito —
  /// separá-lo criaria duas respostas para "o que falta para concluir".
  evidenciaTipoId Int?
  evidenciaTipo   TipoDocumentoCadastro?    @relation("RequisitoEvidenciaMestre", fields: [evidenciaTipoId], references: [id], onDelete: SetNull)
  /// Formatos aceitos (ex.: ["application/pdf","image/jpeg"]). `null` = qualquer um.
  mimesPermitidos Json?
  /// AO_CONCLUIR | AO_EXECUTAR_ACAO | SEMPRE — quando a exigência é cobrada.
  momento         String                    @default("AO_CONCLUIR") @db.VarChar(24)
  ordem           Int                       @default(0)
  ativo           Boolean                   @default(true)
  criadoEm        DateTime                  @default(now())
  atualizadoEm    DateTime                  @updatedAt

  /// A QUAL SUBTAREFA pertence. `null` = pertence ao PASSO, como sempre foi.
  ///
  /// A coluna é anulável porque a subtarefa nasceu depois: tudo o que já estava
  /// cadastrado continua sendo do passo, sem uma linha de migração de dado.
  subtaskId Int?
  subtask   StepSubtaskDefinition? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  // ── A IDENTIDADE É POR DONO ─────────────────────────────────────────────
  //
  // Era `@@unique([stepId, key])`: a chave tinha de ser única no PASSO INTEIRO. Isso
  // impedia duas subtarefas de terem, cada uma, um campo "observacao" — e impedia uma
  // subtarefa de usar uma chave que o passo já usava. São peças de donos diferentes;
  // exigir que não se repitam entre donos é confundir "identidade" com "nome global".
  //
  // A trava passou a ser DOIS índices parciais (ver a migration
  // 20260822100000_identidade_por_dono), que o schema.prisma não sabe expressar:
  //   UNIQUE (stepId, key)    WHERE subtaskId IS NULL      — as peças do passo
  //   UNIQUE (subtaskId, key) WHERE subtaskId IS NOT NULL  — as peças de cada subtarefa
  // Sem os dois, NULL sendo distinto de NULL no Postgres deixaria o passo aceitar dois
  // campos com a mesma chave.

  @@index([stepId])
}

