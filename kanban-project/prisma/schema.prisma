  itemCatalogoId    Int? // FONTE do lançamento manual: item do Cadastro Mestre (Gerenciamento). Aditivo, sem FK forte.
  status            String    @default("RASCUNHO") @db.VarChar(20) // RASCUNHO|ATIVO|SUSPENSO|LIQUIDADO|CANCELADO
  estadoCusto       String?   @db.VarChar(24) // F4 — estado de NEGÓCIO do custo (ortogonal ao status do contrato): PREVISTO|APROVADO|CONTRATADO|EXECUTADO|PAGO|CONCILIADO|CANCELADO_PARCIAL|CANCELADO|ARQUIVADO. Null p/ receita. NÃO inferido por saldo.
  arquivadaEm       DateTime? // exclusão LÓGICA (soft-delete) — oculta das listas operacionais; Ledger preservado. Simétrico a Receita.arquivadaEm; usado p/ custo (sem Receita de origem).
  vencimento        DateTime? // Fase 2 — vencimento da obrigação (ex.: lançamento extra em cobrança futura)
  versao            Int       @default(1)
  substituiId       Int?
  origemTipo        String?   @db.VarChar(20) // Receita|Custo|nativo
  origemId          Int?
  observacoes       String?   @db.Text
  version           Int       @default(0) // optimistic locking (aggregate)
  criadoPorId       Int?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  ledger           LedgerFinanceiro?
  ocorrencias      OcorrenciaFinanceira[]
  distribuicoes    DistribuicaoEconomica[]
  parcelasPagaveis ParcelaPagavel[] // F5 — cronograma de vencimentos de PAGÁVEIS (Contas a Pagar). Saldo continua no Ledger.
  repasses         RepasseCusto[]          @relation("RepassesDoCusto") // F5 — vínculos explícitos de repasse/reembolso deste custo a cobranças do cliente
  fornecedor       Fornecedor?             @relation(fields: [fornecedorId], references: [id], onDelete: SetNull) // custo: beneficiário a quem se paga (reuso do cadastro central; antes era int órfão)

  @@unique([origemTipo, origemId]) // 1:1 com a Receita/Custo de origem (idempotÃªncia do backfill/dual-write)
  @@index([processoId])
  @@index([status])
  @@index([natureza])
  @@index([codigoOperacional])
}

// F5 — CRONOGRAMA de vencimentos de PAGÁVEIS (Contas a Pagar). Componente OFICIAL e
// genérico: qualquer ObrigacaoEconomica A_PAGAR (custo/reembolso/corporativo) pode ter
// um cronograma. Guarda SÓ o plano (vencimento + valor planejado); NUNCA saldo/recebido
// — a fonte única do saldo é o Ledger. Status de pagamento é DERIVADO (Ledger + vencimento).
// NÃO reutiliza ParcelaFinanceira (recebíveis): pagável e recebível são domínios distintos.
model ParcelaPagavel {
  id           Int                @id @default(autoincrement())
  obrigacaoId  Int
  obrigacao    ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  numero       Int
  vencimento   DateTime
  valor        Decimal            @db.Decimal(14, 2) // valor PLANEJADO da parcela (cronograma), não é saldo
  moeda        Moeda              @default(BRL)
  canceladaEm  DateTime? // parcela cancelada (cronograma) — status derivado passa a CANCELADA
  criadoPorId  Int?
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  @@unique([obrigacaoId, numero])
  @@index([obrigacaoId])
  @@index([vencimento])
}

// F5 — VÍNCULO EXPLÍCITO e AUDITÁVEL de Repasse/Reembolso: liga uma obrigação de CUSTO
// (A_PAGAR) à cobrança/receita do cliente que a recupera. Custo e Receita seguem domínios
// distintos: NUNCA se converte um no outro — este registro é o elo rastreável entre eles.
model RepasseCusto {
  id                 Int                @id @default(autoincrement())
  custoObrigacaoId   Int
  custoObrigacao     ObrigacaoEconomica @relation("RepassesDoCusto", fields: [custoObrigacaoId], references: [id], onDelete: Cascade)
  receitaObrigacaoId Int? // obrigação de RECEITA (cobrança ao cliente) que recupera o custo — ref soft (sem FK forte, como faseId/centroCustoId)
  cobrancaId         Int? // cobrança específica, quando aplicável
  tipo               String             @db.VarChar(12) // REPASSE | REEMBOLSO
  valor              Decimal            @db.Decimal(14, 2)
  percentual         Decimal?           @db.Decimal(6, 3)
  pagadorPessoaId    Int? // participante pagador (quem reembolsa/paga o repasse)
  status             String             @default("ATIVO") @db.VarChar(12) // ATIVO | CANCELADO
  motivo             String?            @db.VarChar(300)
  criadoPorId        Int?
  criadoEm           DateTime           @default(now())

  @@index([custoObrigacaoId])
  @@index([receitaObrigacaoId])
}

/// Livro-razÃ£o (double-entry) de UMA obrigaÃ§Ã£o. Ãnica fonte da verdade.
model LedgerFinanceiro {
  id            Int                @id @default(autoincrement())
  obrigacaoId   Int                @unique
  obrigacao     ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  moedaContabil Moeda              @default(BRL)
  criadoEm      DateTime           @default(now())

  entries LedgerEntry[]
}

/// Perna de um lanÃ§amento contÃ¡bil balanceado (imutÃ¡vel, append-only).
model LedgerEntry {
  id                Int              @id @default(autoincrement())
  ledgerId          Int
  ledger            LedgerFinanceiro @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  obrigacaoId       Int
  parcelaId         Int?
  ocorrenciaId      Int?
  transacaoId       String           @db.VarChar(60) // agrupa as pernas de um mesmo lanÃ§amento
  tipo              String           @db.VarChar(30) // OBRIGACAO_CRIADA|PAGAMENTO|DESCONTO|JUROS|MULTA|ESTORNO|DIFERENCA_CAMBIAL|CANCELAMENTO|BAIXA|AJUSTE|ABERTURA...
  contaContabil     String           @db.VarChar(20) // cÃ³digo do plano de contas
  direcao           String           @db.VarChar(8) // DEBITO|CREDITO
  valor             Decimal          @db.Decimal(14, 2)
  moeda             Moeda            @default(BRL)
  valorContabil     Decimal          @db.Decimal(14, 2) // BRL
  snapshotCambialId Int?
  data              DateTime
  sequencia         Int // monotÃ´nica por ledger
  estornaEntryId    Int?
  idempotencyKey    String?          @unique @db.VarChar(120)
  correlacaoId      String?          @db.VarChar(60)
  criadoPorId       Int?
  criadoEm          DateTime         @default(now())

  @@index([ledgerId, sequencia])
  @@index([transacaoId])
  @@index([obrigacaoId, data])
  @@index([ocorrenciaId])
  @@index([contaContabil, data])
}

/// Plano de contas (cadastro extensÃ­vel).
model PlanoContaFinanceira {
  id       Int      @id @default(autoincrement())
  codigo   String   @unique @db.VarChar(20)
