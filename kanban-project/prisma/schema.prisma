// ============================================================================
// COBRANÃA â COMO uma Receita serÃ¡ cobrada (separada da Receita e do Pagamento).
// A Receita Ã© sÃ³ o contrato (o que o motor gerou). A CobranÃ§a define forma/condiÃ§Ã£o/
// parcelamento/conta/carteira/gateway/encargos, consumindo EXCLUSIVAMENTE os cadastros
// de Gerenciamento por ID (nunca duplica config). Uma Receita pode ter 1..N CobranÃ§as.
// As Parcelas pertencem Ã  CobranÃ§a; os Pagamentos (EventoFinanceiro) vinculam Ã  CobranÃ§a,
// nunca Ã  Receita. Aditivo: legado (parcelas direto na Receita) permanece intacto.
// ============================================================================
model Cobranca {
  id                  Int       @id @default(autoincrement())
  receitaId           Int
  receita             Receita   @relation("ReceitaCobrancas", fields: [receitaId], references: [id], onDelete: Cascade)
  processoId          Int // snapshot p/ consulta rÃ¡pida
  // IDs do Gerenciamento â Financeiro (FONTE ÃNICA â sÃ³ referÃªncia, nunca cÃ³pia):
  formaPagamentoId    Int? // â FormaPagamentoCadastro
  condicaoPagamentoId Int? // â CondicaoPagamento
  contaBancariaId     Int? // â ContaBancaria
  carteiraId          Int? // â CarteiraRecebimento
  taxaPagamentoId     Int? // â TaxaPagamento
  gateway             String?   @db.VarChar(40)
  moeda               Moeda     @default(EUR)
  valorTotal          Decimal   @db.Decimal(12, 2)
  status              String    @default("ABERTA") @db.VarChar(20) // ABERTA | PARCIAL | QUITADA | CANCELADA | RENEGOCIADA
  // congelamento auditÃ¡vel da condiÃ§Ã£o no momento da criaÃ§Ã£o
  condicaoVersao      Int?
  condicaoCodigo      String?   @db.VarChar(60)
  memoriaCalculo      Json?
  observacoes         String?
  criadoPorId         Int?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt
  // Envio da cobrança ao cliente (aditivo) — marca quando foi enviada + link de pagamento.
  enviadaEm           DateTime?
  linkPagamento       String?   @db.VarChar(500)
  enviadaPorId        Int?

  // ââ RUNTIME DE CÃLCULO (auditoria; congelado na confirmaÃ§Ã£o) ââ
  // NÃ£o Ã© cadastro â Ã© o RESULTADO calculado pelo ChargeCalculationService.
  politicaTaxas        String?   @db.VarChar(30) // IGNORAR | REPASSAR | ABSORVER (efetiva)
  valorBase            Decimal?  @db.Decimal(12, 2) // valor da Receita antes de taxa
  valorTaxa            Decimal?  @db.Decimal(12, 2)
  valorRepassado       Decimal?  @db.Decimal(12, 2) // taxa somada ao total (REPASSAR)
  valorAbsorvido       Decimal?  @db.Decimal(12, 2) // taxa que reduz o lÃ­quido (ABSORVER)
  valorLiquido         Decimal?  @db.Decimal(12, 2) // previsto para a empresa
  // cÃ¢mbio (quando hÃ¡ conversÃ£o): estimado no rascunho, congelado na confirmaÃ§Ã£o
  moedaOrigem          String?   @db.VarChar(10)
  moedaDestino         String?   @db.VarChar(10) // moeda de RECEBIMENTO (destino da conversÃ£o)
  cotacao              Decimal?  @db.Decimal(12, 6)
  cotacaoData          DateTime?
  cotacaoFonte         String?   @db.VarChar(40)
  cotacaoTipo          String?   @db.VarChar(20) // MESMA | AUTOMATICA | MANUAL | ESTIMADA
  cotacaoId            Int? // â CotacaoCambio.id (quando automÃ¡tica)
  cotacaoManualPorId   Int? // â Usuario.id (quando manual)
  cotacaoJustificativa String?   @db.VarChar(300)
  congeladaEm          DateTime? // marca o congelamento (confirmaÃ§Ã£o); depois nÃ£o recalcula
  // snapshot da adquirente/bandeira usadas (aditivo; populado pelo runtime)
  adquirenteId         Int? // â Adquirente.id
  bandeiraId           Int? // â Bandeira.id
  // IdempotÃªncia da criaÃ§Ã£o: mesma chave nunca gera duas cobranÃ§as (retry seguro).
  idempotencyKey       String?   @unique @db.VarChar(80)
  obrigacaoId          Int? // → ObrigacaoEconomica (motor V3, aditivo)

  parcelas ParcelaFinanceira[] @relation("CobrancaParcelas")
  eventos  EventoFinanceiro[]  @relation("CobrancaEventos")

  @@index([receitaId])
  @@index([processoId])
  @@index([status])
}

model ParcelaFinanceira {
  id              Int             @id @default(autoincrement())
  receitaId       Int?
  custoId         Int?
  numero          Int
  vencimento      DateTime
  valor           Decimal         @db.Decimal(12, 2)
  status          StatusParcela   @default(PENDENTE)
