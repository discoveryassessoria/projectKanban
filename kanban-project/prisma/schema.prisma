/// DistribuiÃ§Ã£o econÃ´mica (independe do pagador).
model DistribuicaoEconomica {
  id             Int                @id @default(autoincrement())
  obrigacaoId    Int
  obrigacao      ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  modo           String             @default("SEM_DIVISAO") @db.VarChar(20) // SEM_DIVISAO|IGUAL|PERCENTUAL|VALOR|GRUPO|PERSONALIZADA
  versao         Int                @default(1)
