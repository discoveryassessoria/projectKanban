model ProdutoFinanceiro {
  publicCode          String?              @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                  Int                  @id @default(autoincrement())
  codigo              String               @db.VarChar(30)
  nome                String               @db.VarChar(200)
  especie             String?              @db.VarChar(20) // kind
  tipoFinanceiro      String?              @db.VarChar(20) // financialType
  categoriaId         Int?
  categoria           CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  // CONTA CONTÃBIL â LEGADO (conta Ãºnica). Preservado (sem DROP). Migrado p/ as duas
  // contas por natureza abaixo. NÃ£o Ã© mais editado na UI; serve de fallback histÃ³rico.
  planoContaId        Int?
  planoConta          PlanoConta?          @relation("ConfigFinPlanoConta", fields: [planoContaId], references: [id])
  // CONTA CONTÃBIL POR NATUREZA (aditivo) â Receita usada ao gerar RECEITA; Custo ao
  // gerar CUSTO (FinanceRuleEngine). Exigidas conforme naturezaFin (SOMENTE_RECEITA â
  // sÃ³ receita; SOMENTE_CUSTO â sÃ³ custo; CUSTO_E_RECEITA â ambas).
  planoContaReceitaId Int?
  planoContaReceita   PlanoConta?          @relation("ConfigFinContaReceita", fields: [planoContaReceitaId], references: [id])
  planoContaCustoId   Int?
  planoContaCusto     PlanoConta?          @relation("ConfigFinContaCusto", fields: [planoContaCustoId], references: [id])
  moedaPadrao         Moeda                @default(BRL)
  valorPadrao         Decimal?             @db.Decimal(12, 2) // LEGADO: fallback Ãºnico (prÃ©-unificaÃ§Ã£o). NÃO Ã© preÃ§o â migrar p/ TabelaValor.
  // M-UNIFICA â UMA config por mestre. possuiCusto/possuiReceita seguem sendo a
  // fonte de "o QUE o item pode gerar" (derivam naturezaFin abaixo).
  possuiCusto         Boolean              @default(false)
  possuiReceita       Boolean              @default(false)
  // PREÃO-FONTE-ÃNICA (aditivo): a ConfiguraÃ§Ã£o Financeira NÃO guarda mais preÃ§o.
  // Estes campos viram LEGADO â migrados p/ TabelaValor (CUSTO/VENDA) pelo backfill
  // `backfill-precos-legado-tabelavalor.ts`. Preservados atÃ© a migration de remoÃ§Ã£o.
  valorCustoPadrao    Decimal?             @db.Decimal(12, 2) // LEGADO â TabelaValor(natureza=CUSTO)
  valorReceitaPadrao  Decimal?             @db.Decimal(12, 2) // LEGADO â TabelaValor(natureza=VENDA)
  // Natureza financeira canÃ´nica (o QUE Ã© o item). Nullable durante a transiÃ§Ã£o;
  // deriva de possuiCusto/possuiReceita quando ausente (deriveNaturezaFinanceira).
  naturezaFin         NaturezaFinanceira?
  aplicaA             String?              @db.VarChar(20) // appliesTo
  cobravelDoCliente   Boolean              @default(false)
