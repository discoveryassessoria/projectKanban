  regraFinanceiraId  Int? // â PhaseEconomicRule/PhaseTriggerRule.id (solto/snapshot)
  natureza           NaturezaPreco? // CUSTO | VENDA que faltou resolver
  motivo             String         @db.VarChar(40) // SEM_PRECO | CONFLITO_PRECO | NENHUMA_LINHA | SEM_PRECO_VALIDO
  detalhe            String         @db.VarChar(500)
  contexto           Json? // dimensÃµes/alternativas descartadas (auditoria)
  chaveIdempotencia  String         @unique @db.VarChar(220) // anti-duplicaÃ§Ã£o no banco
  resolvida          Boolean        @default(false)
  resolvidaEm        DateTime?
