  itemCatalogoId      Int?
  itemCatalogo        ItemCatalogo?        @relation(fields: [itemCatalogoId], references: [id])

  // F1 â ConfiguraÃ§Ã£o Financeira canÃ´nica: FKs DIRETAS aos mestres reais.
  // itemCatalogoId Ã© o pivÃ´ (spine) e alvo de preÃ§o (TabelaValor/resolverPreco).
  // Exatamente UM mestre Ã© apontado. O papel financeiro NÃO vive mais aqui â
  // custo/receita sÃ£o valores desta config (M-UNIFICA); papel sÃ³ em TabelaValor.natureza.
  tipoDocumentoId     Int?
  tipoDocumento       TipoDocumentoCadastro?     @relation("ConfigFinTipoDocumento", fields: [tipoDocumentoId], references: [id])
  honorarioId         Int?
  honorario           Honorario?                 @relation("ConfigFinHonorario", fields: [honorarioId], references: [id])
  tipoProcessoId      Int?
  tipoProcesso        TipoProcessoNacionalidade? @relation("ConfigFinTipoProcesso", fields: [tipoProcessoId], references: [id])
  fornecedorPadraoId  Int?
  fornecedorPadrao    Fornecedor?                @relation("ConfigFinFornecedor", fields: [fornecedorPadraoId], references: [id])
  // CONDIÃÃO DE PAGAMENTO PADRÃO â cada serviÃ§o/documento carrega a sua regra de
  // cobranÃ§a. Nullable na adoÃ§Ã£o incremental: sem condiÃ§Ã£o o motor mantÃ©m o
  // comportamento histÃ³rico (1 parcela). Torna-se obrigatÃ³rio apÃ³s o backfill.
  condicaoPagamentoId Int?
  condicaoPagamento   CondicaoPagamento?         @relation("ConfigFinCondicaoPagamento", fields: [condicaoPagamentoId], references: [id])
  // F2 â back-relations: aplicabilidade/automaÃ§Ã£o apontam para esta config por FK
  econRulesCusto      PhaseEconomicRule[]        @relation("EconCustoConfig")
  econRulesReceita    PhaseEconomicRule[]        @relation("EconReceitaConfig")
  precosConfig        TabelaValor[]              @relation("PrecoConfig")

  // M-UNIFICA â anti-duplicaÃ§Ã£o: UMA configuraÃ§Ã£o por item mestre (pivÃ´).
  // itemCatalogoId nulo Ã© distinto no Postgres (nÃ£o restringe configs sem pivÃ´).
  @@unique([itemCatalogoId])
  @@index([itemCatalogoId])
  @@index([categoriaId])
  @@index([planoContaId])
  @@index([planoContaReceitaId])
  @@index([planoContaCustoId])
  @@index([tipoDocumentoId])
  @@index([honorarioId])
  @@index([tipoProcessoId])
  @@index([fornecedorPadraoId])
  @@index([condicaoPagamentoId])
}

// ââ Tabela de Valores (fin_values) ââ
model TabelaValor {
