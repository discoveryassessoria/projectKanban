  // CÃ³digo pÃºblico operacional (OPA-n) gerado pelo CodeGeneratorService central. Aditivo/Ãºnico;
  // nullable p/ backfill seguro. NÃ£o editÃ¡vel pelo usuÃ¡rio; identidade permanente (id/UUID Ã© a chave tÃ©cnica).
  publicCode                 String?                  @unique @db.VarChar(20)
  processoId                 Int
  // InstÃ¢ncia do Workflow Interno da fase de ORIGEM (a que solicitou a antecipaÃ§Ã£o).
  workflowInstanceId         Int?
  originPhaseCode            String?                  @db.VarChar(60)
  originStepKey              String?                  @db.VarChar(80)
  // Necessidade de origem que a operaÃ§Ã£o pretende atender (loose ref).
  necessidadeId              Int?
  // Destino: fase e workflow oficiais a que a operaÃ§Ã£o pertence.
  targetPhaseCode            String?                  @db.VarChar(60)
  targetWorkflowDefinitionId String?                  @db.VarChar(80)
  // Tipo operacional do CATÃLOGO (ex.: "documento") â resolvido por adaptador.
  targetOperationType        String                   @db.VarChar(40)
  // Documento-alvo (mestre) escolhido â pode DIFERIR do documento exigido pela necessidade de
  // origem (nesse caso Ã© documento de APOIO e NÃO substitui a necessidade). ParÃ¢metro tipado.
  targetTipoDocumentoId      Int?
  // Params tipados da criaÃ§Ã£o (pessoaId, paisId, jurisdicaoId, documentoExistenteId, â¦).
  params                     Json?
  // Id da operaÃ§Ã£o oficial criada/vinculada pelo adaptador (ex.: documentoId).
  targetOperationId          Int?
  objetivo                   String?                  @db.Text
  resultadoEsperado          String?                  @db.Text
  resultadoObtido            String?                  @db.Text
  // Resultado ESTRUTURADO interpretado (ex.: cartÃ³rio/livro/folha/termo do registro localizado).
  resultadoDados             Json?
  status                     StatusOperacaoAntecipada @default(CRIADA)
  responsavelId              Int?
  createdBy                  Int?
  avaliadoPor                Int?
  avaliadoEm                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  completedAt                DateTime?
  cancelledAt                DateTime?

  // IdempotÃªncia do documento-alvo explÃ­cito: 1 operaÃ§Ã£o por (processo, necessidade, tipo op,
  // tipo documento-alvo). NULLs sÃ£o distintos no Postgres â o Modo 2 (sem tipo) Ã© deduplicado
  // pela prÃ©-checagem no serviÃ§o, nÃ£o por este Ã­ndice.
  @@unique([processoId, necessidadeId, targetOperationType, targetTipoDocumentoId])
  @@index([processoId])
  @@index([necessidadeId])
  @@index([targetOperationType, targetOperationId])
  @@index([targetTipoDocumentoId])
  @@index([status])
}

// ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// MOTOR FINANCEIRO V3 â FASE 1 (infraestrutura ADITIVA; nÃ£o altera o legado).
// Ledger double-entry como fonte da verdade; saldos = projeÃ§Ã£o. Enums como
// VarChar (extensÃ­vel sem migration de enum). Refs ao legado = Int solto.
// Ver docs/motor-financeiro-discovery-spec.md (V3 congelada).
// ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

/// Aggregate root do ciclo financeiro. Reusa o cÃ³digo operacional atual (REC-n).
model ObrigacaoEconomica {
  id                Int       @id @default(autoincrement())
  codigoOperacional String?   @db.VarChar(40) // = cÃ³digo da Receita/Custo (ex.: REC-105)
  natureza          String    @db.VarChar(30) // RECEITA|CUSTO|RECEITA_EXTRA|DESCONTO|CREDITO|REEMBOLSO|JUROS|MULTA|AJUSTE|ESTORNO|RENEGOCIACAO|OUTRO
  direcao           String    @db.VarChar(12) // A_RECEBER|A_PAGAR
  processoId        Int?
  faseId            Int?
  clienteId         Int?
  regraFinanceiraId Int?
  moedaContratual   Moeda     @default(BRL)
  moedaContabil     Moeda     @default(BRL)
  valorContratado   Decimal   @db.Decimal(14, 2)
  politicaCambialId Int?
  politicaDivisao   String?   @db.VarChar(20) // SEM_DIVISAO|IGUAL|PERCENTUAL|VALOR|GRUPO|PERSONALIZADA
  fornecedorId      Int? // custo manual: fornecedor vinculado (aditivo; sem FK forte)
  itemCatalogoId    Int? // FONTE do lançamento manual: item do Cadastro Mestre (Gerenciamento). Aditivo, sem FK forte.
  status            String    @default("RASCUNHO") @db.VarChar(20) // RASCUNHO|ATIVO|SUSPENSO|LIQUIDADO|CANCELADO
  estadoCusto       String?   @db.VarChar(24) // F4 — estado de NEGÓCIO do custo (ortogonal ao status do contrato): PREVISTO|APROVADO|CONTRATADO|EXECUTADO|PAGO|CONCILIADO|CANCELADO_PARCIAL|CANCELADO|ARQUIVADO. Null p/ receita. NÃO inferido por saldo.
  arquivadaEm       DateTime? // exclusão LÓGICA (soft-delete) — oculta das listas operacionais; Ledger preservado. Simétrico a Receita.arquivadaEm; usado p/ custo (sem Receita de origem).
  vencimento        DateTime? // Fase 2 — vencimento da obrigação (ex.: lançamento extra em cobrança futura)
  versao            Int       @default(1)
  substituiId       Int?
  origemTipo        String?   @db.VarChar(20) // Receita|Custo|nativo
  origemId          Int?
  observacoes       String?   @db.Text
  version           Int       @default(0) // optimistic locking (aggregate)
  criadoPorId       Int?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  // ── VÍNCULO DOCUMENTAL ────────────────────────────────────────────────────
  // O model Custo legado carregava personId/documentoId/tipoServicoId/phaseKey e
  // era por eles que a Planilha Documental montava a grade (linha = documento,
  // coluna = serviço). Quando o motor passou a nascer V3-native (F3.5), o custo
  // deixou de gravar o Custo legado e o vínculo virou TEXTO em `observacoes` —
  // o financeiro passou a saber QUANTO sem saber DE QUEM e DE QUÊ. Estas colunas
  // devolvem o vínculo à obrigação, por ID. Elas NÃO duplicam o Ledger (que
  // continua sendo a única verdade do movimento): dizem a que fato operacional a
  // obrigação pertence. Simétricas às que a Receita já possui.
  personId           Int?
  documentoId        Int?
  tipoServicoId      Int?
  phaseKey           String? @db.VarChar(60)
  phaseCycle         Int?
  /// ProdutoFinanceiro (Configuração Financeira) que originou o lançamento.
  configFinanceiraId Int?

  /// COMO o lançamento nasceu. AUTOMATICO_DOCUMENTAL = projetado pela cadeia
  /// documental (registro localizado); BACKFILL_DOCUMENTAL = reparo determinístico
  /// da mesma cadeia; MANUAL = despesa extraordinária lançada por pessoa. Null =
  /// anterior à classificação (nunca inferido por heurística — a reconciliação
  /// apenas RELATA os não classificados).
  origemLancamento String? @db.VarChar(28)
  /// Evento de domínio que causou o lançamento (ex.: PhaseWorkflowStepInstance).
  eventoOrigemTipo String? @db.VarChar(40)
  eventoOrigemId   Int?

  // ── SNAPSHOT DE PREÇO (§7) — imutável no instante do lançamento ────────────
  // Mudar a Tabela de Preços não pode reescrever história: o que foi lançado
  // guarda a regra, o unitário, a quantidade e o contexto que o produziram.
  pricingRuleId       Int?
  valorUnitario       Decimal?  @db.Decimal(14, 2)
  quantidade          Int?
  modoCalculoAplicado String?   @db.VarChar(30)
  naturezaPreco       String?   @db.VarChar(10)
  contextoAplicado    Json?
  dataReferencia      DateTime?
  /// Chave idempotente do lançamento documental (mesma automaticKey do MotorArtefato).
  chaveIdempotencia   String?   @unique @db.VarChar(200)

  ledger           LedgerFinanceiro?
  ledgerEntries    LedgerEntry[] // LedgerEntry.obrigacaoId é denormalizado (o caminho canônico é ledger→obrigacao); a relação existe para a FK proteger o valor
  saldoProjecao    SaldoProjecao? // 1-1: SaldoProjecao.obrigacaoId é @unique
  ocorrencias      OcorrenciaFinanceira[]
  distribuicoes    DistribuicaoEconomica[]
  parcelasPagaveis ParcelaPagavel[] // F5 — cronograma de vencimentos de PAGÁVEIS (Contas a Pagar). Saldo continua no Ledger.
  repasses         RepasseCusto[]          @relation("RepassesDoCusto") // F5 — vínculos explícitos de repasse/reembolso deste custo a cobranças do cliente
  fornecedor       Fornecedor?             @relation(fields: [fornecedorId], references: [id], onDelete: SetNull) // custo: beneficiário a quem se paga (reuso do cadastro central; antes era int órfão)

  @@unique([origemTipo, origemId]) // 1:1 com a Receita/Custo de origem (idempotÃªncia do backfill/dual-write)
  @@index([processoId])
  @@index([status])
  @@index([natureza])
  @@index([codigoOperacional])
  @@index([itemCatalogoId]) // criado em 20260814000000_obrigacao_item_catalogo; faltava aqui
  @@index([documentoId])
  @@index([personId])
  @@index([processoId, documentoId, tipoServicoId]) // grade da Planilha Documental
}

/// ASSISTENTE DE PARAMETRIZAÇÃO — guarda PROGRESSO, nunca configuração.
///
/// O assistente é camada de orquestração: a Matriz vive em MatrizDocumental, o
/// preço em TabelaValor, o fornecedor em Fornecedor. Se ele guardasse cópia
/// desses dados, existiriam duas verdades e a tela administrativa e o assistente
/// divergiriam no primeiro cadastro feito fora dele. O que ele guarda é só onde
/// o administrador parou: escopo, etapa e quem mexeu.
model AssistenteParametrizacaoProgresso {
  id Int @id @default(autoincrement())

  /// ESCOPO — por tipo de processo (o país vem do próprio tipo).
  tipoProcessoId Int
  /// Fase específica, quando o administrador escolheu recortar; null = todas.
  phaseKey       String? @db.VarChar(60)

  /// Etapa em que parou (chave estrutural da etapa, não rótulo de tela).
  etapaAtual       String @db.VarChar(40)
  /// Etapas já percorridas — só chaves, nunca conteúdo de configuração.
  etapasConcluidas Json?

  usuarioId    Int?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  publicadoEm  DateTime?
  publicadoPor Int?

  @@unique([tipoProcessoId, phaseKey])
  @@index([tipoProcessoId])
}

// F5 — CRONOGRAMA de vencimentos de PAGÁVEIS (Contas a Pagar). Componente OFICIAL e
// genérico: qualquer ObrigacaoEconomica A_PAGAR (custo/reembolso/corporativo) pode ter
// um cronograma. Guarda SÓ o plano (vencimento + valor planejado); NUNCA saldo/recebido
// — a fonte única do saldo é o Ledger. Status de pagamento é DERIVADO (Ledger + vencimento).
// NÃO reutiliza ParcelaFinanceira (recebíveis): pagável e recebível são domínios distintos.
model ParcelaPagavel {
  id           Int                @id @default(autoincrement())
  obrigacaoId  Int
  obrigacao    ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  numero       Int
  vencimento   DateTime
  valor        Decimal            @db.Decimal(14, 2) // valor PLANEJADO da parcela (cronograma), não é saldo
  moeda        Moeda              @default(BRL)
  canceladaEm  DateTime? // parcela cancelada (cronograma) — status derivado passa a CANCELADA
  criadoPorId  Int?
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  @@unique([obrigacaoId, numero])
  @@index([obrigacaoId])
  @@index([vencimento])
}

// F5 — VÍNCULO EXPLÍCITO e AUDITÁVEL de Repasse/Reembolso: liga uma obrigação de CUSTO
// (A_PAGAR) à cobrança/receita do cliente que a recupera. Custo e Receita seguem domínios
// distintos: NUNCA se converte um no outro — este registro é o elo rastreável entre eles.
model RepasseCusto {
  id                 Int                @id @default(autoincrement())
  custoObrigacaoId   Int
  custoObrigacao     ObrigacaoEconomica @relation("RepassesDoCusto", fields: [custoObrigacaoId], references: [id], onDelete: Cascade)
  receitaObrigacaoId Int? // obrigação de RECEITA (cobrança ao cliente) que recupera o custo — ref soft (sem FK forte, como faseId)
  cobrancaId         Int? // cobrança específica, quando aplicável
  tipo               String             @db.VarChar(12) // REPASSE | REEMBOLSO
  valor              Decimal            @db.Decimal(14, 2)
  percentual         Decimal?           @db.Decimal(6, 3)
  pagadorPessoaId    Int? // participante pagador (quem reembolsa/paga o repasse)
  status             String             @default("ATIVO") @db.VarChar(12) // ATIVO | CANCELADO
  motivo             String?            @db.VarChar(300)
  criadoPorId        Int?
  criadoEm           DateTime           @default(now())

  @@index([custoObrigacaoId])
  @@index([receitaObrigacaoId])
}

/// Livro-razÃ£o (double-entry) de UMA obrigaÃ§Ã£o. Ãnica fonte da verdade.
model LedgerFinanceiro {
  id            Int                @id @default(autoincrement())
  obrigacaoId   Int                @unique
  obrigacao     ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  moedaContabil Moeda              @default(BRL)
  criadoEm      DateTime           @default(now())

  entries LedgerEntry[]
}

/// Perna de um lanÃ§amento contÃ¡bil balanceado (imutÃ¡vel, append-only).
model LedgerEntry {
  id                Int              @id @default(autoincrement())
  ledgerId          Int
  ledger            LedgerFinanceiro @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  obrigacaoId       Int
  parcelaId         Int?
  ocorrenciaId      Int?
  transacaoId       String           @db.VarChar(60) // agrupa as pernas de um mesmo lanÃ§amento
  tipo              String           @db.VarChar(30) // OBRIGACAO_CRIADA|PAGAMENTO|DESCONTO|JUROS|MULTA|ESTORNO|DIFERENCA_CAMBIAL|CANCELAMENTO|BAIXA|AJUSTE|ABERTURA...
  contaContabil     String           @db.VarChar(20) // cÃ³digo do plano de contas
  direcao           String           @db.VarChar(8) // DEBITO|CREDITO
  valor             Decimal          @db.Decimal(14, 2)
  moeda             Moeda            @default(BRL)
  valorContabil     Decimal          @db.Decimal(14, 2) // BRL
  snapshotCambialId Int?
  data              DateTime
  sequencia         Int // monotÃ´nica por ledger
  estornaEntryId    Int?
  idempotencyKey    String?          @unique @db.VarChar(120)
  correlacaoId      String?          @db.VarChar(60)
  criadoPorId       Int?
  criadoEm          DateTime         @default(now())

  obrigacao ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)

  @@index([ledgerId, sequencia])
  @@index([transacaoId])
  @@index([obrigacaoId, data])
  @@index([ocorrenciaId])
  @@index([contaContabil, data])
}

/// Plano de contas (cadastro extensÃ­vel).
model PlanoContaFinanceira {
  id       Int      @id @default(autoincrement())
  codigo   String   @unique @db.VarChar(20)
  nome     String   @db.VarChar(120)
