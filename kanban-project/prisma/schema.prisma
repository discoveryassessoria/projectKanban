generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Usuario {
  publicCode         String?            @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                 Int                @id @default(autoincrement())
  nome               String             @db.VarChar(100)
  email              String             @unique @db.VarChar(100)
  senha              String             @db.VarChar(255)
  tipo               String             @db.VarChar(20)
  perfilId           Int?
  permissoesCustom   Json?
  eventosFinanceiros EventoFinanceiro[] @relation("EventoFinanceiroUsuario")
  logs               LogAuditoria[]
  mensagens          Mensagem[]
  recibosEmitidos    Recibo[]           @relation("ReciboEmitente")
  tarefas            Tarefa[]
  historicoTarefas   TarefaHistorico[]
  perfil             Perfil?            @relation(fields: [perfilId], references: [id])

  documentosResponsavel Documento[]           @relation("DocumentoResponsavel")
  eventosResponsavel    Evento[]              @relation("EventoResponsavel")
  protocolosResponsavel Protocolo[]           @relation("ProtocoloResponsavel")
  gruposUsuario         GrupoUsuarioMembro[]
  nomesPessoaAfirmados  NomePessoa[]          @relation("NomePessoaResponsavel")
  decisoesDedupTomadas  DecisaoDeduplicacao[] @relation("DecisaoDedupResponsavel")

  // MRG - back-relations (autoria e assinatura das decisoes registrais)
  lotesRegistrais           LoteRegistral[]             @relation("LoteRegistralAutor")
  fatosRegistraisAfirmados  FatoRegistral[]             @relation("FatoRegistralResponsavel")
  correspondenciasDecididas CorrespondenciaIdentidade[] @relation("CorrespondenciaDecisor")
  propostasDecididas        PropostaReconciliacao[]     @relation("PropostaDecisor")
  propostasRevertidas       PropostaReconciliacao[]     @relation("PropostaRevertePor")
  conflitosResolvidos       ConflitoRegistral[]         @relation("ConflitoResolvedor")
  decisoesRegistrais        DecisaoRevisaoRegistral[]   @relation("DecisaoRegistralResponsavel")
  versoesGenealogicas       VersaoGenealogica[]         @relation("VersaoGenealogicaAutor")

  @@index([perfilId])
}

model Pessoa {
  publicCode         String?       @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                 Int           @id @default(autoincrement())
  nome               String        @db.VarChar(50)
  sobrenome          String?       @db.VarChar(40)
  sexo               String?       @db.VarChar(10)
  data_nasc          DateTime?
  data_obito         DateTime?
  local_nasc         String?       @db.VarChar(100)
  estado_nasc        String?       @db.VarChar(50)
  pais_nasc          String?       @db.VarChar(50)
  vivo               Boolean       @default(true)
  batizado           String?       @db.VarChar(50)
  data_batismo       DateTime?
  local_batismo      String?       @db.VarChar(100)
  igreja_batismo     String?       @db.VarChar(150)
  profissao          String?       @db.VarChar(100)
  nacionalidade      String?       @db.VarChar(50)
  cidadanias_outras  String?       @db.VarChar(200)
  naturalizado       Boolean       @default(false)
  data_naturalizacao DateTime?
  pais_naturalizacao String?       @db.VarChar(50)
  data_emigracao     DateTime?
  local_emigracao    String?       @db.VarChar(100)
  porto_embarque     String?       @db.VarChar(100)
  data_chegada       DateTime?
  porto_chegada      String?       @db.VarChar(100)
  pais_destino       String?       @db.VarChar(50)
  navio              String?       @db.VarChar(100)
  comentario         String?
  x                  Int?
  y                  Int?
  arvoreId           Int?
  paiId              Int?
  maeId              Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  numeroLinhagem     Int?
  requerente         String?       @default("nao")
  ordemCusto         Int?          @default(0)
  arvorePrincipal    Arvore?       @relation("ArvorePrincipal")
  custos             CustoPessoa[]
  documentos         Documento[]
  arvore             Arvore?       @relation("PessoasNaArvore", fields: [arvoreId], references: [id], onDelete: Cascade)
  mae                Pessoa?       @relation("FilhosMae", fields: [maeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  filhosComoMae      Pessoa[]      @relation("FilhosMae")
  pai                Pessoa?       @relation("FilhosPai", fields: [paiId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  filhosComoPai      Pessoa[]      @relation("FilhosPai")
  unioesComoPessoa1  Uniao[]       @relation("Pessoa1")
  unioesComoPessoa2  Uniao[]       @relation("Pessoa2")
  documentacao       Boolean       @default(true)
  casado             Boolean       @default(false)
  linhaReta          Boolean       @default(true)
  custosFin          Custo[]
  receitasFin        Receita[]

  // CP-1 â papÃ©is contextuais que apontam para esta identidade humana Ãºnica
  contratantesVinculados Contratante[] @relation("ContratantePessoa")
  requerentesVinculados  Requerente[]  @relation("RequerentePessoa")

  // CP-3 â necessidades documentais desta pessoa
  necessidades  NecessidadeDocumental[]
  nomePessoas   NomePessoa[]
  decisoesDedup DecisaoDeduplicacao[]   @relation("PessoaDecisaoDedup")

  // MRG — back-relations (referencia, nunca duplicacao de dominio)
  ocorrenciasResolvidas OcorrenciaDocumental[]      @relation("OcorrenciaPessoaResolvida")
  correspondencias      CorrespondenciaIdentidade[] @relation("CorrespondenciaPessoa")
  fatosRegistrais       FatoRegistral[]
  evidenciasRegistrais  EvidenciaRegistral[]        @relation("EvidenciaPessoa")
  conflitosRegistrais   ConflitoRegistral[]         @relation("ConflitoPessoa")

  @@index([arvoreId])
  @@index([pais_nasc])
  @@index([maeId])
  @@index([paiId])
}

model Uniao {
  id              Int       @id @default(autoincrement())
  data_inicio     DateTime?
  data_fim        DateTime?
  tipo            String?   @db.VarChar(30)
  local           String?   @db.VarChar(100)
  estado          String?   @db.VarChar(50)
  pais            String?   @db.VarChar(50)
  cartorio        String?   @db.VarChar(200)
  livro           String?   @db.VarChar(20)
  folha           String?   @db.VarChar(20)
  termo           String?   @db.VarChar(30)
  numero_registro String?   @db.VarChar(50)
  data_registro   DateTime?
  observacoes     String?
  pessoa1Id       Int
  pessoa2Id       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pessoa1         Pessoa    @relation("Pessoa1", fields: [pessoa1Id], references: [id], onDelete: Cascade)
  pessoa2         Pessoa    @relation("Pessoa2", fields: [pessoa2Id], references: [id], onDelete: Cascade)

  // CP-3 â necessidades de vÃ­nculo (casamento/uniÃ£o) referenciam a UniÃ£o.
  necessidades NecessidadeDocumental[]

  // MRG — back-relations
  fatosRegistrais      FatoRegistral[]
  evidenciasRegistrais EvidenciaRegistral[] @relation("EvidenciaUniao")
  conflitosRegistrais  ConflitoRegistral[]  @relation("ConflitoUniao")

  @@index([pessoa1Id])
  @@index([pessoa2Id])
}

model Arvore {
  id                Int        @id @default(autoincrement())
  nome              String     @db.VarChar(50)
  descricao         String?    @db.VarChar(200)
  commentPosX       Float?     @default(0)
  commentPosY       Float?     @default(0)
  pessoaPrincipalId Int?       @unique
  posicoesNodes     Json?
  pessoaPrincipal   Pessoa?    @relation("ArvorePrincipal", fields: [pessoaPrincipalId], references: [id], onUpdate: NoAction)
  pessoas           Pessoa[]   @relation("PessoasNaArvore")
  processos         Processo[]

  // CP-1 â a Ãrvore pertence a uma FamÃ­lia (nullable atÃ© backfill; dual-read)
  familiaId Int?
  familia   Familia? @relation(fields: [familiaId], references: [id], onDelete: SetNull)

  // MRG — back-relations
  lotesRegistrais     LoteRegistral[]
  propostasRegistrais PropostaReconciliacao[]
  conflitosRegistrais ConflitoRegistral[]
  versoesGenealogicas VersaoGenealogica[]

  @@index([familiaId])
}

// CP-1 â FamÃ­lia: entidade administrativa prÃ³pria (Regras 10/11/12).
// Agrupa Processos e Ãrvores. Backfill inicial: 1 FamÃ­lia por Ãrvore.
model Familia {
  id          Int        @id @default(autoincrement())
  nome        String     @db.VarChar(150)
  descricao   String?    @db.VarChar(300)
  observacoes String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  processos   Processo[]
  arvores     Arvore[]
}

model Documento {
  publicCode            String?         @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                    Int             @id @default(autoincrement())
  pessoaId              Int
  tipo                  TipoDocumento?
  status                StatusDocumento @default(PENDENTE)
  descricao             String?         @db.VarChar(200)
  cartorio              String?         @db.VarChar(200)
  livro                 String?         @db.VarChar(20)
  folha                 String?         @db.VarChar(20)
  termo                 String?         @db.VarChar(30)
  numero_registro       String?         @db.VarChar(50)
  data_registro         DateTime?
  cidade_registro       String?         @db.VarChar(100)
  estado_registro       String?         @db.VarChar(50)
  pais_registro         String?         @db.VarChar(50)
  numero                String?         @db.VarChar(50)
  orgao_emissor         String?         @db.VarChar(50)
  data_emissao          DateTime?
  data_validade         DateTime?
  arquivo_url           String?
  arquivo_nome          String?         @db.VarChar(200)
  arquivo_tamanho       Int?
  arquivo_mime_type     String?         @db.VarChar(100)
  traduzido             Boolean         @default(false)
  tradutor              String?         @db.VarChar(150)
  data_traducao         DateTime?
  arquivo_traducao_url  String?
  arquivo_traducao_nome String?         @db.VarChar(200)
  apostilado            Boolean         @default(false)
  numero_apostila       String?         @db.VarChar(50)
  data_apostila         DateTime?
  arquivo_apostila_url  String?
  observacoes           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  data_evento           DateTime?
  pessoa                Pessoa          @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  // IdentificaÃ§Ã£o literal (como aparece na certidÃ£o)
  nome_registrado    String? @db.VarChar(200)
  pai_registrado     String? @db.VarChar(200)
  mae_registrada     String? @db.VarChar(200)
  conjuge_registrado String? @db.VarChar(200)

  data_evento_documento   DateTime?
  data_registro_documento DateTime?

  // Localidade extra
  comune String? @db.VarChar(100)

  // ReferÃªncia registral extra
  matricula String? @db.VarChar(50)
  crc       String? @db.VarChar(50)
  protocolo String? @db.VarChar(50)

  // Rastreamento da solicitaÃ§Ã£o
  nro_pedido          String? @db.VarChar(50)
  canal_solicitacao   String? @db.VarChar(50)
  link_acompanhamento String? @db.VarChar(500)
  localizacao_fisica  String? @db.VarChar(200)

  // ============================================================
  // â NOVO: CAMPOS DE OPERAÃÃO (Central Operacional)
  // ============================================================
  responsavelId      Int?
  responsavel        Usuario?  @relation("DocumentoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  dataInicioOperacao DateTime?
  dataPrazoOperacao  DateTime?
  ultimaMovimentacao DateTime?
  motivoBloqueio     String?   @db.VarChar(300)
  // ============================================================

  origem   String  @default("manual") @db.VarChar(20)
  ruleCode String? @db.VarChar(20)

  // --- AnÃ¡lise Documental v2 (AD2) ---
  structuredData Json? // dados estruturados por tipo (birth/marriage/death)
  dataStatus     String @default("not_filled") // not_filled | ai_extracted | manual_filled | reviewed
  analysisStatus String @default("not_ready") // not_ready | ready
  registral      Json? // dados registrais revisados (verdade canÃ´nica)

  custosFin   Custo[]
  receitasFin Receita[]

  documentTypeId Int?
  documentType   TipoDocumentoCadastro? @relation(fields: [documentTypeId], references: [id])

  // CP-3 â Documento Operacional atende a uma NecessidadeDocumental de origem.
  // Nullable (dual-read + backfill); 1 necessidade -> N documentos (mÃºltiplas vias).
  necessidadeId Int?
  necessidade   NecessidadeDocumental? @relation(fields: [necessidadeId], references: [id], onDelete: SetNull)

  // CP-4A â vÃ­nculos operacionais do runtime v2 (back-relations)
  tarefasVinculadas Tarefa[]                    @relation("TarefaDocumento")
  stepInstances     PhaseWorkflowStepInstance[]
  protocolos        ProtocoloDocumento[]

  // ============================================================
  // MRG - TRANSCRICAO REGISTRAL (pertence ao Sistema Documental, nao a arvore).
  // O texto lido do documento mora aqui, ao lado do arquivo, porque e atributo
  // DO DOCUMENTO. O motor registral apenas LE. Sem estes campos o pipeline
  // dependeria de uma copia do documento dentro do dominio genealogico -
  // exatamente o que a arquitetura proibe.
  // transcricaoPaginas: [{ pagina: number, texto: string }] - e o que permite
  // citar pagina e offset em cada evidencia.
  // ============================================================
  transcricaoTexto   String?   @db.Text
  transcricaoPaginas Json?
  transcricaoFonte   String?   @db.VarChar(40)
  transcricaoEm      DateTime?

  // MRG - back-relations (o motor referencia o documento; nunca o copia)
  execucoesRegistrais   ExecucaoRegistral[]
  ocorrenciasRegistrais OcorrenciaDocumental[]
  evidenciasRegistrais  EvidenciaRegistral[]

  @@index([documentTypeId])
  @@index([necessidadeId])
  @@index([pessoaId])
  @@index([tipo])
  @@index([status])
  @@index([responsavelId])
  @@index([dataPrazoOperacao])
  @@index([ultimaMovimentacao])
  @@index([origem])
  @@index([ruleCode])
}

// Status = coluna/estado de TAREFA (domÃ­nio de Tarefa). NÃO representa fase de
// Processo â a fase do processo Ã© Processo.faseAtualKey (Workflow Macro/Interno).
// O legado Processo.statusId foi removido definitivamente.
model Status {
  id      Int      @id @default(autoincrement())
  nome    String   @db.VarChar(50)
  ordem   Int      @default(0)
  pais    String
  tarefas Tarefa[]

  @@unique([nome, pais])
  @@index([pais])
}

// ââ CodeGeneratorService â sequÃªncias de cÃ³digo pÃºblico (contador atÃ´mico, sem reuso) ââ
// 1 linha por escopo (prefixo): "IT","ES","DE","CLI","REC","CUS"... `ultimo` = Ãºltimo
// nÃºmero emitido. Incremento atÃ´mico (UPSERT + RETURNING), transacional, Ã  prova de
// concorrÃªncia. Excluir um registro NÃO decrementa â cÃ³digo nunca Ã© reutilizado.
model CodeSequence {
  id           Int      @id @default(autoincrement())
  scope        String   @unique @db.VarChar(40)
  ultimo       Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

model Processo {
  id                  Int                   @id @default(autoincrement())
  // CÃDIGO PÃBLICO (humano) gerado pelo CodeGeneratorService: IT-1, ES-1, DE-1...
  // (sequÃªncia por paÃ­s). UNIQUE, imutÃ¡vel, nunca reusado. O identificador tÃ©cnico segue id.
  codigo              String?               @unique @db.VarChar(20)
  nome                String                @db.VarChar(100)
  descricao           String?               @db.VarChar(500)
  observacoes         String?
  pais                String
  arvoreId            Int?
  familiaId           Int?
  dataInicio          DateTime              @default(now())
  previsaoTermino     DateTime?
  dataConclusao       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  percentualImposto   Decimal               @default(12.00) @db.Decimal(5, 2)
  anexos              AnexoProcesso[]
  counterRecibo       CounterRecibo?
  custos              Custo[]
  custosPessoa        CustoPessoa[]
  eventos             Evento[]
  faturas             Fatura[]
  informacaoItalia    InformacaoItalia?
  mensagens           Mensagem[]
  outrosCustos        OutroCusto[]
  arvore              Arvore?               @relation(fields: [arvoreId], references: [id])
  familia             Familia?              @relation(fields: [familiaId], references: [id], onDelete: SetNull)
  analise             AnaliseDocumental?
  faseAtualKey        String?
  contratantes        ProcessoContratante[]
  requerentes         ProcessoRequerente[]
  protocolos          Protocolo[]
  receitas            Receita[]
  recibos             Recibo[]
  tarefas             Tarefa[]
  tiposServico        TipoServico[]
  pastaTraducao       PastaTraducao?
  pastaApostilamento  PastaApostilamento?
  fasesFinais         FaseFinal[]
  retificacaoPacotes  RetificacaoPacote[]
  emissoesRetificadas EmissaoRetificada[]

  // CP-3 â necessidades documentais do processo
  necessidades NecessidadeDocumental[]

  // Runtime de workflow do processo. CUTOVER V2 CONCLUÃDO: todo processo NOVO
  // nasce "v2" (default). O campo permanece sÃ³ para leitura tÃ©cnica/histÃ³rica;
  // a UI comum nÃ£o cria processo legado e a API rejeita "legacy" vindo da interface.
  workflowRuntime          String                  @default("v2") @db.VarChar(20)
  lockVersion              Int                     @default(0) // CP-4F â CAS na mudanÃ§a de fase (v2)
  // CriaÃ§Ã£o V2-nativa: idempotÃªncia (evita processo duplicado em duplo clique/retry)
  // e snapshot imutÃ¡vel da versÃ£o do Workflow Macro aplicada no nascimento.
  chaveIdempotenciaCriacao String?                 @unique @db.VarChar(200)
  macroWorkflowVersion     Int?
  phaseWorkflowInstances   PhaseWorkflowInstance[]

  tipoProcessoMotorId   Int?
  tipoProcessoMotor     TipoProcessoNacionalidade? @relation("ProcessoTipoMotor", fields: [tipoProcessoMotorId], references: [id], onDelete: SetNull)
  // ENQUADRAMENTO LEGAL — recorte oficial sob o qual o processo é requerido.
  // O enquadramento já implica a modalidade legal e, por ela, o país: uma FK só
  // carrega as três dimensões, sem campo redundante que possa divergir.
  enquadramentoLegalId  Int?
  enquadramentoLegal    EnquadramentoLegal?        @relation(fields: [enquadramentoLegalId], references: [id], onDelete: SetNull)
  motorArtefatos        MotorArtefato[]            @relation("ProcessoMotorArtefatos")
  pendenciasFinanceiras PendenciaFinanceira[]      @relation("ProcessoPendenciasFinanceiras")

  // MRG - back-relations
  lotesRegistrais     LoteRegistral[]
  propostasRegistrais PropostaReconciliacao[]
  conflitosRegistrais ConflitoRegistral[]

  @@index([pais])
  @@index([arvoreId])
  @@index([familiaId])
  @@index([tipoProcessoMotorId])
  @@index([enquadramentoLegalId])
}

model ProcessoContratante {
  processoId    Int
  contratanteId Int
  contratante   Contratante @relation(fields: [contratanteId], references: [id], onDelete: Cascade)
  processo      Processo    @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@id([processoId, contratanteId])
}

model Tarefa {
  publicCode          String?           @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                  Int               @id @default(autoincrement())
  titulo              String            @db.VarChar(200)
  descricao           String?
  processoId          Int?
  statusId            Int?
  pais                String?
  responsavelId       Int?
  concluida           Boolean           @default(false)
  prioridade          PrioridadeTarefa  @default(MEDIA)
  dataPrazo           DateTime?
  dataConclusao       DateTime?
  tarefaPaiId         Int?
  ordem               Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  dataInicio          DateTime?
  observacoes         String?
  tipoSubtarefa       String?           @db.VarChar(20)
  prazoCobranca       Int?              @default(5)
  motivoConclusao     String?           @db.VarChar(50)
  quantidadeCobrancas Int               @default(0)
  statusTarefa        StatusTarefa      @default(NAO_INICIADA)
  ultimaCobranca      DateTime?
  processo            Processo?         @relation(fields: [processoId], references: [id], onDelete: Cascade)
  responsavel         Usuario?          @relation(fields: [responsavelId], references: [id])
  status              Status?           @relation(fields: [statusId], references: [id])
  tarefaPai           Tarefa?           @relation("Subtarefas", fields: [tarefaPaiId], references: [id], onDelete: Cascade)
  subtarefas          Tarefa[]          @relation("Subtarefas")
  historico           TarefaHistorico[]

  // CP-4A â vÃ­nculos aditivos (nullable) com o runtime de workflow v2.
  workflowInstanceId     Int?
  workflowInstance       PhaseWorkflowInstance?     @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  workflowStepInstanceId Int?
  workflowStepInstance   PhaseWorkflowStepInstance? @relation(fields: [workflowStepInstanceId], references: [id], onDelete: SetNull)
  necessidadeId          Int?
  necessidade            NecessidadeDocumental?     @relation("TarefaNecessidade", fields: [necessidadeId], references: [id], onDelete: SetNull)
  documentoId            Int?
  documento              Documento?                 @relation("TarefaDocumento", fields: [documentoId], references: [id], onDelete: SetNull)
  faseMacroKey           String?                    @db.VarChar(60)
  origem                 String?                    @db.VarChar(20)
  chaveIdempotencia      String?                    @unique @db.VarChar(200)
  ciclo                  Int?
  taskRole               String?                    @db.VarChar(40)
  correlationId          String?                    @db.VarChar(60)
  previousTarefaId       Int?
  previousTarefa         Tarefa?                    @relation("TarefaSupersessao", fields: [previousTarefaId], references: [id], onDelete: SetNull)
  supersededByTarefas    Tarefa[]                   @relation("TarefaSupersessao")

  // CP-4D â sincronizaÃ§Ã£o TarefaâPasso (CAS otimista, executor, motivo, restauraÃ§Ã£o).
  lockVersion           Int     @default(0)
  executedById          Int? // quem concluiu (executor) â segregaÃ§Ã£o executorâ aprovador
  blockedPreviousStatus String? @db.VarChar(30) // estado da Tarefa antes de BLOQUEADA (restauraÃ§Ã£o)
  motivoCodigo          String? @db.VarChar(40)
  justificativa         String? @db.Text

  // TAREFA TRANSVERSAL (aditivo) â aÃ§Ã£o antecipada de OUTRA fase p/ resolver uma necessidade
  // da fase ATUAL, sem avanÃ§ar o Macro. Refs "soltas" (padrÃ£o executedById): sem relation
  // p/ nÃ£o tocar outros models; os serviÃ§os resolvem os vÃ­nculos. necessidadeId/documentoId/
  // responsavelId/statusTarefa/dataPrazo/dataConclusao/createdAt/updatedAt jÃ¡ existem acima.
  tipo                     TipoTarefa @default(NORMAL)
  faseOrigemCode           String?    @db.VarChar(60) // fase ATIVA onde foi criada
  faseReferenciaCode       String?    @db.VarChar(60) // fase Ã  qual a AÃÃO pertence
