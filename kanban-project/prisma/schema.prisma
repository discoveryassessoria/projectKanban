  name                    String                    @db.VarChar(200)
  category                String?                   @db.VarChar(30) // civil_registry|identity|judicial|consular|translation|apostille|other
  ativo                   Boolean                   @default(true)
  criadoEm                DateTime                  @default(now())
  atualizadoEm            DateTime                  @updatedAt
  itemCatalogoId          Int?
  itemCatalogo            ItemCatalogo?             @relation(fields: [itemCatalogoId], references: [id])
  legacyEnumKey           String?                   @unique @db.VarChar(60) // â valor do enum TipoDocumento (ponte)
  nature                  String?                   @db.VarChar(30) // documento|certidao|identidade|... (config futura)
  countryCode             String?                   @db.VarChar(8) // opcional (paÃ­s)
  description             String?                   @db.Text
  documentos              Documento[] // back-relation (docs que apontam pra este tipo)
  // EMISSAO DOCUMENTAL - o tipo mestre CLASSIFICA arquivos operacionais (ex.: DOC21
  // "Requerimento inteiro teor" e o tipo do arquivo enviado ao cartorio) e aparece
  // nas exigencias de evidencia das etapas. Sempre por ID; nunca por nome/rotulo.
  arquivosClassificados   DocumentoArquivo[]        @relation("ArquivoTipoMestre")
  exigenciasComoAlvo      ExigenciaEvidenciaEtapa[] @relation("ExigenciaDocumentoOperacional")
  exigenciasComoEvidencia ExigenciaEvidenciaEtapa[] @relation("ExigenciaEvidenciaMestre")
  /// Requisitos de evidência que apontam para ESTE tipo mestre (ver StepRequirement).
  requisitosComoEvidencia StepRequirement[]         @relation("RequisitoEvidenciaMestre")
  configFinanceiras       ProdutoFinanceiro[]       @relation("ConfigFinTipoDocumento")
  econRules               PhaseEconomicRule[]       @relation("EconTipoDocumento")
  participaPlanilha       Boolean                   @default(false)
  colunaPlanilha          PlanilhaDocumentalColuna? @relation("ColunaPlanilhaTipoDoc")
  overridesPlanilha       PlanilhaCelulaOverride[]  @relation("OverrideTipoDoc")
  // LOTE A â categoriaDocumentalId Ã© a CLASSIFICAÃÃO CANÃNICA (consumida por ID).
  // FK nullable p/ backfill seguro. A coluna `category` (String) permanece SÃ como
  // compatibilidade transitÃ³ria (dual-read/dual-write). NÃ£o remover neste lote.
  // onDelete: Restrict â a API jÃ¡ proÃ­be excluir categoria em uso; a FK impede
  // desclassificaÃ§Ã£o silenciosa via SQL cru (alinha DB e regra de negÃ³cio).
  categoriaDocumentalId   Int?
  categoriaDocumental     CategoriaDocumental?      @relation(fields: [categoriaDocumentalId], references: [id], onDelete: Restrict)

  // ── CONTRATO OPERACIONAL ───────────────────────────────────────────────────
  // Categoria diz ONDE o documento se arquiva. Estes três dizem COMO ele opera:
  // o que ele é (familia), como entra (natureza) e qual workflow o processa
  // (perfil). Nullable porque a classificação é gradual — documento sem perfil
  // continua sendo anexável; o que ele não faz é materializar workflow.
  familiaDocumentalId   Int?
  familiaDocumental     FamiliaDocumental?            @relation(fields: [familiaDocumentalId], references: [id], onDelete: SetNull)
  naturezaOperacionalId Int?
  naturezaOperacional   NaturezaOperacionalDocumento? @relation(fields: [naturezaOperacionalId], references: [id], onDelete: SetNull)
  perfilOperacionalId   Int?
  perfilOperacional     PerfilOperacionalDocumento?   @relation(fields: [perfilOperacionalId], references: [id], onDelete: SetNull)

  // REPOSITÓRIO DE MODELOS — o tipo mestre é o QUE o modelo produz (por ID).
  modelosDocumentais ModeloDocumental[] @relation("ModeloTipoDocumento")
  documentosGerados  DocumentoGerado[]  @relation("DocumentoGeradoTipo")
  regrasDocumentais  MatrizDocumental[] @relation("MatrizTipoCanonico")

  @@index([itemCatalogoId])
  @@index([categoriaDocumentalId])
  @@index([familiaDocumentalId])
  @@index([naturezaOperacionalId])
  @@index([perfilOperacionalId])
}

// ════════════════════════════════════════════════════════════════════════════
// CONTRATO DOCUMENTAL — o Cadastro Mestre passa a declarar COMO o documento é
// processado, e o Workflow Interno passa a declarar SOBRE O QUE ele executa.
//
// O QUE ESTAVA IMPLÍCITO
// ----------------------
// O Workflow Interno sabia apenas a que FASE pertencia. Que "Emissão Documental"
// executa uma vez por DOCUMENTO era conhecimento do código (o escopo canônico da
// fase, em fases-catalog), não do cadastro. Consequência: nada impedia passo
// documental sem documento, tarefa documental sem documento, ou workflow
// aplicado a tipo documental incompatível — os estados inválidos eram possíveis
// porque o contrato não existia para ser violado.
//
// A DIMENSÃO DE ESCOPO NÃO VIRA CADASTRO
// --------------------------------------
// PROCESSO/PESSOA/NECESSIDADE/DOCUMENTO é dimensão FECHADA de domínio — mesma
// natureza de TipoArquivoDocumento e CanalSolicitacaoDocumento: não tem atributo
// próprio administrável, só identidade. E já existe como tipo canônico único no
// motor (`Cardinalidade`, em phase-workflow-helpers). Virar cadastro mestre
// criaria uma SEGUNDA fonte para o que o motor já resolve. Família, Natureza
// Operacional e Perfil, ao contrário, têm atributos administráveis — esses são
// cadastro.

/// Escopo sobre o qual uma execução acontece. Espelha `Cardinalidade` do motor.
enum EscopoExecucao {
  PROCESSO
  PESSOA
  NECESSIDADE
  DOCUMENTO
}

/// FAMILIA DOCUMENTAL — o que o documento E, em grupo operacional (Certidao de
/// Registro Civil, Documento de Identidade, Procuracao, Requerimento...).
/// Eixo DISTINTO de CategoriaDocumental (classificacao administrativa): a familia
/// diz como o documento se comporta na operacao, nao onde ele e arquivado.
model FamiliaDocumental {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  descricao String?  @db.Text
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  /// Familia de bootstrap: code imutavel, nao excluivel.
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipos     TipoDocumentoCadastro[]
  perfis    PerfilOperacionalDocumento[]
  workflows PhaseInternalWorkflow[]
}

/// NATUREZA OPERACIONAL — COMO o documento entra na operacao (obtido de terceiro,
/// gerado pelo sistema, recebido do cliente, evidencia de etapa...).
/// `exigeWorkflow` separa documento que se PROCESSA de documento que so se anexa:
/// e a regra que o guard administrativo cobra.
model NaturezaOperacionalDocumento {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(40)
  name          String   @db.VarChar(120)
  descricao     String?  @db.Text
  /// true = documento desta natureza precisa de perfil operacional.
  exigeWorkflow Boolean  @default(false)
  ordem         Int      @default(0)
  ativo         Boolean  @default(true)
  sistema       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tipos           TipoDocumentoCadastro[]
  fasesQueAceitam FaseNaturezaPermitida[]
}

/// PERFIL OPERACIONAL — a ponte entre o Cadastro Mestre e o Workflow publicado.
