model RetificacaoPacote {
  id             Int           @id @default(autoincrement())
  processoId     Int
  processo       Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  num            String // PR-001
  /// MODO do procedimento. ANULAVEL: o pedido pode ser aberto (agrupando as
  /// divergencias que vao juntas) antes de alguem decidir se o caminho e judicial ou
  /// administrativo — que e exatamente o que o passo "Definir modo" resolve.
  tipo           String? // judicial | administrativa
  status         String        @default("em_preparacao") // em_preparacao|protocolado|em_exigencia|decisao_recebida|validado|bloqueado
  currentStep    String        @default("definir_estrategia")
  motivo         String?
  prioridade     String?       @default("MÃ©dia")
  proxAcao       String?
  /// PROFISSIONAL RESPONSAVEL pelo procedimento, quando houver. Referencia, nunca
  /// nome copiado: renomear o cadastro aparece aqui sem regravar execucao nenhuma.
  profissionalId Int?
  profissional   Profissional? @relation("ProfissionalDaRetificacao", fields: [profissionalId], references: [id], onDelete: SetNull)

  // Judicial
  /// NUMERO DO PROCESSO JUDICIAL (CNJ ou equivalente). Vive AQUI porque o pacote E o
  /// procedimento independente de retificacao — nao ha entidade "processo judicial"
  /// no sistema, e criar uma vazia para guardar uma string seria estrutura sem dono.
  /// Nao e protocolo: protocolo e o comprovante de entrada, este e a identidade da
  /// acao no tribunal, e eles nem sempre coincidem.
  processoNum   String?
  /// ─── LEGADO TEXTUAL — PRESERVADO, NAO ESCRITO ──────────────────────────
  /// Os campos abaixo sao da tela anterior. Continuam existindo porque apagar coluna
  /// e apagar o que ja foi digitado; nenhum caminho canonico escreve neles, e cada um
  /// tem hoje um dono de verdade:
  ///
  ///   tribunal, cartorio → `orgaoId` (Orgaos e Organizacoes). 11 tribunais e 241
  ///                        organizacoes ja cadastrados; texto congelaria o nome.
  ///   comarca            → atributo territorial do orgao referenciado
  ///                        (`city`/`state`/`provincia`), lido de la.
  ///   vara               → `Protocolo.setor`, que ja se chama "setor/guiche dentro
  ///                        do orgao". Vara, oficio e guiche sao a mesma pergunta.
  ///   advogado, oab      → `profissionalId` → `Profissional` + `RegistroProfissional`.
  ///                        OAB e um VALOR de `tipo`, com numero e jurisdicao proprios.
  ///   protocolo,
  ///   dataProtocolo      → `protocoloId` → `Protocolo`.
  ///   prazo              → prazo da etapa, herdado da fase.
  tribunal      String?
  vara          String?
  comarca       String?
  advogado      String?
  oab           String?
  statusProc    String?
  // Administrativa
  cartorio      String?
  canal         String?
  protocolo     String?
  dataProtocolo String?
  atendente     String?
  prazo         String?
  statusAdm     String?
  /// ORGAO que recebe o pedido. FONTE UNICA: Orgaos e Organizacoes. Substitui o
  /// campo `cartorio` (texto), que ficava congelado no dia em que a organizacao
  /// mudasse de nome. `cartorio` segue existindo para nao apagar historico.
  orgaoId       Int?
  orgao         OrgaoProtocolo? @relation("OrgaoDaRetificacao", fields: [orgaoId], references: [id], onDelete: SetNull)
  /// PROTOCOLO canonico do pedido. Substitui os campos `protocolo`/`dataProtocolo`
  /// (texto), pela mesma razao: o protocolo tem dono.
  protocoloId   Int?
  protocoloRef  Protocolo?      @relation("ProtocoloDaRetificacao", fields: [protocoloId], references: [id], onDelete: SetNull)

  /// AS DIVERGENCIAS DESTE PACOTE, por vinculo real. O campo `divergenceIds` (Json)
  /// era um snapshot: nao havia como perguntar ao banco quais pacotes tratam uma
  /// divergencia, nem impedir que a mesma entrasse em dois pedidos.
  divergencias RetificacaoPacoteDivergencia[]
  /// As instancias de passo ancoradas NESTE pacote. E o que da isolamento: reabrir
  /// um pacote nao toca no outro porque sao instancias diferentes.
  passos       PhaseWorkflowStepInstance[]    @relation("PassosDaRetificacao")

  // VariÃ¡veis (Json)
  workflow       Json? // 6 passos RET_STEPS
  /// LEGADO: snapshot textual das divergencias. Preservado; a verdade e `divergencias`.
  divergenceIds  Json? // divergÃªncias vinculadas (snapshot)
  affectedDocIds Json? // documentos afetados (snapshot)
  movements      Json? // [{data,tipo,desc,resp,prox}]
  attachments    Json? // [{nome,cat,data,por,obs}]
  validacao      Json? // {ressalva, obs, ...}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([processoId, num])
  @@index([processoId])
  @@index([orgaoId])
  @@index([protocoloId])
}

/// UMA DIVERGENCIA DENTRO DE UM PACOTE DE RETIFICACAO.
///
/// A unicidade e o ponto: a mesma divergencia nao pode estar em dois pedidos abertos
/// ao mesmo tempo sem que alguem tenha decidido isso. Como snapshot Json, nada
/// impedia — e nada conseguia responder "esta divergencia ja esta sendo tratada?".
model RetificacaoPacoteDivergencia {
  id            Int               @id @default(autoincrement())
  pacoteId      Int
  pacote        RetificacaoPacote @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  divergenciaId Int
  divergencia   Divergencia       @relation(fields: [divergenciaId], references: [id], onDelete: Cascade)
  criadoEm      DateTime          @default(now())

  @@unique([pacoteId, divergenciaId])
  @@index([divergenciaId])
}

/// UMA PESSOA QUE EXERCE PROFISSAO REGULAMENTADA e atua nos processos.
///
/// NAO e `Pessoa` — aquela e o individuo da arvore genealogica, com data de obito e
/// batismo; um advogado nao e ancestral de ninguem. NAO e `Usuario` — aquele tem
/// e-mail unico e perfil de acesso, e criar conta de login para um advogado externo
/// daria a ele o sistema inteiro. NAO e `OrgaoProtocolo` — organizacao e pessoa
/// juridica; o escritorio e uma, o advogado e outra, e confundi-los faz o registro
/// profissional virar atributo de empresa.
///
/// O ESCOPO E MINIMO DE PROPOSITO: identidade, categoria, vinculo opcional com a
/// organizacao onde atua, e os registros de classe. Nao ha agenda, honorario,
/// disponibilidade nem carteira de clientes — o sistema nao precisa disso hoje, e
/// modelo grande vazio e pior que modelo pequeno.
model Profissional {
  id            Int                   @id @default(autoincrement())
  nome          String                @db.VarChar(200)
  /// A PROFISSAO, pelo cadastro. Acrescentar uma nao pede deploy: pede um registro
  /// em Profissionais > Categorias.
  categoriaId   Int
  categoria     CategoriaProfissional @relation(fields: [categoriaId], references: [id])
  email         String?               @db.VarChar(200)
  telefone      String?               @db.VarChar(60)
  /// ESCRITORIO/EMPRESA onde atua, quando houver. Opcional: profissional autonomo
  /// existe, e exigir organizacao obrigaria a inventar uma para ele.
  organizacaoId Int?
  organizacao   OrgaoProtocolo?       @relation("ProfissionaisDaOrganizacao", fields: [organizacaoId], references: [id], onDelete: SetNull)
  observacoes   String?               @db.Text
  ativo         Boolean               @default(true)
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt

  registros    RegistroProfissional[]
  retificacoes RetificacaoPacote[]    @relation("ProfissionalDaRetificacao")

  @@index([categoriaId])
  @@index([organizacaoId])
  @@index([ativo])
}

/// A INSCRICAO NUM CONSELHO DE CLASSE.
///
/// Fica em tabela propria, e nao em colunas de `Profissional`, por duas razoes que
/// aparecem no primeiro caso real: o mesmo advogado pode ter OAB em mais de uma UF, e
/// um tradutor juramentado tem matricula na Junta Comercial — outro tipo de registro,
/// com outra jurisdicao. Tres colunas (`oab`, `oabUf`, ...) resolveriam OAB e
/// travariam tudo o mais.
///
/// `tipo` e vocabulario ABERTO. "OAB" nao e estrutura: e um valor.
model RegistroProfissional {
  id              Int             @id @default(autoincrement())
  profissionalId  Int
  profissional    Profissional    @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  /// OAB | CRC | CREA | JUCESP | ... — o conselho, como valor.
  tipo            String          @db.VarChar(20)
  numero          String          @db.VarChar(40)
  /// UF, pais ou circunscricao em que o registro vale.
  jurisdicao      String?         @db.VarChar(40)
  /// Orgao de classe, quando ele estiver cadastrado em Orgaos e Organizacoes.
  orgaoDeClasseId Int?
  orgaoDeClasse   OrgaoProtocolo? @relation("RegistrosDoOrgaoDeClasse", fields: [orgaoDeClasseId], references: [id], onDelete: SetNull)
  ativo           Boolean         @default(true)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  /// A MESMA INSCRICAO NAO SE REPETE. "OAB 123456 SP" identifica uma pessoa so.
  @@unique([tipo, numero, jurisdicao])
  @@index([profissionalId])
}

