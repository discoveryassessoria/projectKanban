  adquirenteId         Int? // â Adquirente.id
  bandeiraId           Int? // â Bandeira.id
  // IdempotÃªncia da criaÃ§Ã£o: mesma chave nunca gera duas cobranÃ§as (retry seguro).
  idempotencyKey       String?   @unique @db.VarChar(80)
  obrigacaoId          Int? // → ObrigacaoEconomica (motor V3, aditivo)

