// CatÃ¡logo das fases (building blocks do workflow)
/// POLÍTICA DOCUMENTAL DA FASE — quais NATUREZAS a fase materializa.
///
/// Substitui a premissa histórica "Genealogia só aceita certidão", que vivia em
/// código. Qual documento entra numa fase deixa de ser decidido por natureza
/// escrita no motor e passa a ser CADASTRO: a fase declara as naturezas que
/// aceita, o Tipo de Documento declara a sua, e a materialização compara IDs.
/// Nenhum código DOC, nenhum nome, nenhum substring.
model FaseNaturezaPermitida {
  id                    Int                          @id @default(autoincrement())
  catalogoFaseId        Int
  catalogoFase          CatalogoFase                 @relation(fields: [catalogoFaseId], references: [id], onDelete: Cascade)
  naturezaOperacionalId Int
  naturezaOperacional   NaturezaOperacionalDocumento @relation(fields: [naturezaOperacionalId], references: [id], onDelete: Restrict)
  ativo                 Boolean                      @default(true)
  criadoEm              DateTime                     @default(now())
  atualizadoEm          DateTime                     @updatedAt

  @@unique([catalogoFaseId, naturezaOperacionalId])
  @@index([catalogoFaseId])
}

model CatalogoFase {
  id                Int             @id @default(autoincrement())
  phaseKey          String          @unique @db.VarChar(60)
  label             String          @db.VarChar(120)
  /// O QUE A FASE É, em texto do operador. Não participa de nenhuma decisão.
  descricao         String?         @db.Text
  /// SOBRE O QUE A FASE OPERA — processo, pessoa, necessidade ou documento.
  ///
  /// É o que a materialização usa para decidir sobre quantas entidades os passos se
  /// multiplicam: uma fase DOCUMENTO gera um roteiro por certidão; uma fase PROCESSO
  /// gera um só. Enquanto isso vivia apenas no catálogo em código, nenhuma fase nova
  /// podia declarar o próprio escopo — nascia PROCESSO por omissão, sem que ninguém
  /// tivesse escolhido. `null` = fase ainda não utilizável (o cadastro recusa usá-la).
  escopo            EscopoExecucao?
  /// ORDEM PADRÃO — só o valor sugerido ao semear um macrofluxo novo. A ordem REAL de
  /// uma fase pertence ao workflow que a usa (`FaseMacro.ordem`): a mesma fase pode
  /// ser a terceira num fluxo e a quarta noutro.
  ordemPadrao       Int             @default(0)
  requiredPadrao    Boolean         @default(true)
  conditionalPadrao Boolean         @default(false)
  slaDiasPadrao     Int             @default(30)
  ativo             Boolean         @default(true)
  /// COMPETÊNCIA DA FASE — quais efeitos os passos desta fase podem executar.
  ///
  /// Emissão Documental mandava o processo para Retificação a partir de um resultado
  /// escolhido no executor: quem decide retificação é a Análise, e a decisão vazava
  /// para a fase anterior sem que nada no cadastro dissesse que podia. Lista de
  /// `effectKey`; `null` = sem restrição declarada (compatibilidade com o existente).
  efeitosPermitidos Json?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  naturezasPermitidas FaseNaturezaPermitida[]

  /// QUEM CONDUZ ESTA FASE: o Workflow Interno, ou a tela anterior a ele.
  ///
  /// Seis fases têm tela própria, escrita antes do motor existir, com maquina de
  /// estados em JSON. Elas avisam o motor de que terminaram concluindo À FORÇA todos
  /// os passos obrigatórios — sem requisito, sem campo, sem ação. Enquanto o motor não
  /// conduz a fase, isso é o certo; depois, vira o oposto.
  ///
  /// NÃO SE INFERE da existência de cadastro publicado. Medido em 24/08/2026:
  /// `analise_documental` tinha 5/5 passos com cadastro publicado e 15 tentativas
  /// com ZERO ações canônicas executadas — o cadastro existia, a operação nunca
  /// migrou. Derivar "tem cadastro logo assumiu" teria desligado a Análise.
  ///
  /// Trocar de motor é DECISÃO de quem administra, tomada quando a operação estiver
  /// pronta. Nasce `false`: nada muda para ninguém até alguém dizer que mudou.
  conduzidaPeloWorkflowInterno Boolean @default(false)
}

// Workflow Macro â 1:1 com o tipo de processo
model MacroWorkflow {
  id             Int                       @id @default(autoincrement())
  tipoProcessoId Int                       @unique
  tipoProcesso   TipoProcessoNacionalidade @relation(fields: [tipoProcessoId], references: [id], onDelete: Cascade)
  name           String                    @db.VarChar(200)
  ativo          Boolean                   @default(true)
  versao         Int                       @default(1) // CP-4A â versionamento
  criadoEm       DateTime                  @default(now())
  atualizadoEm   DateTime                  @updatedAt
  fases          FaseMacro[]
}

// Fases do workflow (a coluna variÃ¡vel)
model FaseMacro {
  id              Int           @id @default(autoincrement())
  macroWorkflowId Int
  macroWorkflow   MacroWorkflow @relation(fields: [macroWorkflowId], references: [id], onDelete: Cascade)
  phaseKey        String        @db.VarChar(60)
