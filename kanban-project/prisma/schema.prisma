  comprovanteUrl  String?
  comprovanteNome String?         @db.VarChar(200)
  observacoes     String?
  // Parcela de ENTRADA definida pela CondiÃ§Ã£o de Pagamento.
  entrada         Boolean         @default(false)
  valorTaxa       Decimal?        @db.Decimal(12, 2)
  valorLiquido    Decimal?        @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
