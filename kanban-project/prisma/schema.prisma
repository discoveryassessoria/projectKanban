/// Quem efetivamente pagou (independe da distribuiÃ§Ã£o).
model Pagador {
  id             Int      @id @default(autoincrement())
  tipo           String   @db.VarChar(12) // REQUERENTE|EMPRESA|TERCEIRO|EXTERNO
  pessoaId       Int?
  parteExternaId Int?
  criadoEm       DateTime @default(now())
}

/// Parte externa (pagador/terceiro fora do cadastro de Pessoas).
model ParteExterna {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(160)
  documento  String?  @db.VarChar(40)
  tipo       String?  @db.VarChar(4) // PF|PJ
  observacao String?  @db.Text
  processoId Int?
  ativo      Boolean  @default(true)
