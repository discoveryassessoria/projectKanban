// ============================================================================
// MDM-5 â NOMES ALTERNATIVOS (aliases)
// ============================================================================
// Uma pessoa tem vÃ¡rias formas de nome: registral, de nascimento, de casada,
// religioso, a grafia que aparece na certidÃ£o, o aportuguesado. Todas precisam
// ser pesquisÃ¡veis, e a forma antiga nÃ£o pode se perder quando o principal muda.
//
// NÃ£o Ã© cÃ³pia do Cadastro Mestre: Ã© INVERSÃO DE FONTE. NomePessoa passa a ser
// o dono do nome e Pessoa.nome/sobrenome viram projeÃ§Ã£o do principal (fase 3).
//
// Carrega os seis campos de afirmaÃ§Ã£o auditÃ¡vel (complemento 2): origem,
// confianÃ§a, responsÃ¡vel, data da afirmaÃ§Ã£o, justificativa e evidÃªncia.
model NomePessoa {
  id       Int    @id @default(autoincrement())
  pessoaId Int
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  nome      String  @db.VarChar(50)
  sobrenome String? @db.VarChar(40)

  // REGISTRAL | NASCIMENTO | CASADA | RELIGIOSO | GRAFIA_DOCUMENTO | APORTUGUESADO | IMPORTADO
  tipo      String  @db.VarChar(20)
  principal Boolean @default(false)

  // Chave fonÃ©tica DERIVADA (motor/texto.ts) â nunca editÃ¡vel. Indexada porque
  // Ã© o que faz a busca achar Bianqui procurando Bianchi.
  chaveFonetica String? @db.VarChar(60)

  // ---- afirmaÃ§Ã£o auditÃ¡vel (complemento 2) ----
  origem                 String                 @db.VarChar(16)
  confianca              String                 @db.VarChar(12)
  responsavelId          Int?
  responsavel            Usuario?               @relation("NomePessoaResponsavel", fields: [responsavelId], references: [id])
  afirmadoEm             DateTime               @default(now())
  justificativa          String?                @db.VarChar(300)
  evidenciaNecessidadeId Int?
  evidencia              NecessidadeDocumental? @relation(fields: [evidenciaNecessidadeId], references: [id], onDelete: SetNull)

  // ---- histÃ³rico append-only ----
  ativo            Boolean     @default(true)
  supersedidoPorId Int?        @unique
  supersedidoPor   NomePessoa? @relation("NomeSupersessao", fields: [supersedidoPorId], references: [id], onDelete: SetNull)
  supersede        NomePessoa? @relation("NomeSupersessao")

  chaveIdempotencia String   @unique @db.VarChar(200)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([pessoaId])
  @@index([chaveFonetica])
  @@index([pessoaId, principal])
}

// ============================================================================
// MDM-3 â DECISÃO DE DEDUPLICAÃÃO
// ============================================================================
// Registro auditÃ¡vel de CADA criaÃ§Ã£o de Pessoa que passou por triagem. Guarda
// os candidatos EXIBIDOS e o score de cada um: sem isso nÃ£o hÃ¡ como distinguir
// erro humano de falha do algoritmo de similaridade quando uma duplicata entra.
model DecisaoDeduplicacao {
  id         Int    @id @default(autoincrement())
  chaveDedup String @db.VarChar(200)

  // Snapshot IMUTÃVEL do que foi apresentado ao operador (ids + scores +
  // evidÃªncias). Mesmo padrÃ£o de NecessidadeDocumental.matrizSnapshot.
  candidatosAvaliados Json
  nivelTriagem        String @db.VarChar(14) // BLOQUEIO | CONFIRMACAO | INFORMATIVO | LIVRE

  decisao            String  @db.VarChar(20) // CRIOU_NOVA | VINCULOU_EXISTENTE
  pessoaResultanteId Int?
  pessoaResultante   Pessoa? @relation("PessoaDecisaoDedup", fields: [pessoaResultanteId], references: [id], onDelete: SetNull)
  justificativa      String? @db.VarChar(500)

  decididoPorId Int?
  decididoPor   Usuario? @relation("DecisaoDedupResponsavel", fields: [decididoPorId], references: [id])
  decididoEm    DateTime @default(now())

  chaveIdempotencia String                      @unique @db.VarChar(200)
  correspondencias  CorrespondenciaIdentidade[] @relation("DedupCorrespondencia")

  @@index([chaveDedup])
  @@index([pessoaResultanteId])
  @@index([decididoEm])
}

// ############################################################################
// MRG — MOTOR REGISTRAL GENEALOGICO
// ############################################################################
//
// O que este bloco NAO faz (regra de escopo permanente, verificada por teste):
//   · nao armazena arquivo, nao copia Documento, nao cria pasta paralela;
//   · nao tem status documental proprio — quem decide status de documento e de
//     necessidade continua sendo o Sistema Documental (Documento,
//     NecessidadeDocumental, ItemCatalogo);
//   · nao substitui Pessoa/Uniao como estrutura: paiId/maeId e Uniao seguem
//     sendo a UNICA fonte da estrutura genealogica. FatoRegistral e a
//     AFIRMACAO auditavel sobre essa estrutura, nunca uma segunda estrutura.
//
// O que ele acrescenta: o rastro completo entre "chegou uma certidao" e
// "a arvore mudou" — pipeline, ocorrencias, evidencias, fatos, identidade,
// conflitos, propostas, impacto, versao e decisao humana.
//
// Reuso deliberado, para nao duplicar dominio:
//   · aliases de nome            -> NomePessoa (MDM-5)
//   · triagem de duplicidade     -> DecisaoDeduplicacao (MDM-3) + lib/cadastro-mestre/dedup
//   · fila assincrona            -> DomainOutbox (claim atomico ja existente)
//   · auditoria                  -> LogAuditoria
//   · permissoes                 -> Perfil/Usuario.permissoesCustom
// ############################################################################

