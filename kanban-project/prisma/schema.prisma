model Tarefa {
  publicCode          String?           @unique @db.VarChar(20) // CodeGeneratorService central â aditivo, Ãºnico, nÃ£o editÃ¡vel
  id                  Int               @id @default(autoincrement())
  titulo              String            @db.VarChar(200)
  descricao           String?
  processoId          Int?
  statusId            Int?
  pais                String?
  responsavelId       Int?
  concluida           Boolean           @default(false)
  prioridade          PrioridadeTarefa  @default(MEDIA)
  dataPrazo           DateTime?
  dataConclusao       DateTime?
  ordem               Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  dataInicio          DateTime?
  observacoes         String?
  prazoCobranca       Int?              @default(5)
  motivoConclusao     String?           @db.VarChar(50)
  quantidadeCobrancas Int               @default(0)
  statusTarefa        StatusTarefa      @default(NAO_INICIADA)
  ultimaCobranca      DateTime?
  processo            Processo?         @relation(fields: [processoId], references: [id], onDelete: Cascade)
  responsavel         Usuario?          @relation(fields: [responsavelId], references: [id])
  status              Status?           @relation(fields: [statusId], references: [id])
  historico           TarefaHistorico[]

  // CP-4A â vÃ­nculos aditivos (nullable) com o runtime de workflow v2.
  // ── A TAREFA É DONA DO SEU TRABALHO, NÃO DA INSTÂNCIA DA FASE ─────────────
  // UMA unidade de trabalho = UMA Tarefa = N etapas.
  //
  // Este campo já foi `@unique`, com a intenção certa e o alvo errado: a ideia
  // era impedir que sete passos virassem sete tarefas. Mas a instância do
  // workflow é da FASE — uma só por (processo, fase, ciclo) —, e os passos de
  // TODOS os documentos daquela fase vivem dentro dela. Com o `@unique`, uma
  // Emissão Documental com dois documentos era estruturalmente impossível: a
  // segunda tarefa não conseguia nascer.
  //
  // O que garante "etapa não é tarefa" é a IDENTIDADE da tarefa
  // (`chaveIdempotencia @unique`, derivada da obrigação — necessidade/documento
  // /pessoa/ciclo), não a exclusividade da instância. Dez passos de um
  // documento convergem para uma chave; dois documentos são duas chaves.
  workflowInstanceId     Int?
  workflowInstance       PhaseWorkflowInstance?     @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  // A ETAPA CORRENTE é PROJEÇÃO, não identidade. Ela muda sete vezes durante a
  // vida da tarefa, e a tarefa continua a mesma. Nada pode ancorar aqui.
  workflowStepInstanceId Int?
  workflowStepInstance   PhaseWorkflowStepInstance? @relation(fields: [workflowStepInstanceId], references: [id], onDelete: SetNull)
  necessidadeId          Int?
  necessidade            NecessidadeDocumental?     @relation("TarefaNecessidade", fields: [necessidadeId], references: [id], onDelete: SetNull)
  documentoId            Int?
  documento              Documento?                 @relation("TarefaDocumento", fields: [documentoId], references: [id], onDelete: SetNull)
  // ── FILA E ATRIBUIÇÃO ──────────────────────────────────────────────────────
  // EQUIPE responde pela fila e pela capacidade; RESPONSÁVEL é quem executa.
  // Uma tarefa pode nascer só com equipe (`responsavelId` nulo) e esperar
  // distribuição — é o estado "na fila", e ele não é uma tarefa diferente.
  //
  // `equipeKey` é texto porque NÃO EXISTE cadastro de Equipe no sistema: hoje a
  // equipe vive como `papel` no passo ("equipe_documental"). Criar o cadastro é
  // decisão de negócio pendente; até lá a chave é a mesma que o passo declara,
  // e migrar para FK depois é trocar o tipo de UMA coluna.
  equipeKey              String?                    @db.VarChar(80)
  dataAtribuicao         DateTime?
  atribuidoPorId         Int?

  faseMacroKey        String?  @db.VarChar(60)
  origem              String?  @db.VarChar(20)
  chaveIdempotencia   String?  @unique @db.VarChar(200)
  ciclo               Int?
  taskRole            String?  @db.VarChar(40)
  correlationId       String?  @db.VarChar(60)
  previousTarefaId    Int?
  previousTarefa      Tarefa?  @relation("TarefaSupersessao", fields: [previousTarefaId], references: [id], onDelete: SetNull)
  supersededByTarefas Tarefa[] @relation("TarefaSupersessao")

  // CP-4D â sincronizaÃ§Ã£o TarefaâPasso (CAS otimista, executor, motivo, restauraÃ§Ã£o).
  lockVersion           Int     @default(0)
  executedById          Int? // quem concluiu (executor) â segregaÃ§Ã£o executorâ aprovador
  blockedPreviousStatus String? @db.VarChar(30) // estado da Tarefa antes de BLOQUEADA (restauraÃ§Ã£o)
  motivoCodigo          String? @db.VarChar(40)
  justificativa         String? @db.Text

  // ── ESPERA EXTERNA E O RELÓGIO DO SLA ──────────────────────────────────────
  // Nem toda espera pausa o prazo, e presumir qualquer um dos dois lados
  // globalmente seria inventar política de negócio: um cartório que demora 40
  // dias não pode consumir um SLA de 5, e uma espera por resposta do cliente
  // frequentemente DEVE contar. Quem decide é o workflow publicado
  // (`pausarSlaEmEsperaExterna`); estes campos só guardam o que já aconteceu.
  slaPausadoEm         DateTime?
  slaPausaAcumuladaMin Int       @default(0)

  // ── CAUSA REMOVIDA ─────────────────────────────────────────────────────────
  // A obrigação que originou o trabalho deixou de existir DEPOIS que alguém já
  // trabalhou nela. Cancelar sozinho jogaria fora trabalho feito; ignorar
  // deixaria a fila mentindo. Fica marcado e espera decisão de quem pode tomá-la.
  causaRemovidaEm     DateTime?
  causaRemovidaMotivo String?   @db.VarChar(300)
  // E A DECISÃO, quando alguém a toma. Sem isto a marca "requer decisão" não
  // tem saída: manter o trabalho zeraria `causaRemovidaEm`, e o reconciliador
  // — que só olha o workflow encerrado — marcaria tudo de novo na passada
  // seguinte. A decisão precisa ficar registrada para ser respeitada.
  causaDecididaEm     DateTime?
  causaDecisao        String?   @db.VarChar(20) // MANTER | ENCERRAR
  causaDecisaoAutorId Int?
  causaDecisaoMotivo  String?   @db.VarChar(300)

  dependeDe TarefaDependencia[] @relation("TarefaDependente")
  bloqueia  TarefaDependencia[] @relation("TarefaPreRequisito")

  // TAREFA TRANSVERSAL (aditivo) â aÃ§Ã£o antecipada de OUTRA fase p/ resolver uma necessidade
  // da fase ATUAL, sem avanÃ§ar o Macro. Refs "soltas" (padrÃ£o executedById): sem relation
  // p/ nÃ£o tocar outros models; os serviÃ§os resolvem os vÃ­nculos. necessidadeId/documentoId/
  // responsavelId/statusTarefa/dataPrazo/dataConclusao/createdAt/updatedAt jÃ¡ existem acima.
  tipo                     TipoTarefa               @default(NORMAL)
  faseOrigemCode           String?                  @db.VarChar(60) // fase ATIVA onde foi criada
  faseReferenciaCode       String?                  @db.VarChar(60) // fase Ã  qual a AÃÃO pertence
  workflowInstanceOrigemId Int? // instÃ¢ncia da fase de ORIGEM (ativa) no momento da criaÃ§Ã£o
  pessoaId                 Int? // pessoa correspondente (solto â Pessoa)
  tipoDocumentoId          Int? // tipo documental correspondente (solto â TipoDocumentoCadastro)
  acaoStepKey              String?                  @db.VarChar(80) // aÃ§Ã£o de catÃ¡logo antecipada (stepKey da fase de referÃªncia)
  motivo                   String?                  @db.Text // motivo da antecipaÃ§Ã£o
  resultadoEsperado        String?                  @db.Text
  resultadoObtido          String?                  @db.Text
  createdBy                Int?
  notificacoes             NotificacaoOperacional[]

  @@index([tipo])
  @@index([pessoaId])
  @@index([processoId])
  @@index([responsavelId])
  @@index([concluida])
  @@index([statusTarefa])
  @@index([statusId])
  @@index([pais])
  @@index([dataPrazo])
  @@index([workflowStepInstanceId])
  @@index([workflowInstanceId])
  @@index([necessidadeId])
}

