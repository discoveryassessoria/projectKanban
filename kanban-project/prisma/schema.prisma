/// PROTOCOLIZAÇÃO — ocorrência operacional realizada DENTRO do processo.
/// NÃO é cadastro: cada registro é um ato concreto (entregar/enviar algo a um
/// órgão), que gera Evento na Timeline e entra no Histórico do Processo.
model Protocolo {
  publicCode           String?                @unique @db.VarChar(20)
  id                   Int                    @id @default(autoincrement())
  processoId           Int
  contratanteId        Int?
  /// Órgão que RECEBEU o protocolo (fonte única: Órgãos e Organizações).
  orgaoId              Int?
  /// TIPO DO ATO, pelo cadastro (Gerenciamento → Documentos e Protocolos).
  /// Substitui o enum `tipoProtocolo`, que sai na migration de remoção.
  tipoProtocoloId      Int?
  /// Setor/guichê dentro do órgão (opcional).
  setor                String?                @db.VarChar(120)
  /// Data e hora da protocolização.
  dataProtocolo        DateTime?
  /// NÚMERO DO COMPROVANTE DA ENTREGA — o que o guichê devolve na hora.
  numeroProtocolo      String?                @db.VarChar(100)
  /// NÚMERO DO PROCESSO NO ÓRGÃO — o *ruolo generale* do tribunal italiano, o
  /// número de expediente do consulado espanhol. É OUTRO fato: o protocolo prova
  /// a entrega, este identifica o dossiê dentro do órgão pelo resto da vida dele.
  /// Vivia em `InformacaoItalia.numeroRuoloGenerale`, tabela que só a Itália
  /// tinha; aqui serve aos dois países e entra nos relatórios por órgão.
  numeroProcesso       String?                @db.VarChar(100)
  /// PARA QUE serve este ato. `tipoProtocolo` diz ONDE (consular, judicial,
  /// comune); `origem` diz QUEM o criou (tela, solicitação, etapa). Faltava o
  /// para quê — sem ele não dá para separar, num relatório, O requerimento de
  /// cidadania de um protocolo de retificação no mesmo tribunal.
  /// Catálogo fechado em `FINALIDADES_DE_PROTOCOLO` (protocolo-canonico.ts).
  finalidade           String                 @default("REQUERIMENTO") @db.VarChar(30)
  /// SITUAÇÃO DADA PELO ÓRGÃO — não é fase do nosso workflow. O motor sabe em que
  /// etapa nós estamos; só o órgão sabe se deferiu, exigiu ou arquivou.
  /// Catálogo fechado em `SITUACOES_DE_PROTOCOLO`.
  situacao             String                 @default("PROTOCOLADO") @db.VarChar(30)
  /// Quando a situação acima passou a valer (data do ato do órgão).
  situacaoEm           DateTime?
  formaEnvio           FormaEnvioProtocolo?
  /// Quem da equipe protocolou.
  responsavelId        Int?
  observacoes          String?
  /// ORIGEM do ato. "PROCESSO" = protocolizacao do dossie no orgao (telas do processo).
  /// "SOLICITACAO_DOCUMENTO" = numero devolvido ao solicitar uma certidao. E o MESMO
  /// cadastro de protocolo (nao existe um segundo); a origem so diz de onde ele nasceu.
  origem               String                 @default("PROCESSO") @db.VarChar(30)
  /// Solicitacao de certidao que originou este protocolo (null = protocolo do processo).
  solicitacaoId        Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  anexos               AnexoProtocolo[]
  documentos           ProtocoloDocumento[]
  /// QUEM este protocolo cobre. FONTE ÚNICA do escopo.
  ///
  /// A cardinalidade NÃO está aqui: está na Modalidade Legal do processo.
  /// Espanha/LMD é consular e INDIVIDUAL — um requerimento por requerente, um
  /// número por pessoa. Itália é judicial e COLETIVA — um ricorso cobre a
  /// família inteira sob um único R.G. A mesma tabela serve aos dois; o que
  /// muda é um dado de cadastro, nunca um `if (pais)`.
  requerentesCobertos  ProtocoloRequerente[]
  /// Exigências que o órgão levantou sobre ESTE protocolo.
  exigencias           ProtocoloExigencia[]
  /// Arquivos da operacao documental ligados a ESTE protocolo (o requerimento
  /// enviado, os comprovantes). E REFERENCIA ao mesmo DocumentoArquivo que a etapa
  /// e o documento leem - nao existe copia do binario nem segunda linha.
  arquivos             DocumentoArquivo[]     @relation("ArquivoProtocolo")
  tentativas           StepExecution[]        @relation("ProtocoloDaTentativa")
  retificacoes         RetificacaoPacote[]    @relation("ProtocoloDaRetificacao")
  execucoesDeSubtarefa SubtaskExecution[]     @relation("ProtocoloDaSubtarefa")
  contratante          Contratante?           @relation(fields: [contratanteId], references: [id], onDelete: Cascade)
  processo             Processo               @relation(fields: [processoId], references: [id], onDelete: Cascade)
  orgao                OrgaoProtocolo?        @relation(fields: [orgaoId], references: [id], onDelete: SetNull)
  responsavel          Usuario?               @relation("ProtocoloResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  solicitacao          SolicitacaoDocumento?  @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  /// TIPO DO ATO, pelo cadastro. Ver `tipoProtocoloId`.
  tipo                 TipoProtocoloCadastro? @relation(fields: [tipoProtocoloId], references: [id], onDelete: SetNull)

  @@index([processoId])
  @@index([contratanteId])
  @@index([orgaoId])
  @@index([responsavelId])
  @@index([solicitacaoId])
  /// RELATÓRIO POR CONSULADO/TRIBUNAL E POR DATA — o filtro que a operação pede
  /// ("tudo que foi protocolado no Consulado de São Paulo em agosto") varre estas
  /// duas colunas juntas, para os dois países, numa consulta só.
  @@index([tipoProtocoloId])
  @@index([orgaoId, dataProtocolo])
  @@index([finalidade, situacao])
}

/// REQUISITO CADASTRAL — "para esta rota, este DADO é exigido".
///
/// ─── A LACUNA QUE ISTO FECHA ────────────────────────────────────────────────
/// O Discovery já sabia dizer que um DOCUMENTO era obrigatório: MatrizDocumental
/// é a regra, NecessidadeDocumental é a obrigação materializada, e o Documento é
/// a evidência. Não havia nada equivalente para DADO: "e-mail é obrigatório para
/// a rota espanhola" não existia em lugar nenhum — o mais próximo era um
/// `camposObrigatorios: string[]` dentro de um JSON de configuração de passo,
/// sem cadastro, sem aplicabilidade e sem versão.
///
/// Documento e dado são naturezas diferentes e o produto precisa distinguir:
/// "comprovante de endereço" é documento; "endereço" é dado. "RG" pode ser as
/// duas coisas — o documento anexado e o número no cadastro — e são requisitos
/// separados.
///
/// ─── O QUE ESTA TABELA NÃO GUARDA ──────────────────────────────────────────
/// O VALOR. O e-mail continua em `Requerente.email`. Aqui mora só a REGRA de
/// obrigatoriedade; `campoKey` aponta para o catálogo de campos canônicos
/// (src/lib/requisitos/campos-canonicos.ts), que é o espelho do schema. Sem isso
/// seria possível cadastrar requisito para um campo que não existe — obrigação
/// impossível de satisfazer.
///
/// ─── APLICABILIDADE ────────────────────────────────────────────────────────
/// Campos de escopo NULOS significam "vale para qualquer": um requisito sem país
/// vale para todas as nacionalidades. Isso evita a explosão de duplicar o mesmo
/// requisito por combinação — a regra é uma, o escopo é que a estreita.
model RequisitoCadastral {
  id        Int     @id @default(autoincrement())
  /// Identidade IMUTÁVEL, gerada do nome na criação.
  code      String  @unique @db.VarChar(60)
  nome      String  @db.VarChar(160)
  descricao String? @db.Text

  /// Campo canônico exigido (`requerente.email`, `requerente.endereco`…).
  /// Aponta para o catálogo em código, que espelha as colunas reais.
  campoKey String @db.VarChar(80)

  /// Mesma escala da regra documental — uma semântica só para obrigatoriedade.
  obrigatoriedade ObrigatoriedadeRegra @default(OBRIGATORIA)
  /// Impede o processo de avançar enquanto não satisfeito? Nem toda pendência
  /// bloqueia, e tratar todas como bloqueio faria a operação parar por nada.
  bloqueante      Boolean              @default(false)
  /// A quem o requisito se dirige. Mesma escala da regra documental.
  publicoAlvo     PublicoAlvoRegra     @default(REQUERENTE)

  // ── ESCOPO (null = qualquer) ─────────────────────────────────────────────
  paisId            Int?
  pais              CatalogoPais?    @relation(fields: [paisId], references: [id], onDelete: Restrict)
  modalidadeLegalId Int?
  modalidadeLegal   ModalidadeLegal? @relation(fields: [modalidadeLegalId], references: [id], onDelete: Restrict)
  itemCatalogoId    Int?
  itemCatalogo      ItemCatalogo?    @relation("RequisitoCadastralItem", fields: [itemCatalogoId], references: [id], onDelete: Restrict)
  /// Faixa etária em anos completos, calculada na LEITURA a partir da data de
  /// nascimento. Idade não é persistida: ela muda sozinha todo ano.
  idadeMinima       Int?
  idadeMaxima       Int?

  // ── SEM VIGÊNCIA, DE PROPÓSITO ───────────────────────────────────────────
  /// Cadastro vale até ser INATIVADO; data é para FATO — é a regra do produto, e
  /// há guard que a protege. A pergunta "esta pendência existia em março?" não se
  /// responde datando o cadastro: responde-se pela obrigação materializada, que
  /// guarda o snapshot da regra que a gerou (ver NecessidadeDocumental).
  versao Int @default(1)

  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@index([campoKey])
  @@index([paisId])
  @@index([modalidadeLegalId])
}

/// TIPO DE PROTOCOLO — cadastro, no Gerenciamento.
///
/// O enum `TipoProtocolo` (7 valores fixos no schema) obrigava um deploy para a
/// operação classificar um ato novo, e não tinha descrição, ordem nem inativação.
/// A regra "protocolo NÃO é cadastro" continua de pé — o ATO segue sendo uma
/// ocorrência dentro do processo. O que virou cadastro é a CLASSIFICAÇÃO dele,
/// que é outra coisa: uma lista que a operação mantém.
model TipoProtocoloCadastro {
  id           Int      @id @default(autoincrement())
  /// Identidade IMUTÁVEL, gerada do nome na criação.
  code         String   @unique @db.VarChar(60)
  nome         String   @db.VarChar(120)
  descricao    String?  @db.Text
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  protocolos Protocolo[]

  @@index([ativo])
}

/// ESCOPO DO PROTOCOLO — quais requerentes aquele ato cobre.
///
/// Existe porque `Protocolo.requerenteId` cabia UM só: o caso italiano (um
/// ricorso para a família inteira) era irrepresentável, e o espanhol só
/// funcionava por acidente. Com a tabela, os dois casos são o MESMO modelo com
/// contagem diferente — e o relatório por família não precisa saber de país.
model ProtocoloRequerente {
  protocoloId  Int
  requerenteId Int
  criadoEm     DateTime   @default(now())
  protocolo    Protocolo  @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  requerente   Requerente @relation(fields: [requerenteId], references: [id], onDelete: Cascade)

  @@id([protocoloId, requerenteId])
  @@index([requerenteId])
}

/// EXIGÊNCIA DO ÓRGÃO — o que ele pediu, e até quando.
///
/// É entidade própria, e não dois campos no protocolo, porque o órgão exige mais
/// de uma vez ao longo do mesmo expediente e cada exigência tem prazo, resposta e
/// data de cumprimento próprios. Dois campos guardariam só a última e apagariam o
/// histórico — que é exatamente o que a operação precisa provar depois.
model ProtocoloExigencia {
  id           Int       @id @default(autoincrement())
  protocoloId  Int
  /// O que o órgão pediu, no texto dele.
  descricao    String    @db.Text
  /// Data-limite dada pelo órgão. É ela que alimenta o relatório do que vence.
  prazo        DateTime?
  /// Quando NÓS cumprimos. Nulo = em aberto.
  cumpridaEm   DateTime?
  observacoes  String?   @db.Text
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  protocolo    Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([protocoloId])
  @@index([prazo])
  @@index([cumpridaEm])
}

/// Documentos ENVIADOS numa protocolização (o que foi entregue ao órgão).
model ProtocoloDocumento {
  id          Int       @id @default(autoincrement())
  protocoloId Int
  documentoId Int
  criadoEm    DateTime  @default(now())
  protocolo   Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([protocoloId, documentoId])
  @@index([documentoId])
}

/// Como o protocolo chegou ao órgão.
enum FormaEnvioProtocolo {
  PRESENCIAL
  CORREIO
  EMAIL
  PORTAL_ONLINE
  TERCEIRO
}

