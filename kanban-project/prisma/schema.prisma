/// OS CANAIS QUE UMA ORGANIZAÇÃO ATENDE.
///
/// ─── O ERRO QUE ISTO DESFAZ ────────────────────────────────────────────────
/// O workflow tinha um cadastro próprio de canais e o passo declarava quais oferecia.
/// Só que "por onde dá para pedir" não é decisão do workflow: é fato do CARTÓRIO. Um
/// cartório que só atende no balcão continuava aparecendo com CRC e e-mail porque o
/// passo dizia que sim — e o operador descobria tentando.
///
/// Agora o vocabulário de tipos (`CanalOperacional`) continua sendo domínio fechado, e
/// a DISPONIBILIDADE é da organização. O passo apenas declara "use os canais do
/// fornecedor relacionado", e o runtime resolve pelo fornecedor concreto daquele
/// documento. Nenhum cadastro é duplicado.
model OrganizacaoCanal {
  id            Int              @id @default(autoincrement())
  organizacaoId Int
  organizacao   OrgaoProtocolo   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  canalId       Int
  canal         CanalOperacional @relation(fields: [canalId], references: [id], onDelete: Cascade)

  ativo Boolean @default(true)
  ordem Int     @default(0)

  /// EXIGÊNCIA PRÓPRIA DESTA ORGANIZAÇÃO neste canal. `null` = vale a do tipo de
  /// canal. Só ACRESCENTA: uma organização não dispensa o que o canal exige de origem.
  exigeProtocolo  Boolean?
  exigeAnexo      Boolean?
  exigeRastreio   Boolean?
  exigeObservacao Boolean?

  /// Endereço/identificador da organização NESTE canal (e-mail, URL do portal,
  /// telefone do WhatsApp, guichê). É dado de contato, não de workflow.
  endereco   String? @db.VarChar(300)
  /// Prazo típico de retorno por este canal, em dias.
  prazoDias  Int?
  observacao String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([organizacaoId, canalId])
  @@index([organizacaoId])
  @@index([canalId])
}

/// CANAL OPERACIONAL — por onde um pedido sai da casa.
///
/// CRC, e-cartório, e-mail, WhatsApp, balcão, comune, correios, consulado eram um
/// array em `src/lib/process-stage/canais-solicitacao.ts`: acrescentar um canal
/// exigia deploy. O enum `CanalSolicitacaoDocumento` continua existindo — ele é a
/// coluna que as solicitações já gravadas usam —, mas quem responde "quais canais
/// existem e o que cada um exige" passa a ser esta tabela.
model CanalOperacional {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique @db.VarChar(40)
  label                 String   @db.VarChar(120)
  descricao             String?  @db.Text
  ordem                 Int      @default(0)
  ativo                 Boolean  @default(true)
  /// O canal devolve número de protocolo no ato do envio?
  protocoloObrigatorio  Boolean  @default(false)
  /// Rótulo do comprovante exigido. null = anexo opcional.
  anexoObrigatorioLabel String?  @db.VarChar(160)
  rastreioObrigatorio   Boolean  @default(false)
  observacaoObrigatoria Boolean  @default(false)
  /// Restrição de aplicação: { paises: [], tiposDocumento: [] }. null = qualquer.
  aplicacao             Json?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  passos       StepChannel[]
  organizacoes OrganizacaoCanal[]

  solicitacoesCanonicas SolicitacaoDocumento[] @relation("SolicitacaoCanalCanonico")
}

