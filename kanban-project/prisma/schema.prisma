  cobrancaId      Int? // â Cobranca (parcela pertence Ã  CobranÃ§a no modelo novo). Legado: null.
  cobranca        Cobranca?       @relation("CobrancaParcelas", fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@unique([receitaId, numero])
  @@unique([custoId, numero])
  @@index([receitaId])
  @@index([cobrancaId])
  @@index([custoId])
  @@index([status])
  @@index([vencimento])
