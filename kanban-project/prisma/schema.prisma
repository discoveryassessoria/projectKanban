/// Fato financeiro registrado (gatilho dos lanÃ§amentos). Append-only.
// Motor Financeiro V3 · Fase 3 — CONCILIAÇÃO BANCÁRIA. Linha de extrato bancário
// (informada/importada), conciliada contra uma OcorrenciaFinanceira de pagamento.
// Aditiva, "ref solta". Estados: INFORMADO|CONCILIADO|DIVERGENTE|IGNORADO|ESTORNADO.
model LancamentoBancario {
  id                     Int      @id @default(autoincrement())
  data                   DateTime
  moeda                  Moeda    @default(BRL)
  valorBruto             Decimal  @db.Decimal(14, 2)
  valorTarifa            Decimal? @db.Decimal(14, 2)
  valorLiquido           Decimal  @db.Decimal(14, 2)
  identificadorTransacao String?  @db.VarChar(120) // id do banco/gateway (dedup)
  contaRecebimentoId     Int? // → ContaBancaria/CarteiraRecebimento (solto)
  descricao              String?  @db.VarChar(300)
  status                 String   @default("INFORMADO") @db.VarChar(16)
  ocorrenciaId           Int? // OcorrenciaFinanceira conciliada
  obrigacaoId            Int?
  divergencia            String?  @db.VarChar(200)
  origem                 String   @default("manual") @db.VarChar(20) // manual|import|api
  criadoPorId            Int?
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  @@unique([identificadorTransacao]) // dedup de importação (quando presente)
  @@index([status])
  @@index([ocorrenciaId])
  @@index([obrigacaoId])
  @@index([data])
}

model OcorrenciaFinanceira {
  id                Int                @id @default(autoincrement())
  obrigacaoId       Int
  obrigacao         ObrigacaoEconomica @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  cobrancaId        Int?
  tipo              String             @db.VarChar(30) // PAGAMENTO|PAGAMENTO_PARCIAL|DESCONTO|JUROS|MULTA|ESTORNO|REEMBOLSO|CREDITO|RENEGOCIACAO|CANCELAMENTO|BAIXA|AJUSTE|DIFERENCA_CAMBIAL|OBRIGACAO_CRIADA
  valor             Decimal            @db.Decimal(14, 2)
  moeda             Moeda              @default(BRL)
  data              DateTime
  formaPagamentoId  Int?
  origemRecurso     String?            @db.VarChar(20) // CONTA|PIX|CARTAO|TERCEIRO|EMPRESA|OUTRO
  pagadorId         Int?
  snapshotCambialId Int?
  comprovanteUrl    String?            @db.VarChar(400)
  observacao        String?            @db.Text
  // Fase 3 — detalhe de exibição do pagamento (tela Receita V3): forma, conta e referência.
  formaLabel        String?            @db.VarChar(40) // ex.: PIX, TED, Cartão
  contaBanco        String?            @db.VarChar(80) // ex.: Banco Inter
  contaAgencia      String?            @db.VarChar(20)
  contaNumero       String?            @db.VarChar(30)
  referencia        String?            @db.VarChar(120) // ex.: "PIX 15/07 - Joao Silva"
  politicaAplicacao String?            @db.VarChar(24) // FIFO|PARCELA_ESPECIFICA|MANUAL|PROPORCIONAL
  status            String             @default("PENDENTE") @db.VarChar(20) // PENDENTE|PROCESSANDO|PROCESSADA|REJEITADA|REVERTIDA
  estornaId         Int?
  correlacaoId      String?            @db.VarChar(60)
  idempotencyKey    String?            @unique @db.VarChar(120)
  criadoPorId       Int?
  criadoEm          DateTime           @default(now())

  aplicacoes AplicacaoFinanceira[]

  @@index([obrigacaoId, data])
  @@index([tipo, status])
}

/// ImputaÃ§Ã£o explÃ­cita de uma ocorrÃªncia a parcelas/obrigaÃ§Ãµes.
model AplicacaoFinanceira {
  id            Int                  @id @default(autoincrement())
  ocorrenciaId  Int
  ocorrencia    OcorrenciaFinanceira @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  parcelaId     Int?
  cobrancaId    Int?
  valorAplicado Decimal              @db.Decimal(14, 2)
  moeda         Moeda                @default(BRL)
  ordem         Int                  @default(0)
  criadoEm      DateTime             @default(now())

  @@index([ocorrenciaId])
  @@index([parcelaId])
